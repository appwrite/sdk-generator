{% macro map_parameter(parameters) %}
{% for parameter in parameters %}
{% if not parameter.required %}
if ({{ parameter.name | caseCamel | overrideIdentifier }} != null) '{{ parameter.name }}': {{ parameter.name | caseCamel | overrideIdentifier }}{% if (parameter | enumValues) | length > 0 and (parameter | schemaType) == 'array' %}.map((e) => e.value).toList(){% elseif (parameter | enumValues) | length > 0 %}.value{% elseif (parameter | schemaModel) is not empty and (parameter | schemaType) == 'array' %}.map((p) => p.toMap()).toList(){% elseif (parameter | schemaModel) is not empty %}.toMap(){% endif %},
{% else %}
'{{ parameter.name }}': {{ parameter.name | caseCamel | overrideIdentifier }}{% if (parameter | enumValues) | length > 0 and (parameter | schemaType) == 'array' %}{% if not parameter.required or (parameter | schemaNullable) %}?{% endif %}.map((e) => e.value).toList(){% elseif (parameter | enumValues) | length > 0  %}{% if not parameter.required or (parameter | schemaNullable) %}?{% endif %}.value{% elseif (parameter | schemaModel) is not empty and (parameter | schemaType) == 'array' %}{% if not parameter.required or (parameter | schemaNullable) %}?{% endif %}.map((p) => p.toMap()).toList(){% elseif (parameter | schemaModel) is not empty %}{% if not parameter.required or (parameter | schemaNullable) %}?{% endif %}.toMap(){% endif %},
{% endif %}
{% endfor %}
{% endmacro %}

{% macro map_headers(headers) %}
{% for key, header in headers %}
'{{ key }}': '{{ header }}',
{% endfor %}
{% endmacro %}
