# Creates a team-scoped APNs key, or prepares the app's App ID, for
# `appwrite init apns --provider fastlane` with spaceship, fastlane's Apple
# Developer portal client, so any fastlane installation (gem, Homebrew or
# bundler) can run it.
#
# spaceship asks for the two-factor code, and for a team when the account has
# several, on the terminal. The Apple ID and password come from FASTLANE_USER
# and FASTLANE_PASSWORD. fastlane logs to stdout, so the result is written as
# JSON to the file named by out: instead.
require 'json'

lane :create_apns_key do |options|
  write_result(options) { create_apns_key_with_spaceship(options) }
end

lane :prepare_app_id do |options|
  write_result(options) { prepare_app_id_with_spaceship(options) }
end

def write_result(options)
  result = begin
    yield
  rescue StandardError => error
    kind = error.kind_of?(Spaceship::InvalidUserCredentialsError) ? 'invalid-credentials' : 'failed'
    { error: kind, message: error.message }
  end
  File.open(options[:out], 'w', 0o600) { |file| file.write(JSON.generate(result)) }
end

# sign_in returns the portal client for the team, or nil when saved_only:true
# finds no saved sign-in for FASTLANE_USER.
def sign_in(options)
  require 'spaceship'

  user = ENV.fetch('FASTLANE_USER', nil)
  # reset:true deletes spaceship's saved session for this Apple ID first, so
  # the sign-in starts over, two-factor included.
  if options[:reset].to_s == 'true'
    cookie = Spaceship::PortalClient.new.tap { |client| client.user = user }.persistent_cookie_path
    File.delete(cookie) if cookie && File.exist?(cookie)
  end
  if options[:saved_only].to_s == 'true'
    client = Spaceship::PortalClient.new
    client.user = user
    return nil unless client.has_valid_session

    Spaceship::Portal.client = client
  else
    Spaceship::Portal.login(user, ENV.fetch('FASTLANE_PASSWORD', nil))
  end
  team_id = options[:team_id].to_s
  if team_id.empty?
    Spaceship::Portal.select_team
  else
    Spaceship::Portal.select_team(team_id: team_id)
  end
  Spaceship::Portal.client
end

def create_apns_key_with_spaceship(options)
  client = sign_in(options)

  # Key.create always asks for every environment, so the client is called
  # directly with the one requested.
  environment = options[:environment].to_s.empty? ? 'all' : options[:environment].to_s
  begin
    created = client.create_key!(
      name: options[:name],
      service_configs: {
        Spaceship::Portal::Key::APNS_ID => { scope: 'team', environment: environment, identifiers: {} }
      }
    )
  rescue StandardError => error
    # Worded with or without "team scoped" before "Keys".
    raise unless error.message =~ /maximum allowed number of (?:[a-z ]+ )?keys/i

    keys = client.list_keys.map do |key|
      { id: key['keyId'], name: key['keyName'], canRevoke: key['canRevoke'] == true }
    end
    return { error: 'max-keys', keys: keys }
  end

  key_id = created['keyId']
  { keyId: key_id, teamId: client.team_id, p8: client.download_key(id: key_id) }
end

# Reports whether bundle_id: is an App ID with Push Notifications, and with
# mode:apply registers it and turns push on.
def prepare_app_id_with_spaceship(options)
  client = sign_in(options)
  return { error: 'sign-in-needed' } unless client

  push_type = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
  Spaceship::ConnectAPI.client = Spaceship::ConnectAPI::Client.new(portal_client: client)
  identifier = options[:bundle_id].to_s
  bundle = Spaceship::ConnectAPI::BundleId.find(identifier, includes: 'bundleIdCapabilities')
  push = !bundle.nil? && (bundle.bundle_id_capabilities || []).any? { |capability| capability.is_type?(push_type) }
  result = { teamId: client.team_id, registered: !bundle.nil?, push: push, created: false, pushTurnedOn: false }
  return result unless options[:mode].to_s == 'apply'

  if bundle.nil?
    bundle = Spaceship::ConnectAPI::BundleId.create(
      name: options[:name].to_s, platform: 'IOS', identifier: identifier, seed_id: client.team_id
    )
    result[:registered] = true
    result[:created] = true
  end
  unless result[:push]
    bundle.update_capability(push_type, enabled: true)
    result[:push] = true
    result[:pushTurnedOn] = true
  end
  result
end
