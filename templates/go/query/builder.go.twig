package query

type Builder struct {
	queries []string
}

func NewBuilder() *Builder {
	return &Builder{}
}

func (b *Builder) Build() []string {
	result := make([]string, len(b.queries))
	copy(result, b.queries)
	return result
}

func (b *Builder) push(queries ...string) *Builder {
	b.queries = append(b.queries, queries...)
	return b
}

func (b *Builder) Equal(attribute string, value interface{}) *Builder {
	return b.push(Equal(attribute, value))
}

