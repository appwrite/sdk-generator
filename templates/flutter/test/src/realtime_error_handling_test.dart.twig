import 'dart:async';
import 'package:flutter_test/flutter_test.dart';
import 'package:web_socket_channel/status.dart' as status;
import 'package:web_socket_channel/web_socket_channel.dart';
import 'package:{{ language.params.packageName }}/src/client.dart';
import 'package:{{ language.params.packageName }}/src/exception.dart';
import 'package:{{ language.params.packageName }}/src/realtime_mixin.dart';
import 'package:{{ language.params.packageName }}/src/realtime_response.dart';

class _FakeClient implements Client {
  @override
  Map<String, String> config = {'project': 'test'};

  @override
  String? get endPointRealtime => 'wss://localhost/v1';

  @override
  dynamic noSuchMethod(Invocation invocation) => null;
}

class _TestRealtime with RealtimeMixin {}

void main() {
  group('RealtimeMixin error handling', () {
    late _TestRealtime realtime;

    setUp(() {
      realtime = _TestRealtime()
        ..client = _FakeClient()
        ..getWebSocket = (uri) => Completer<WebSocketChannel>().future;
    });

    test(
        'a policy-violation error frame is delivered to the subscription stream, not thrown',
        () async {
      final subscription = realtime.subscribeTo(['account']);

      final response = RealtimeResponse(
        type: 'error',
        data: {
          'code': status.policyViolation,
          'message':
              'Team is marked as read-only, so you cannot invite new members.',
        },
      );

      final expectation = expectLater(
        subscription.stream,
        emitsError(
          isA<{{ spec.info.title | caseUcfirst }}Exception>()
              .having((e) => e.code, 'code', status.policyViolation)
              .having((e) => e.message, 'message', contains('read-only')),
        ),
      );

      expect(() => realtime.handleError(response), returnsNormally);

      await expectation;
    });

    test('the same error reaches every active subscription', () async {
      final accountSub = realtime.subscribeTo(['account']);
      final teamsSub = realtime.subscribeTo(['teams']);

      final matcher = emitsError(isA<{{ spec.info.title | caseUcfirst }}Exception>());
      final accountExpectation = expectLater(accountSub.stream, matcher);
      final teamsExpectation = expectLater(teamsSub.stream, matcher);

      realtime.handleError(RealtimeResponse(
        type: 'error',
        data: {
          'code': status.policyViolation,
          'message': 'read-only',
        },
      ));

      await accountExpectation;
      await teamsExpectation;
    });
  });
}
