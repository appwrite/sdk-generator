#!/usr/bin/env node
// Build the six per-platform npm packages from the goreleaser output.
//
// Run after `goreleaser release` and before publishing. Each package holds one
// binary plus a package.json whose `os`/`cpu` fields let npm pick exactly one
// of them at install time; npm/run.js explains why the distribution is shaped
// this way rather than downloading in a postinstall.
//
// THE RELEASE ASSET NAMES ARE NOT FILENAMES ON DISK. With `formats: [binary]`
// goreleaser leaves each build where it built it -- dist/appwrite_darwin_amd64_v1/appwrite --
// and carries the asset name (appwrite-cli-darwin-x64) only as metadata,
// applying it when it uploads. So this reads dist/artifacts.json and maps name
// to path. Globbing dist/ for the asset names finds nothing.
//
// Usage: node scripts/build-npm-packages.mjs <distDir> <outDir> <version>

import fs from "node:fs";
import path from "node:path";

const [distDir = "dist", outDir = "npm-packages", version] = process.argv.slice(2);

if (!version) {
  console.error("usage: build-npm-packages.mjs <distDir> <outDir> <version>");
  process.exit(1);
}

// `os` and `cpu` are node's spellings and are what npm matches on; the asset
// suffix is the release naming. They differ for windows, so both are listed
// rather than derived from each other.
const TARGETS = [
  { suffix: "darwin-arm64", os: "darwin", cpu: "arm64" },
  { suffix: "darwin-x64", os: "darwin", cpu: "x64" },
  { suffix: "linux-arm64", os: "linux", cpu: "arm64" },
  { suffix: "linux-x64", os: "linux", cpu: "x64" },
  { suffix: "win-arm64", os: "win32", cpu: "arm64" },
  { suffix: "win-x64", os: "win32", cpu: "x64" },
];

const packageName = "{{ language.params.npmPackage }}";
const executable = "{{ language.params.executableName }}";

const artifacts = JSON.parse(fs.readFileSync(path.join(distDir, "artifacts.json"), "utf8"));
const paths = new Map(artifacts.map((artifact) => [artifact.name, artifact.path]));

fs.mkdirSync(outDir, { recursive: true });

for (const target of TARGETS) {
  const windows = target.os === "win32";
  const asset = `${packageName}-${target.suffix}${windows ? ".exe" : ""}`;
  const source = paths.get(asset);

  // Fail rather than skip. A missing artifact means goreleaser did not build
  // that target, and publishing the remaining five would leave the parent
  // package resolving an optional dependency that does not exist.
  if (!source || !fs.existsSync(source)) {
    console.error(`no release artifact named ${asset} in ${distDir}/artifacts.json`);
    process.exit(1);
  }

  const directory = path.join(outDir, `${packageName}-${target.suffix}`);
  fs.mkdirSync(path.join(directory, "bin"), { recursive: true });

  const destination = path.join(directory, "bin", windows ? `${executable}.exe` : executable);
  fs.copyFileSync(source, destination);
  // npm preserves the executable bit from the tarball, and losing it here
  // produces an EACCES the shim cannot explain.
  fs.chmodSync(destination, 0o755);

  fs.writeFileSync(
    path.join(directory, "package.json"),
    JSON.stringify(
      {
        name: `${packageName}-${target.suffix}`,
        version,
        description: `${executable} binary for ${target.os} ${target.cpu}`,
        license: "{{ sdk.license }}",
        repository: { type: "git", url: "{{ sdk.gitURL }}" },
        os: [target.os],
        cpu: [target.cpu],
        files: ["bin"],
      },
      null,
      2,
    ) + "\n",
  );

  console.log(`built ${directory}`);
}
