const { Query, normalizeQueries } = require("../dist/query");

const tests = [
    {
        description: 'with a string',
        value: 's',
        expectedValues: '["s"]'
    },
    {
        description: 'with a integer',
        value: 1,
        expectedValues: '[1]'
    },
    {
        description: 'with a double',
        value: 1.2,
        expectedValues: '[1.2]'
    },
    {
        description: 'with a whole number double',
        value: 1.0,
        expectedValues: '[1]'
    },
    {
        description: 'with a bool',
        value: false,
        expectedValues: '[false]'
    },
    {
        description: 'with a list',
        value: ['a', 'b', 'c'],
        expectedValues: '["a","b","c"]'
    }
];

describe('Query', () => {
    describe('basic filter equal', () => {
        for (const t of tests) {
            test(t.description, () =>
                expect(Query.equal("attr", t.value))
                    .toEqual(`{"method":"equal","attribute":"attr","values":${t.expectedValues}}`)
            )
        }
    })

    describe('basic filter notEqual', () => {
        for (const t of tests) {
            test(t.description, () =>
                expect(Query.notEqual("attr", t.value))
                    .toEqual(`{"method":"notEqual","attribute":"attr","values":${t.expectedValues}}`)
            )
        }
    });

    describe('basic filter lessThan', () => {
        for (const t of tests) {
            test(t.description, () =>
                expect(Query.lessThan("attr", t.value))
                    .toEqual(`{"method":"lessThan","attribute":"attr","values":${t.expectedValues}}`)
            )
        }
    });

    describe('basic filter lessThanEqual', () => {
        for (const t of tests) {
            test(t.description, () =>
                expect(Query.lessThanEqual("attr", t.value))
                    .toEqual(`{"method":"lessThanEqual","attribute":"attr","values":${t.expectedValues}}`)
            )
        }
    });

    describe('basic filter greaterThan', () => {
        for (const t of tests) {
            test(t.description, () =>
                expect(Query.greaterThan("attr", t.value))
                    .toEqual(`{"method":"greaterThan","attribute":"attr","values":${t.expectedValues}}`)
            )
        }
    });

    describe('basic filter greaterThanEqual', () => {
        for (const t of tests) {
            test(t.description, () =>
                expect(Query.greaterThanEqual("attr", t.value))
                    .toEqual(`{"method":"greaterThanEqual","attribute":"attr","values":${t.expectedValues}}`)
            )
        }
    });

    test('search', () =>
        expect(Query.search('attr', 'keyword1 keyword2'))
            .toEqual(`{"method":"search","attribute":"attr","values":["keyword1 keyword2"]}`)
    );

    test('isNull', () =>
        expect(Query.isNull('attr'))
            .toEqual(`{"method":"isNull","attribute":"attr"}`)
    );

    test('isNotNull', () =>
        expect(Query.isNotNull('attr'))
            .toEqual(`{"method":"isNotNull","attribute":"attr"}`)
    );

    describe('between', () => {
        test('with integers', () =>
            expect(Query.between('attr', 1, 2))
                .toEqual(`{"method":"between","attribute":"attr","values":[1,2]}`)
        );
        test('with doubles', () =>
            expect(Query.between('attr', 1.2, 2.2))
                .toEqual(`{"method":"between","attribute":"attr","values":[1.2,2.2]}`)
        );
        test('with strings', () =>
            expect(Query.between('attr',"a","z"))
                .toEqual(`{"method":"between","attribute":"attr","values":["a","z"]}`)
        );
    });

    test('select', () =>
        expect(Query.select(['attr1', 'attr2']))
            .toEqual(`{"method":"select","values":["attr1","attr2"]}`)
    );

    test('orderAsc', () =>
        expect(Query.orderAsc('attr'))
            .toEqual(`{"method":"orderAsc","attribute":"attr"}`)
    );

    test('orderDesc', () =>
        expect(Query.orderDesc('attr'))
            .toEqual(`{"method":"orderDesc","attribute":"attr"}`)
    );

    test('cursorBefore', () =>
        expect(Query.cursorBefore('attr'))
            .toEqual('{"method":"cursorBefore","values":["attr"]}')
    );

    test('cursorAfter', () =>
        expect(Query.cursorAfter('attr'))
            .toEqual('{"method":"cursorAfter","values":["attr"]}')
    );

    test('limit', () =>
        expect(Query.limit(1))
            .toEqual('{"method":"limit","values":[1]}')
    );

    test('offset', () =>
        expect(Query.offset(1))
            .toEqual('{"method":"offset","values":[1]}')
    );

    test('count with alias', () =>
        expect(Query.count('*', 'total'))
            .toEqual('{"method":"count","attribute":"*","values":["total"]}')
    );

    test('count without alias', () =>
        expect(Query.count())
            .toEqual('{"method":"count","attribute":"*"}')
    );

    test('countDistinct', () =>
        expect(Query.countDistinct('year', 'uniqueYears'))
            .toEqual('{"method":"countDistinct","attribute":"year","values":["uniqueYears"]}')
    );

    test('sum', () =>
        expect(Query.sum('price', 'total'))
            .toEqual('{"method":"sum","attribute":"price","values":["total"]}')
    );

    test('avg', () =>
        expect(Query.avg('price', 'avgPrice'))
            .toEqual('{"method":"avg","attribute":"price","values":["avgPrice"]}')
    );

    test('min', () =>
        expect(Query.min('price', 'lowest'))
            .toEqual('{"method":"min","attribute":"price","values":["lowest"]}')
    );

    test('max', () =>
        expect(Query.max('price', 'highest'))
            .toEqual('{"method":"max","attribute":"price","values":["highest"]}')
    );

    test('stddev', () =>
        expect(Query.stddev('price', 'sd'))
            .toEqual('{"method":"stddev","attribute":"price","values":["sd"]}')
    );

    test('stddevPop', () =>
        expect(Query.stddevPop('price', 'sdp'))
            .toEqual('{"method":"stddevPop","attribute":"price","values":["sdp"]}')
    );

    test('stddevSamp', () =>
        expect(Query.stddevSamp('price', 'sds'))
            .toEqual('{"method":"stddevSamp","attribute":"price","values":["sds"]}')
    );

    test('variance', () =>
        expect(Query.variance('price', 'var'))
            .toEqual('{"method":"variance","attribute":"price","values":["var"]}')
    );

    test('varPop', () =>
        expect(Query.varPop('price', 'vp'))
            .toEqual('{"method":"varPop","attribute":"price","values":["vp"]}')
    );

    test('varSamp', () =>
        expect(Query.varSamp('price', 'vs'))
            .toEqual('{"method":"varSamp","attribute":"price","values":["vs"]}')
    );

    test('bitAnd', () =>
        expect(Query.bitAnd('flags', 'band'))
            .toEqual('{"method":"bitAnd","attribute":"flags","values":["band"]}')
    );

    test('bitOr', () =>
        expect(Query.bitOr('flags', 'bor'))
            .toEqual('{"method":"bitOr","attribute":"flags","values":["bor"]}')
    );

    test('bitXor', () =>
        expect(Query.bitXor('flags', 'bxor'))
            .toEqual('{"method":"bitXor","attribute":"flags","values":["bxor"]}')
    );

    test('groupBy', () =>
        expect(Query.groupBy(['status', 'year']))
            .toEqual('{"method":"groupBy","values":["status","year"]}')
    );

    test('having nests parsed queries', () => {
        const having = JSON.parse(Query.having([Query.greaterThan('total', 1)]));
        expect(having.method).toEqual('having');
        expect(having.values[0].method).toEqual('greaterThan');
        expect(having.values[0].attribute).toEqual('total');
        expect(having.values[0].values).toEqual([1]);
    });

    test('distinct', () =>
        expect(Query.distinct())
            .toEqual('{"method":"distinct"}')
    );

    test('join', () =>
        expect(Query.join('orders', '$id', 'customerId'))
            .toEqual('{"method":"join","attribute":"orders","values":["$id","=","customerId"]}')
    );

    test('leftJoin with alias', () =>
        expect(Query.leftJoin('orders', '$id', 'customerId', '=', 'ord'))
            .toEqual('{"method":"leftJoin","attribute":"orders","values":["$id","=","customerId","ord"]}')
    );

    test('rightJoin', () =>
        expect(Query.rightJoin('orders', '$id', 'customerId'))
            .toEqual('{"method":"rightJoin","attribute":"orders","values":["$id","=","customerId"]}')
    );

    test('fullOuterJoin', () =>
        expect(Query.fullOuterJoin('orders', '$id', 'customerId'))
            .toEqual('{"method":"fullOuterJoin","attribute":"orders","values":["$id","=","customerId"]}')
    );

    test('on', () =>
        expect(Query.on('$id', 'customerId'))
            .toEqual('{"method":"on","values":["$id","=","customerId"]}')
    );

    test('nested leftJoin', () => {
        const query = JSON.parse(Query.leftJoin('orders', 'ord', [
            Query.on('$id', 'customerId'),
            Query.equal('ord.status', 'paid'),
        ]));
        expect(query.method).toEqual('leftJoin');
        expect(query.attribute).toEqual('orders');
        expect(query.values[0]).toEqual('ord');
        expect(query.values[1].method).toEqual('on');
        expect(query.values[2].method).toEqual('equal');
    });

    test('crossJoin', () =>
        expect(Query.crossJoin('orders', 'ord'))
            .toEqual('{"method":"crossJoin","attribute":"orders","values":["ord"]}')
    );

    test('vectorDot', () =>
        expect(Query.vectorDot('embedding', [0.1, 0.2]))
            .toEqual('{"method":"vectorDot","attribute":"embedding","values":[[0.1,0.2]]}')
    );

    test('notCovers', () =>
        expect(Query.notCovers('location', [1, 2]))
            .toEqual('{"method":"notCovers","attribute":"location","values":[[1,2]]}')
    );

    test('spatialEquals', () =>
        expect(Query.spatialEquals('location', [1, 2]))
            .toEqual('{"method":"spatialEquals","attribute":"location","values":[[1,2]]}')
    );

    test('notSpatialEquals', () =>
        expect(Query.notSpatialEquals('location', [1, 2]))
            .toEqual('{"method":"notSpatialEquals","attribute":"location","values":[[1,2]]}')
    );

    test('page', () => {
        const queries = Query.page(2, 10);
        expect(queries).toEqual([
            '{"method":"limit","values":[10]}',
            '{"method":"offset","values":[10]}',
        ]);
    });

    test('builder build', () => {
        const built = Query.builder()
            .equal('status', 'published')
            .leftJoin('orders', '$id', 'customerId', '=', 'ord')
            .count('*', 'total')
            .groupBy(['status'])
            .limit(25)
            .build();

        expect(built).toEqual([
            Query.equal('status', 'published'),
            Query.leftJoin('orders', '$id', 'customerId', '=', 'ord'),
            Query.count('*', 'total'),
            Query.groupBy(['status']),
            Query.limit(25),
        ]);
    });

    test('normalize builder wrapped in array', () => {
        const builder = Query.builder().equal('status', 'active').limit(10);
        expect(normalizeQueries([builder])).toEqual(builder.build());
        expect(normalizeQueries([builder.build()])).toEqual(builder.build());
        expect(normalizeQueries(builder)).toEqual(builder.build());
    });

    test('normalize page wrapped in array', () => {
        expect(normalizeQueries([Query.equal('status', 'active'), Query.page(2, 10)])).toEqual([
            Query.equal('status', 'active'),
            Query.limit(10),
            Query.offset(10),
        ]);
    });
})
