<?php

declare(strict_types=1);

namespace {{ namespace | caseNamespace }};

abstract class Service
{
    public function __construct(protected Client $client)
    {
    }

    /**
     * Encode a value as one path segment.
     *
     * Everything but letters, digits and -_.!~*'() is escaped, as
     * encodeURIComponent does, so a value fills exactly the segment it
     * replaces.
     */
    protected static function encodePath(string|int|float|bool|null $value): string
    {
        return strtr(rawurlencode((string) $value), [
            '%21' => '!',
            '%2A' => '*',
            '%27' => "'",
            '%28' => '(',
            '%29' => ')',
        ]);
    }
}
