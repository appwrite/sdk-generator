func TestSetSelfSigned(t *testing.T) {
	c := New()
	c.SelfSigned = true
	if !c.SelfSigned {
		t.Errorf("Expected SelfSigned to be true")
	}
}

func selfSignedServer(t *testing.T) *httptest.Server {
	t.Helper()

	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("content-type", "application/json")
		w.Write([]byte("{}"))
	}))

	return server
}

// SelfSigned has to reach the request, and it has to stay on the client it was
// asked of: the process default is what every other http.Client falls back to.
func TestSelfSignedAcceptsTheCertificateWithoutTouchingTheDefaultTransport(t *testing.T) {
	server := selfSignedServer(t)
	defer server.Close()

	c := New()
	c.Endpoint = server.URL
	c.SelfSigned = true

	if _, err := c.Call("GET", "/", nil, nil); err != nil {
		t.Fatalf("Expected the self-signed certificate to be accepted, got %v", err)
	}

	standard, ok := http.DefaultTransport.(*http.Transport)
	if !ok {
		t.Fatal("Expected http.DefaultTransport to be an *http.Transport")
	}
	if standard.TLSClientConfig != nil && standard.TLSClientConfig.InsecureSkipVerify {
		t.Error("Expected http.DefaultTransport to keep verifying certificates")
	}
}

func TestSelfSignedDoesNotLeakToAnotherClient(t *testing.T) {
	server := selfSignedServer(t)
	defer server.Close()

	trusting := New()
	trusting.Endpoint = server.URL
	trusting.SelfSigned = true

	if _, err := trusting.Call("GET", "/", nil, nil); err != nil {
		t.Fatalf("Expected the self-signed certificate to be accepted, got %v", err)
	}

	verifying := New()
	verifying.Endpoint = server.URL

	if _, err := verifying.Call("GET", "/", nil, nil); err == nil {
		t.Error("Expected a client without SelfSigned to reject the certificate")
	}
}

func TestSelfSignedPreservesExistingTLSConfig(t *testing.T) {
	originalTLSConfig := &tls.Config{ServerName: "example.com"}
	originalTransport := &http.Transport{TLSClientConfig: originalTLSConfig}

	c := New(func(client *Client) error {
		client.Client.Transport = originalTransport
		client.SelfSigned = true
		return nil
	})

	configuredTransport, ok := c.Client.Transport.(*http.Transport)
	if !ok {
		t.Fatal("Expected the configured transport to be an *http.Transport")
	}
	if configuredTransport == originalTransport {
		t.Error("Expected the transport to be cloned")
	}
	if configuredTransport.TLSClientConfig == originalTLSConfig {
		t.Error("Expected the TLS configuration to be cloned")
	}
	if configuredTransport.TLSClientConfig.ServerName != originalTLSConfig.ServerName {
		t.Error("Expected the existing TLS configuration to be preserved")
	}
	if !configuredTransport.TLSClientConfig.InsecureSkipVerify {
		t.Error("Expected certificate verification to be disabled")
	}
	if originalTLSConfig.InsecureSkipVerify {
		t.Error("Expected the caller-owned TLS configuration to remain unchanged")
	}
}

type customRoundTripper struct{}

func (transport *customRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
	return nil, nil
}

func TestSelfSignedDoesNotReplaceCustomTransport(t *testing.T) {
	transport := &customRoundTripper{}
	httpClient := &http.Client{Transport: transport}

	configuredClient, err := withSelfSigned(httpClient)
	if err == nil {
		t.Fatal("Expected an unsupported custom transport to return an error")
	}
	if configuredClient != nil {
		t.Error("Expected no configured client after an error")
	}
	if httpClient.Transport != transport {
		t.Error("Expected the caller-owned transport to remain unchanged")
	}
}

func TestSelfSignedConcurrentCalls(t *testing.T) {
	server := selfSignedServer(t)
	defer server.Close()

	c := New()
	c.Endpoint = server.URL
	c.SelfSigned = true

	const calls = 8
	errors := make(chan error, calls)
	var waitGroup sync.WaitGroup
	for i := 0; i < calls; i++ {
		waitGroup.Add(1)
		go func() {
			defer waitGroup.Done()
			_, err := c.Call("GET", "/", nil, nil)
			errors <- err
		}()
	}

	waitGroup.Wait()
	close(errors)
	for err := range errors {
		if err != nil {
			t.Errorf("Expected concurrent calls to accept the self-signed certificate, got %v", err)
		}
	}
}

// EncodePath has to match encodeURIComponent, not url.PathEscape: an id
// containing `&` or `=` reaches a different route if the sub-delimiters legal in
// a path segment are left alone.
func TestEncodePath(t *testing.T) {
	cases := []struct {
		name     string
		value    string
		expected string
	}{
		{"unreserved characters are left alone", "-_.!~*'()", "-_.!~*'()"},
		{"alphanumerics are left alone", "abcXYZ098", "abcXYZ098"},
		{"slash", "grant/special", "grant%2Fspecial"},
		{"sub-delimiters url.PathEscape would leave alone", "a&b=c", "a%26b%3Dc"},
		{"space", "two words", "two%20words"},
		{"multi-byte utf-8 is encoded per byte", "café", "caf%C3%A9"},
		{"reserved characters", "a?b#c/d", "a%3Fb%23c%2Fd"},
		{"empty", "", ""},
	}

	for _, testCase := range cases {
		t.Run(testCase.name, func(t *testing.T) {
			if encoded := EncodePath(testCase.value); encoded != testCase.expected {
				t.Errorf("EncodePath(%q) = %q, expected %q", testCase.value, encoded, testCase.expected)
			}
		})
	}
}

// Arrays are indexed as key[0], key[1] so Go agrees with the Node, Python and
// PHP SDKs.
func TestAddQueryParam(t *testing.T) {
	q := url.Values{}

	AddQueryParam(q, "queries", []string{"first", "second"})
	AddQueryParam(q, "search", "term")
	AddQueryParam(q, "empty", "")
	AddQueryParam(q, "missing", nil)

	expected := url.Values{
		"queries[0]": []string{"first"},
		"queries[1]": []string{"second"},
		"search":     []string{"term"},
	}

	if q.Encode() != expected.Encode() {
		t.Errorf("Expected %q, got %q", expected.Encode(), q.Encode())
	}
}
