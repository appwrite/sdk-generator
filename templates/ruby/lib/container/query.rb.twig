            def on(left, right, operator = '=')
                return Query.new("on", nil, [left, operator, right]).to_s
            end

            def join(table, left, right = '', operator = '=', alias_name = '')
                return create_join("join", table, left, right, operator, alias_name)
            end

            def left_join(table, left, right = '', operator = '=', alias_name = '')
                return create_join("leftJoin", table, left, right, operator, alias_name)
            end

            def right_join(table, left, right = '', operator = '=', alias_name = '')
                return create_join("rightJoin", table, left, right, operator, alias_name)
