        {%~ elseif (method | methodType) == 'location' %}
        {{~ include('swift/base/requests/location.twig')}}
        {%~ else %}
        {%~ if (method | responseModel) %}
        let converter: (Any) throws -> {{ method | returnType(spec) | raw }} = { response in
            {%~ if (method | responseModel) == 'any' %}
            return response
            {%~ elseif (method | getValidResponseModels)|length > 1 %}
{% set hasResponseDiscriminator = (method | responseDiscriminator) is not empty %}
{% set responseDiscriminator = (method | responseDiscriminator) %}
            {%~ if hasResponseDiscriminator %}
            guard let responseMap = response as? [String: Any] else {
                throw AppwriteError(message: "Expected object response when hydrating a response model")
            }
{% for modelName, conditions in responseDiscriminator %}
