{%~ for parameter in (method | parameters('path')) %}
{%- if parameter.required and not (parameter | configKey(method)) and (parameter | schemaType) == 'string' and not (parameter | usesEnumType) %}

            if ({{ parameter.name | caseCamel | escapeKeyword }} == "")
            {
                throw new {{ spec.info.title | caseUcfirst }}Exception("Missing required parameter: \"{{ parameter.name | caseCamel | escapeKeyword }}\"");
            }
{% endif %}
{%~ endfor %}
