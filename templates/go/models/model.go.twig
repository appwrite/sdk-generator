func (model {{ definitionName | caseUcfirst }}) New(data []byte) *{{ definitionName | caseUcfirst }} {
	model.data = data
	return &model
}

{%~ if defaults is not empty %}
// UnmarshalJSON decodes a response into a fresh model: present keys keep their
// value, and required keys the response omits take their documented default.
func (model *{{ definitionName | caseUcfirst }}) UnmarshalJSON(data []byte) error {
	type alias {{ definitionName | caseUcfirst }}
	decoded := alias{data: model.data}
	if err := json.Unmarshal(data, &decoded); err != nil {
		return err
	}

	{%~ set width = 0 %}
	{%~ for property in definition.properties | filter((property) => (property | schemaRequired) and (property | schemaDefault) is not null) %}
	{%~ set width = max(width, ((property | schemaName) | caseUcfirst | escapeKeyword) | length) %}
	{%~ endfor %}
	var present struct {
	{%~ for property in definition.properties | filter((property) => (property | schemaRequired) and (property | schemaDefault) is not null) %}
		{{ ('%-' ~ width ~ 's') | format((property | schemaName) | caseUcfirst | escapeKeyword) }} json.RawMessage `json:"{{ property | schemaName }}"`
	{%~ endfor %}
	}
	if err := json.Unmarshal(data, &present); err != nil {
		return err
	}
	{%~ for property in definition.properties | filter((property) => (property | schemaRequired) and (property | schemaDefault) is not null) %}
	if present.{{ (property | schemaName) | caseUcfirst | escapeKeyword }} == nil {
		if err := json.Unmarshal([]byte({{ (property | schemaDefault) | goJsonString }}), &decoded.{{ (property | schemaName) | caseUcfirst | escapeKeyword }}); err != nil {
			return err
		}
	}
	{%~ endfor %}

	*model = {{ definitionName | caseUcfirst }}(decoded)
	return nil
}

{%~ endif %}
{%~ if definition.additionalProperties %}
// Use this method to get response in desired type
{%~ endif %}
func (model *{{ definitionName | caseUcfirst }}) Decode(value interface{}) error {
	if len(model.data) <= 0 {
		return errors.New("method Decode() cannot be used on nested struct")
	}

	err := json.Unmarshal(model.data, value)
	if err != nil {
		return err
	}

	return nil
}
