    public static func page(_ page: Int, perPage: Int = 25) -> [String] {
        precondition(page >= 1, "Page must be >= 1, got \(page)")
        precondition(perPage >= 1, "Per page must be >= 1, got \(perPage)")
        return [limit(perPage), offset((page - 1) * perPage)]
    }

    public static func builder() -> QueryBuilder {
        return QueryBuilder()
    }

    static func normalize(_ queries: Any?) -> [String] {
        guard let queries else {
            return []
        }
        if queries is NSNull {
            return []
        }
        if let builder = queries as? QueryBuilder {
            return builder.build()
        }
        if let query = queries as? Query {
            return [query.description]
        }
        if let string = queries as? String {
            return [string]
        }
        if let strings = queries as? [String] {
            return strings
        }
        if let builders = queries as? [QueryBuilder] {
            return builders.flatMap { $0.build() }
        }
        if let nested = queries as? [[String]] {
            return nested.flatMap { $0 }
        }
        if let nestedAny = queries as? [Any] {
            return nestedAny.flatMap { normalize($0) }
        }
        if let nestedOptional = queries as? [Any?] {
            return nestedOptional.flatMap { normalize($0) }
        }
        return []
    }

    private static func joinQuery(_ method: String, table: String, left: String, right: String, operator op: String, alias: String) -> String {
        var values: [String] = [left, op, right]
        if !alias.isEmpty {
            values.append(alias)
        }
        return Query(
            method: method,
            attribute: table,
            values: values
        ).description
    }

    private static func nestedJoin(_ method: String, table: String, alias: String, on: [String]) -> String {
        var values: [Any] = []
        if !alias.isEmpty {
            values.append(alias)
        }
        for query in on {
            if let data = query.data(using: .utf8),
               let parsed = try? JSONDecoder().decode(Query.self, from: data) {
                values.append(parsed)
            }
        }
        return Query(
            method: method,
            attribute: table,
            values: values
        ).description
    }

    private static func decodeQueries(_ queries: [String]) -> [Query] {
        let decoder = JSONDecoder()
        return queries.compactMap { queryStr -> Query? in
            guard let data = queryStr.data(using: .utf8) else {
                return nil
            }
            return try? decoder.decode(Query.self, from: data)
        }
    }

    private static func parseValue(_ value: Any) -> [Any] {
        if let value = value as? [Any] {
            return value
        } else {
            return [value]
        }
    }
}

