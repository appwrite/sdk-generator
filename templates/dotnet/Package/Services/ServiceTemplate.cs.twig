{% import 'dotnet/base/utils.twig' as utils %}
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
{% if definitions is not empty %}
using {{ spec.info.title | caseUcfirst }}.Models;
{% endif %}
{% if requestEnums is not empty %}
using {{ spec.info.title | caseUcfirst }}.Enums;
{% endif %}

namespace {{ spec.info.title | caseUcfirst }}.Services
{
    public class {{ service.name | caseUcfirst }} : Service
    {
        public {{ service.name | caseUcfirst }}(Client client) : base(client)
        {
        }

        {%~ for method in (service | operations) %}
        {%~ if method.description %}
        /// <para>
        {{~ method.description | wrap(75, '        /// ') }}
        /// </para>
        {%~ endif %}
        /// </summary>
        {%~ if method.deprecated %}
        {%~ if (method | appwrite('deprecated', {})['since'] ?? '') and (method | appwrite('deprecated', {})['replaceWith'] ?? '') %}
        [Obsolete("This API has been deprecated since {{ (method | appwrite('deprecated', {})['since'] ?? '') }}. Please use `{{ (method | appwrite('deprecated', {})['replaceWith'] ?? '') | capitalizeFirst }}` instead.")]
        {%~ else %}
        [Obsolete("This API has been deprecated.")]
        {%~ endif %}
        {%~ endif %}
        public Task{% if (method | methodType) == "webAuth" %}<String>{% else %}<{{ utils.resultType(spec.info.title, method) }}>{% endif %} {{ (method | methodName) | caseUcfirst }}({{ utils.method_parameters((method | parameters('all')), (method | consumes)) }})
        {
            var apiPath = "{{ method.path }}"{% if (method | parameters('path')) | length == 0 %};{% endif %}

            {{~ include('dotnet/base/params.twig') }}

            {%~ if (method | responseModel) %}
{% set hasResponseDiscriminator = (method | responseDiscriminator) is not empty %}
{% set responseDiscriminator = (method | responseDiscriminator) %}
            static {{ utils.resultType(spec.info.title, method) }} Convert(Dictionary<string, object> it)
            {
            {%~ if (method | responseModel) == 'any' or (method | responseModels)|length > 1 %}
                {%~ if (method | getValidResponseModels)|length > 1 %}
                    {%~ if hasResponseDiscriminator %}
{% for modelName, conditions in responseDiscriminator %}
                if ({% for field, expectedValue in conditions %}it.TryGetValue("{{ field }}", out var {{ field | caseCamel }}Value{{ loop.parent.loop.index }}) && {{ field | caseCamel }}Value{{ loop.parent.loop.index }}?.ToString() == "{{ expectedValue }}"{% if not loop.last %} && {% endif %}{% endfor %})
                {
                    return {{ spec.info.title | caseUcfirst }}.Models.{{ modelName | caseUcfirst | overrideIdentifier }}.From(map: it);
                }
{% endfor %}
                throw new System.Exception("Unable to match response to any expected response model");
                    {%~ else %}
                return {{ spec.info.title | caseUcfirst }}.Models.{{ (method | responseModel) | caseUcfirst | overrideIdentifier }}.From(map: it);
                    {%~ endif %}
                {%~ else %}
                return it;
                {%~ endif %}
            {%~ else %}
                return {{ utils.resultType(spec.info.title, method) }}.From(map: it);
            {%~ endif %}
            }
            {%~ endif %}

            {%~ if (method | methodType) == 'location' %}
            {{~ include('dotnet/base/requests/location.twig') }}
            {%~ elseif (method | methodType) == 'webAuth' %}
            {{~ include('dotnet/base/requests/oauth.twig') }}
            {%~ elseif 'multipart/form-data' in (method | consumes) %}
            {{~ include('dotnet/base/requests/file.twig') }}
            {%~ else %}
            {{~ include('dotnet/base/requests/api.twig')}}
            {%~ endif %}
        }

    {%~ endfor %}
    }
}
