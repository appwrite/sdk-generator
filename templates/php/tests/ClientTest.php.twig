    public function testRedirectThrowsWhenRedirectsAreNotFollowed(): void
    {
        $transport = $this->createMock(ClientInterface::class);
        $transport->expects($this->once())->method('sendRequest')
            ->willReturn(new Response(302, body: new Stream('moved'))->withHeader('location', 'https://other.example/target'));

        $client = new Client($transport)->setEndpoint('https://example.com')->setFollowRedirects(false);

        try {
            $client->call(Client::METHOD_GET, '/redirect');
            $this->fail('A redirect response should throw when redirects are not followed.');
        } catch ({{ namespace | split('\\') | last | caseUcfirst }}Exception $error) {
            $this->assertSame('Redirects are not followed', $error->getMessage());
            $this->assertSame(302, $error->getCode());
        }
    }

