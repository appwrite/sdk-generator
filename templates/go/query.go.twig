func Page(page, perPage int) []string {
	if page < 1 {
		panic(fmt.Sprintf("Page must be >= 1, got %d", page))
	}
	if perPage < 1 {
		panic(fmt.Sprintf("Per page must be >= 1, got %d", perPage))
	}
	return []string{Limit(perPage), Offset((page - 1) * perPage)}
}

type QueryBuilder struct {
	queries []string
}

func Builder() *QueryBuilder {
	return &QueryBuilder{}
}

func (b *QueryBuilder) Build() []string {
	result := make([]string, len(b.queries))
	copy(result, b.queries)
	return result
}

func (b *QueryBuilder) push(queries ...string) *QueryBuilder {
	b.queries = append(b.queries, queries...)
	return b
}

func (b *QueryBuilder) Equal(attribute string, value interface{}) *QueryBuilder {
	return b.push(Equal(attribute, value))
}

