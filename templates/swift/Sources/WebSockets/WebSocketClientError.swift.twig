/// Error mapped HTTP codes
enum WebSocketClientError: UInt, Swift.Error {
    case upgradeRejected = 0
    case notFound = 404
    case badRequest = 400

    func code() -> UInt? {
        switch self {
        case .upgradeRejected:
            return nil
        case .notFound:
            return 404
        case .badRequest:
            return 400
        }
    }
}
