<?php

declare(strict_types=1);

namespace {{ namespace | caseNamespace }};

use PHPUnit\Framework\Attributes\DataProvider;
use PHPUnit\Framework\TestCase;

final class TopicTest extends TestCase
{
    public function testPath(): void
    {
        $this->assertSame('user', (string) Topic::path(['user']));
        $this->assertSame('user/notification', (string) Topic::path(['user', 'notification']));
        $this->assertSame('user/notification', (string) Topic::path(['user'])->path(['notification']));
    }

    public function testAny(): void
    {
        $this->assertSame('user/+/notification', (string) Topic::path(['user'])->any()->path(['notification']));
        $this->assertSame('chat/+/+/message', (string) Topic::path(['chat'])->any()->any()->path(['message']));
        $this->assertSame('+/notification', (string) Topic::any()->path(['notification']));
    }

    public function testAll(): void
    {
        $this->assertSame('org/+/logs/#', (string) Topic::path(['org'])->any()->path(['logs'])->all());
        $this->assertSame('#', (string) Topic::all());
    }

    public function testNothingAfterAll(): void
    {
        $this->expectException(\BadMethodCallException::class);
        $this->expectExceptionMessage('nothing can come after all()');
        Topic::all()->any();
    }

    /**
     * @return \Iterator<string, array{mixed, string}>
     */
    public static function invalidLevels(): \Iterator
    {
        yield 'not an array' => ['user', "path() expects an array, e.g. path(['user'])"];
        yield 'empty path' => [[], 'path() needs at least one level'];
        yield 'not a string' => [['user', 42], 'level at index 1 must be a string, got int'];
        yield 'null' => [['user', null], 'level at index 1 must be a string, got null'];
        yield 'empty level' => [['user', ''], 'empty level at index 1'];
        yield 'slash' => [['user/123'], "\"user/123\" contains \"/\", split it: path(['user', '123'])"];
        yield 'plus' => [['user', '+'], '"+" is reserved, use any()'];
        yield 'contains plus' => [['user', 'a+b'], '"a+b" contains "+", use any() for wildcards'];
        yield 'hash' => [['user', '#'], '"#" is reserved, use all()'];
        yield 'contains hash' => [['user', 'a#b'], '"a#b" contains "#", use all() for wildcards'];
    }

    #[DataProvider('invalidLevels')]
    public function testInvalidLevels(mixed $levels, string $message): void
    {
        $this->expectException(\InvalidArgumentException::class);
        $this->expectExceptionMessage($message);
        Topic::path($levels);
    }

    public function testInvalidLevelsWhenAppending(): void
    {
        $this->expectException(\InvalidArgumentException::class);
        $this->expectExceptionMessage('empty level at index 0');
        Topic::path(['user'])->path(['']);
    }
}
