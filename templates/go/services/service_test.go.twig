{% autoescape false %}
{%- set requireFilesPkg = false -%}
{%- set requireOsPkg = false -%}
{%- set requireModelsPkg = false -%}
{%- for method in (service | operations) -%}
    {%- if (method | getValidResponseModels)|length > 1 -%}
        {%- set requireModelsPkg = true -%}
    {%- endif -%}
    {%- for parameter in (method | parameters('all')) -%}
        {%- if "file.InputFile" in (parameter | typeName) -%}
            {%- set requireFilesPkg = true -%}
            {%- set requireOsPkg = true -%}
        {%- endif -%}
    {%- endfor -%}
{%- endfor -%}
{% macro render_json_value(definitions, property, spec, indent = '') -%}
{%- import _self as helper -%}
{%- set childIndent = indent ~ '    ' -%}
{%- if (property | schemaModel) and definitions[(property | schemaModel)] -%}
    {%- set requiredProps = definitions[(property | schemaModel)].properties | filter(p => p.required) -%}
    {%- if (property | schemaType) == 'array' -%}
[
{{ childIndent }}{
{% for prop in requiredProps %}
{{ childIndent }}    "{{ prop.name | replace({'\\': '\\\\', '"': '\\"'}) | raw }}": {{ helper.render_json_value(definitions, prop, spec, childIndent ~ '    ') | trim | raw }}{% if not loop.last %},{% endif %}{{ "\n" -}}
{% endfor %}
{{ childIndent }}}
{{ indent }}]
    {%- else -%}
{
{% for prop in requiredProps %}
{{ indent }}    "{{ prop.name | replace({'\\': '\\\\', '"': '\\"', '`': '\\u0060'}) | raw }}": {{ helper.render_json_value(definitions, prop, spec, indent ~ '    ') | trim | raw }}{% if not loop.last %},{% endif %}{{ "\n" -}}
{% endfor %}
{{ indent }}}
    {%- endif -%}
{%- else -%}
    {%- if (property | schemaType) == 'object' -%}
{}
{%- elseif (property | schemaType) == 'array' -%}
[]
{%- elseif (property | schemaType) == 'string' -%}
"{{ ((property | schemaExample) | default('string')) | replace({'\\': '\\\\', '"': '\\"', '`': '\\u0060'}) | raw }}"
    {%- elseif (property | schemaType) == 'boolean' -%}
true
    {%- elseif (property | schemaType) == 'integer' -%}
{{ (property | schemaExample) | default(1) }}
    {%- elseif (property | schemaType) == 'number' -%}
{{ (property | schemaExample) | default(1.0) }}
    {%- else -%}
{{ ((property | schemaExample) is empty) ? "null" : (property | schemaExample) }}
    {%- endif -%}
{%- endif -%}
{%- endmacro %}
package {{ service.name | caseLower }}

import (
	"net/http"
	"net/http/httptest"
	"testing"
{% if requireOsPkg %}	"os"
{% endif %}

	"{{ sdk | goPackagePath }}/client"
{% if requireModelsPkg %}	"{{ sdk | goPackagePath }}/models"
{% endif %}
{% if requireFilesPkg %}	"{{ sdk | goPackagePath }}/file"
{%- endif %}
)

func Test{{ service.name | caseUcfirst }}(t *testing.T) {
{% if requireOsPkg %}
	tmpFile, err := os.CreateTemp("", "test")
	if err != nil {
		t.Fatal(err)
	}
	defer os.Remove(tmpFile.Name())
	_, _ = tmpFile.WriteString("test content")
	_ = tmpFile.Close()
{% endif %}
	newTestClient := func(ts *httptest.Server) client.Client {
		c := client.New()
		c.Endpoint = ts.URL
		c.Client = ts.Client()
		return c
	}

{% for method in (service | operations) %}
{% if not loop.first %}

{% endif %}
	t.Run("Test {{ (method | methodName) | caseUcfirst }}", func(t *testing.T) {
{% if (method | methodType) == 'webAuth' %}
{% if (method | returnType(spec, spec.info.title | caseLower)) == 'bool' %}
		mockResponse := `true`
{% else %}
		mockResponse := `"https://example.com"`
{% endif %}
{% elseif (method | methodType) == 'location' %}
		mockData := []byte("image_data")
{% else %}
{% set responseModels = method | getValidResponseModels %}
{% set responseDiscriminator = (method | responseDiscriminator) %}
{% set responseModelName = '' %}
{# Mirror base/requests/api.twig: a union only picks between models when a
   discriminator says how. Without one the service falls back to responseModel,
   so asserting any other member gives a test the generated code cannot pass. #}
{% if responseModels|length > 1 and responseDiscriminator is not empty %}
{% set responseModelName = responseModels|last %}
{% elseif (method | responseModel) and (method | responseModel) != 'any' %}
{% set responseModelName = (method | responseModel) %}
{% endif %}
{% if responseModelName %}
{% for definitionName, definition in definitions %}
{% if definitionName == responseModelName %}
{% set discriminatorConditions = responseDiscriminator[responseModelName] ?? {} %}
		mockResponse := `
{
{% for property in definition.properties | filter((param) => param.required) %}
    "{{ (property | schemaName) | replace({'\\': '\\\\', '"': '\\"', '`': '\\u0060'}) | raw }}": {% if discriminatorConditions[(property | schemaName)] is defined %}"{{ discriminatorConditions[(property | schemaName)] | replace({'\\': '\\\\', '"': '\\"', '`': '\\u0060'}) | raw }}"{% else %}{{ _self.render_json_value(definitions, property, spec, '    ') | trim | raw }}{% endif %}{% if not loop.last %},{% endif %}{{ "\n" -}}
{% endfor %}
}
`
{% endif %}
{% endfor %}
{% else %}
		mockResponse := `
{
    "message": "success"
}
`
{% endif %}
{% endif %}

		ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
{% set methodUsesFile = false %}
{% for parameter in (method | parameters('all')) %}
{% if "file.InputFile" in (parameter | typeName) %}
{% set methodUsesFile = true %}
{% endif %}
{% endfor %}
{% if methodUsesFile and method.method.value | upper != 'GET' %}
			if r.Method == "GET" && "{{ method.method.value | upper }}" != "GET" {
				// Handle file upload resume check
				w.Header().Set("Content-Type", "application/json")
				w.WriteHeader(http.StatusOK)
				_, _ = w.Write([]byte(`{"chunksUploaded": 0}`))
				return
			}
{% endif %}
			if r.Method != "{{ method.method.value | upper }}" {
				t.Errorf("Expected method {{ method.method.value | upper }}, got %s", r.Method)
			}

			w.Header().Set("Content-Type", {% if (method | methodType) == 'location' %}"image/png"{% else %}"application/json"{% endif %})
			w.WriteHeader(http.StatusOK)
{% if (method | methodType) == 'location' %}
			_, _ = w.Write(mockData)
{% else %}
			_, _ = w.Write([]byte(mockResponse))
{% endif %}
		}))
		defer ts.Close()

		srv := New(newTestClient(ts))

{% set params = '' %}
{% for parameter in (method | parameters('all')) | filter((param) => param.required) %}
{% set val = '' %}
{% set type = (parameter | typeName) %}
{% if "file.InputFile" in type %}
{% set val = 'file.NewInputFile(tmpFile.Name(), "test.txt")' %}
{% elseif (parameter | schemaType) == 'object' %}
{% set val = 'map[string]interface{}{}' %}
{% elseif (parameter | schemaType) == 'array' %}
{% if parameter.items.type == 'string' %}
{% set val = '[]string{}' %}
{% else %}
{% set val = type ~ '{}' %}
{% endif %}
{% elseif (parameter | schemaType) == 'boolean' %}
{% set val = 'true' %}
{% elseif (parameter | schemaType) == 'string' %}
{% set val = '"' ~ ((parameter | schemaExample) | replace({'\\': '\\\\', '"': '\\"'}) | raw) ~ '"' %}
{% elseif (parameter | schemaType) == 'integer' %}
{% set val = '1' %}
{% elseif (parameter | schemaType) == 'number' %}
{% set val = '1.0' %}
{% else %}
{% set val = (parameter | schemaExample) %}
{% endif %}
{% set params = params ~ val %}
{% if not loop.last %}{% set params = params ~ ', ' %}{% endif %}
{% endfor %}
{% if responseModels|length > 1 %}
		response, err := srv.{{ (method | methodName) | caseUcfirst }}({{ params }})
{% else %}
		_, err := srv.{{ (method | methodName) | caseUcfirst }}({{ params }})
{% endif %}
		if err != nil {
			t.Errorf("Method {{ (method | methodName) | caseUcfirst }} failed: %v", err)
		}
{% if responseModels|length > 1 and responseModelName %}
		if _, ok := response.(*models.{{ responseModelName | caseUcfirst }}); !ok {
			t.Errorf("Expected response type *models.{{ responseModelName | caseUcfirst }}, got %T", response)
		}
{% endif %}
	})
{% endfor %}
}
{% endautoescape %}
