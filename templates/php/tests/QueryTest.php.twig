        $query = json_decode(Query::leftJoin('orders', 'ord', [
            Query::on('$id', 'customerId'),
            Query::equal('ord.status', 'paid'),
        ]), true);
        $this->assertSame('leftJoin', $query['method']);
        $this->assertSame('orders', $query['attribute']);
        $this->assertSame('ord', $query['values'][0]);
        $this->assertSame('on', $query['values'][1]['method']);
        $this->assertSame(['$id', '=', 'customerId'], $query['values'][1]['values']);
        $this->assertSame('equal', $query['values'][2]['method']);
        $this->assertSame('ord.status', $query['values'][2]['attribute']);
    }

