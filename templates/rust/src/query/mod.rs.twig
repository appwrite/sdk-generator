        assert_eq!(value["values"][1], "=");
        assert_eq!(value["values"][2], "customerId");
    }

    #[test]
    fn test_nested_left_join() {
        let query = Query::left_join_on(
            "orders",
            "ord",
            [
                Query::on("$id", "customerId", "=").to_string(),
                Query::equal("ord.status", "paid").to_string(),
            ],
        );
        let value = query.to_value();
        assert_eq!(value["method"], "leftJoin");
        assert_eq!(value["attribute"], "orders");
        assert_eq!(value["values"][0], "ord");
        assert_eq!(value["values"][1]["method"], "on");
        assert_eq!(value["values"][2]["method"], "equal");
    }

    #[test]
    fn test_cross_join() {
        let query = Query::cross_join("orders", "ord");
        let value = query.to_value();
        assert_eq!(value["method"], "crossJoin");
        assert_eq!(value["attribute"], "orders");
        assert_eq!(value["values"][0], "ord");
    }

    #[test]
    fn test_right_join() {
        let value = Query::right_join("orders", "$id", "customerId", "=", "").to_value();
        assert_eq!(value["method"], "rightJoin");
        assert_eq!(value["values"][0], "$id");
        assert_eq!(value["values"][1], "=");
        assert_eq!(value["values"][2], "customerId");
    }

    #[test]
    fn test_full_outer_join() {
        let value = Query::full_outer_join("orders", "$id", "customerId", "=", "").to_value();
        assert_eq!(value["method"], "fullOuterJoin");
    }

    #[test]
    fn test_not_covers() {
        let value = Query::not_covers("location", Value::Array(vec![Value::from(1), Value::from(2)])).to_value();
        assert_eq!(value["method"], "notCovers");
        assert_eq!(value["values"][0][0], 1);
        assert_eq!(value["values"][0][1], 2);
    }

    #[test]
    fn test_spatial_equals() {
        let value = Query::spatial_equals("location", Value::Array(vec![Value::from(1), Value::from(2)])).to_value();
        assert_eq!(value["method"], "spatialEquals");
    }

    #[test]
    fn test_not_spatial_equals() {
        let value = Query::not_spatial_equals("location", Value::Array(vec![Value::from(1), Value::from(2)])).to_value();
        assert_eq!(value["method"], "notSpatialEquals");
    }

    #[test]
    fn test_page() {
        let queries = Query::page(2, 10);
        assert_eq!(queries.len(), 2);
        let limit = queries[0].clone().to_value();
        let offset = queries[1].clone().to_value();
        assert_eq!(limit["method"], "limit");
        assert_eq!(limit["values"][0], 10);
        assert_eq!(offset["method"], "offset");
        assert_eq!(offset["values"][0], 10);
    }

    #[test]
    fn test_builder_build() {
        let built = Query::builder()
            .equal("status", "published")
            .left_join("orders", "$id", "customerId", "=", "ord")
            .count("*", "total")
            .group_by(vec!["status"])
            .limit(25)
            .build();

        assert_eq!(
            built,
            vec![
                Query::equal("status", "published").to_string(),
                Query::left_join("orders", "$id", "customerId", "=", "ord").to_string(),
                Query::count("*", "total").to_string(),
                Query::group_by(vec!["status"]).to_string(),
                Query::limit(25).to_string(),
            ]
        );
    }

    #[test]
    fn test_normalize_builder() {
        let builder = Query::builder().equal("status", "active").limit(10);
        let expected = builder.build();
        assert_eq!(Query::normalize(builder.clone()), expected);
        assert_eq!(Query::normalize(vec![builder.clone()]), expected);
        assert_eq!(Query::normalize(vec![builder.build()]), expected);
    }

    #[test]
    fn test_normalize_page_wrapped_in_array() {
        let normalized = Query::normalize(vec![
            Value::String(Query::equal("status", "active").to_string()),
            Value::Array(
                Query::page(2, 10)
                    .into_iter()
                    .map(|query| Value::String(query.to_string()))
                    .collect(),
            ),
        ]);
        assert_eq!(
            normalized,
            vec![
                Query::equal("status", "active").to_string(),
                Query::limit(10).to_string(),
                Query::offset(10).to_string(),
            ]
        );
    }
