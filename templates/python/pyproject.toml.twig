[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ language.params.pipPackage }}"
version = "{{ sdk.version }}"
description = "{{ sdk.shortDescription }}"
readme = "README.md"
requires-python = ">=3.9"
license = { text = "{{ spec.info.license.name }}" }
authors = [
  { name = "{{ spec.info.contact.name }}", email = "{{ spec.info.contact.email }}" }
]
maintainers = [
  { name = "{{ spec.info.contact.name }}", email = "{{ spec.info.contact.email }}" }
]
dependencies = [
  "requests",
  "pydantic>=2,<3",
]
classifiers = [
  "Development Status :: 5 - Production/Stable",
  "Intended Audience :: Developers",
  "Environment :: Web Environment",
  "Topic :: Software Development",
  "License :: OSI Approved :: {{ sdk.license }}",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3.9",
  "Programming Language :: Python :: 3.10",
  "Programming Language :: Python :: 3.11",
  "Programming Language :: Python :: 3.12",
]

[project.optional-dependencies]
test = [
  "black==25.11.0",
  "requests_mock==1.11.0",
]

[project.urls]
Homepage = "{{ spec.info.contact.url }}"
Repository = "https://github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName }}"

[tool.black]
line-length = 120
skip-string-normalization = true
target-version = ['py39']

[tool.setuptools.packages.find]
include = ["{{ namespace | caseSnake }}*"]
