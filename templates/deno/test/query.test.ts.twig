import {describe, it as test} from "https://deno.land/std@0.149.0/testing/bdd.ts";
import {assertEquals} from "https://deno.land/std@0.204.0/assert/assert_equals.ts";
import {Query, QueryTypes, flattenParam, normalizeQueries} from "../src/query.ts";

type BasicFilterQueryTest = {
    description: string;
    value: QueryTypes;
    expectedValues: string;
}

const tests: BasicFilterQueryTest[] = [
    {
        description: 'with a string',
        value: 's',
        expectedValues: '["s"]'
    },
    {
        description: 'with a integer',
        value: 1,
        expectedValues: '[1]'
    },
    {
        description: 'with a double',
        value: 1.2,
        expectedValues: '[1.2]'
    },
    {
        description: 'with a whole number double',
        value: 1.0,
        expectedValues: '[1]'
    },
    {
        description: 'with a bool',
        value: false,
        expectedValues: '[false]'
    },
    {
        description: 'with a list',
        value: ['a', 'b', 'c'],
        expectedValues: '["a","b","c"]'
    }
];

describe('Query', () => {
    describe('basic filter equal', () => {
        for (const t of tests) {
            test(t.description, () =>
                assertEquals(
                    Query.equal("attr", t.value).toString(),
                    `{"method":"equal","attribute":"attr","values":${t.expectedValues}}`,
                )
            )
        }
    })

    describe('basic filter notEqual', () => {
        for (const t of tests) {
            test(t.description, () =>
                assertEquals(
                    Query.notEqual("attr", t.value).toString(),
                    `{"method":"notEqual","attribute":"attr","values":${t.expectedValues}}`,
                )
            )
        }
    });

    describe('basic filter lessThan', () => {
        for (const t of tests) {
            test(t.description, () =>
                assertEquals(
                    Query.lessThan("attr", t.value).toString(),
                    `{"method":"lessThan","attribute":"attr","values":${t.expectedValues}}`,
                )
            )
        }
    });

    describe('basic filter lessThanEqual', () => {
        for (const t of tests) {
            test(t.description, () =>
                assertEquals(
                    Query.lessThanEqual("attr", t.value).toString(),
                    `{"method":"lessThanEqual","attribute":"attr","values":${t.expectedValues}}`,
                )
            )
        }
    });

    describe('basic filter greaterThan', () => {
        for (const t of tests) {
            test(t.description, () =>
                assertEquals(
                    Query.greaterThan("attr", t.value).toString(),
                    `{"method":"greaterThan","attribute":"attr","values":${t.expectedValues}}`,
                )
            )
        }
    });

    describe('basic filter greaterThanEqual', () => {
        for (const t of tests) {
            test(t.description, () =>
                assertEquals(
                    Query.greaterThanEqual("attr", t.value).toString(),
                    `{"method":"greaterThanEqual","attribute":"attr","values":${t.expectedValues}}`,
                )
            )
        }
    });

    test('search', () => assertEquals(
        Query.search('attr', 'keyword1 keyword2').toString(),
        '{"method":"search","attribute":"attr","values":["keyword1 keyword2"]}',
    ));

    test('isNull', () => assertEquals(
        Query.isNull('attr').toString(),
        `{"method":"isNull","attribute":"attr","values":[]}`,
    ));

    test('isNotNull', () => assertEquals(
        Query.isNotNull('attr').toString(),
        `{"method":"isNotNull","attribute":"attr","values":[]}`,
    ));

    describe('between', () => {
        test('with integers', () => assertEquals(
            Query.between('attr', 1, 2).toString(),
            `{"method":"between","attribute":"attr","values":[1,2]}`,
        ));
        test('with doubles', () => assertEquals(
            Query.between('attr', 1.2, 2.2).toString(),
            `{"method":"between","attribute":"attr","values":[1.2,2.2]}`,
        ));
        test('with strings', () => assertEquals(
            Query.between('attr', "a", "z").toString(),
            `{"method":"between","attribute":"attr","values":["a","z"]}`,
        ));
    });

    test('select', () => assertEquals(
        Query.select(['attr1', 'attr2']).toString(),
        `{"method":"select","attribute":["attr1","attr2"]}`,
    ));

    test('orderAsc', () => assertEquals(
        Query.orderAsc('attr').toString(),
        `{"method":"orderAsc","attribute":"attr"}`,
    ));

    test('orderDesc', () => assertEquals(
        Query.orderDesc('attr').toString(),
        `{"method":"orderDesc","attribute":"attr"}`,
    ));

    test('orderRandom', () => assertEquals(
        Query.orderRandom().toString(),
        `{"method":"orderRandom"}`,
    ));

    test('cursorBefore', () => assertEquals(
        Query.cursorBefore('attr').toString(),
        `{"method":"cursorBefore","attribute":"attr"}`,
    ));

    test('cursorAfter', () => assertEquals(
        Query.cursorAfter('attr').toString(),
        `{"method":"cursorAfter","attribute":"attr"}`,
    ));

    test('limit', () => assertEquals(
        Query.limit(1).toString(),
        `{"method":"limit","values":[1]}`,
    ));

    test('offset', () => assertEquals(
        Query.offset(1).toString(),
        `{"method":"offset","values":[1]}`,
    ));

    test('notContains', () => assertEquals(
        Query.notContains('attr', 'value').toString(),
        `{"method":"notContains","attribute":"attr","values":["value"]}`,
    ));

    test('notSearch', () => assertEquals(
        Query.notSearch('attr', 'keyword1 keyword2').toString(),
        '{"method":"notSearch","attribute":"attr","values":["keyword1 keyword2"]}',
    ));

    describe('notBetween', () => {
        test('with integers', () => assertEquals(
            Query.notBetween('attr', 1, 2).toString(),
            `{"method":"notBetween","attribute":"attr","values":[1,2]}`,
        ));
        test('with doubles', () => assertEquals(
            Query.notBetween('attr', 1.2, 2.2).toString(),
            `{"method":"notBetween","attribute":"attr","values":[1.2,2.2]}`,
        ));
        test('with strings', () => assertEquals(
            Query.notBetween('attr', "a", "z").toString(),
            `{"method":"notBetween","attribute":"attr","values":["a","z"]}`,
        ));
    });

    test('notStartsWith', () => assertEquals(
        Query.notStartsWith('attr', 'prefix').toString(),
        `{"method":"notStartsWith","attribute":"attr","values":["prefix"]}`,
    ));

    test('notEndsWith', () => assertEquals(
        Query.notEndsWith('attr', 'suffix').toString(),
        `{"method":"notEndsWith","attribute":"attr","values":["suffix"]}`,
    ));

    test('regex', () => assertEquals(
        Query.regex('attr', 'pattern.*').toString(),
        `{"method":"regex","attribute":"attr","values":["pattern.*"]}`,
    ));

    test('exists', () => assertEquals(
        Query.exists(['attr1', 'attr2']).toString(),
        `{"method":"exists","values":["attr1","attr2"]}`,
    ));

    test('notExists', () => assertEquals(
        Query.notExists(['attr1', 'attr2']).toString(),
        `{"method":"notExists","values":["attr1","attr2"]}`,
    ));

    test('elemMatch', () => {
        const inner1 = Query.equal('name', 'Alice');
        const inner2 = Query.greaterThan('age', 18);
        const result = Query.elemMatch('friends', [inner1, inner2]);
        const parsed = JSON.parse(result);
        
        assertEquals(parsed.method, 'elemMatch');
        assertEquals(parsed.attribute, 'friends');
        assertEquals(parsed.values.length, 2);
        assertEquals(parsed.values[0].method, 'equal');
        assertEquals(parsed.values[0].attribute, 'name');
        assertEquals(parsed.values[0].values, ['Alice']);
        assertEquals(parsed.values[1].method, 'greaterThan');
        assertEquals(parsed.values[1].attribute, 'age');
        assertEquals(parsed.values[1].values, [18]);
    });

    test('createdBefore', () => assertEquals(
        Query.createdBefore('2023-01-01').toString(),
        `{"method":"lessThan","attribute":"$createdAt","values":["2023-01-01"]}`,
    ));

    test('createdAfter', () => assertEquals(
        Query.createdAfter('2023-01-01').toString(),
        `{"method":"greaterThan","attribute":"$createdAt","values":["2023-01-01"]}`,
    ));

    test('createdBetween', () => assertEquals(
        Query.createdBetween('2023-01-01', '2023-12-31').toString(),
        `{"method":"between","attribute":"$createdAt","values":["2023-01-01","2023-12-31"]}`,
    ));

    test('updatedBefore', () => assertEquals(
        Query.updatedBefore('2023-01-01').toString(),
        `{"method":"lessThan","attribute":"$updatedAt","values":["2023-01-01"]}`,
    ));

    test('updatedAfter', () => assertEquals(
        Query.updatedAfter('2023-01-01').toString(),
        `{"method":"greaterThan","attribute":"$updatedAt","values":["2023-01-01"]}`,
    ));

    test('updatedBetween', () => assertEquals(
        Query.updatedBetween('2023-01-01', '2023-12-31').toString(),
        `{"method":"between","attribute":"$updatedAt","values":["2023-01-01","2023-12-31"]}`,
    ));

    test('count with alias', () => assertEquals(
        Query.count('*', 'total').toString(),
        '{"method":"count","attribute":"*","values":["total"]}',
    ));

    test('count without alias', () => assertEquals(
        Query.count().toString(),
        '{"method":"count","attribute":"*"}',
    ));

    test('countDistinct', () => assertEquals(
        Query.countDistinct('year', 'uniqueYears').toString(),
        '{"method":"countDistinct","attribute":"year","values":["uniqueYears"]}',
    ));

    test('sum', () => assertEquals(
        Query.sum('price', 'total').toString(),
        '{"method":"sum","attribute":"price","values":["total"]}',
    ));

    test('avg', () => assertEquals(
        Query.avg('price', 'avgPrice').toString(),
        '{"method":"avg","attribute":"price","values":["avgPrice"]}',
    ));

    test('min', () => assertEquals(
        Query.min('price', 'lowest').toString(),
        '{"method":"min","attribute":"price","values":["lowest"]}',
    ));

    test('max', () => assertEquals(
        Query.max('price', 'highest').toString(),
        '{"method":"max","attribute":"price","values":["highest"]}',
    ));

    test('stddev', () => assertEquals(
        Query.stddev('price', 'sd').toString(),
        '{"method":"stddev","attribute":"price","values":["sd"]}',
    ));

    test('stddevPop', () => assertEquals(
        Query.stddevPop('price', 'sdp').toString(),
        '{"method":"stddevPop","attribute":"price","values":["sdp"]}',
    ));

    test('stddevSamp', () => assertEquals(
        Query.stddevSamp('price', 'sds').toString(),
        '{"method":"stddevSamp","attribute":"price","values":["sds"]}',
    ));

    test('variance', () => assertEquals(
        Query.variance('price', 'var').toString(),
        '{"method":"variance","attribute":"price","values":["var"]}',
    ));

    test('varPop', () => assertEquals(
        Query.varPop('price', 'vp').toString(),
        '{"method":"varPop","attribute":"price","values":["vp"]}',
    ));

    test('varSamp', () => assertEquals(
        Query.varSamp('price', 'vs').toString(),
        '{"method":"varSamp","attribute":"price","values":["vs"]}',
    ));

    test('bitAnd', () => assertEquals(
        Query.bitAnd('flags', 'band').toString(),
        '{"method":"bitAnd","attribute":"flags","values":["band"]}',
    ));

    test('bitOr', () => assertEquals(
        Query.bitOr('flags', 'bor').toString(),
        '{"method":"bitOr","attribute":"flags","values":["bor"]}',
    ));

    test('bitXor', () => assertEquals(
        Query.bitXor('flags', 'bxor').toString(),
        '{"method":"bitXor","attribute":"flags","values":["bxor"]}',
    ));

    test('groupBy', () => assertEquals(
        Query.groupBy(['status', 'year']).toString(),
        '{"method":"groupBy","values":["status","year"]}',
    ));

    test('having nests parsed queries', () => {
        const having = JSON.parse(Query.having([Query.greaterThan('total', 1)]));
        assertEquals(having.method, 'having');
        assertEquals(having.values[0].method, 'greaterThan');
        assertEquals(having.values[0].attribute, 'total');
        assertEquals(having.values[0].values, [1]);
    });

    test('distinct', () => assertEquals(
        Query.distinct().toString(),
        '{"method":"distinct"}',
    ));

    test('join', () => assertEquals(
        Query.join('orders', '$id', 'customerId').toString(),
        '{"method":"join","attribute":"orders","values":["$id","=","customerId"]}',
    ));

    test('leftJoin with alias', () => assertEquals(
        Query.leftJoin('orders', '$id', 'customerId', '=', 'ord').toString(),
        '{"method":"leftJoin","attribute":"orders","values":["$id","=","customerId","ord"]}',
    ));

    test('rightJoin', () => assertEquals(
        Query.rightJoin('orders', '$id', 'customerId').toString(),
        '{"method":"rightJoin","attribute":"orders","values":["$id","=","customerId"]}',
    ));

    test('fullOuterJoin', () => assertEquals(
        Query.fullOuterJoin('orders', '$id', 'customerId').toString(),
        '{"method":"fullOuterJoin","attribute":"orders","values":["$id","=","customerId"]}',
    ));

    test('on', () => assertEquals(
        Query.on('$id', 'customerId').toString(),
        '{"method":"on","values":["$id","=","customerId"]}',
    ));

    test('nested leftJoin', () => {
        const query = JSON.parse(Query.leftJoin('orders', 'ord', [
            Query.on('$id', 'customerId'),
            Query.equal('ord.status', 'paid'),
        ]).toString());
        assertEquals(query.method, 'leftJoin');
        assertEquals(query.attribute, 'orders');
        assertEquals(query.values[0], 'ord');
        assertEquals(query.values[1].method, 'on');
        assertEquals(query.values[2].method, 'equal');
    });

    test('crossJoin', () => assertEquals(
        Query.crossJoin('orders', 'ord').toString(),
        '{"method":"crossJoin","attribute":"orders","values":["ord"]}',
    ));

    test('vectorDot', () => assertEquals(
        Query.vectorDot('embedding', [0.1, 0.2]).toString(),
        '{"method":"vectorDot","attribute":"embedding","values":[[0.1,0.2]]}',
    ));

    test('notCovers', () => assertEquals(
        Query.notCovers('location', [1, 2]).toString(),
        '{"method":"notCovers","attribute":"location","values":[[1,2]]}',
    ));

    test('spatialEquals', () => assertEquals(
        Query.spatialEquals('location', [1, 2]).toString(),
        '{"method":"spatialEquals","attribute":"location","values":[[1,2]]}',
    ));

    test('notSpatialEquals', () => assertEquals(
        Query.notSpatialEquals('location', [1, 2]).toString(),
        '{"method":"notSpatialEquals","attribute":"location","values":[[1,2]]}',
    ));

    test('page', () => {
        const queries = Query.page(2, 10);
        assertEquals(queries, [
            '{"method":"limit","values":[10]}',
            '{"method":"offset","values":[10]}',
        ]);
    });

    test('builder build', () => {
        const built = Query.builder()
            .equal('status', 'published')
            .leftJoin('orders', '$id', 'customerId', '=', 'ord')
            .count('*', 'total')
            .groupBy(['status'])
            .limit(25)
            .build();

        assertEquals(built, [
            Query.equal('status', 'published'),
            Query.leftJoin('orders', '$id', 'customerId', '=', 'ord'),
            Query.count('*', 'total'),
            Query.groupBy(['status']),
            Query.limit(25),
        ]);
    });

    test('normalize builder wrapped in array', () => {
        const builder = Query.builder().equal('status', 'active').limit(10);
        assertEquals(normalizeQueries([builder]), builder.build());
        assertEquals(normalizeQueries([builder.build()]), builder.build());
        assertEquals(normalizeQueries(builder), builder.build());
    });

    test('normalize page wrapped in array', () => {
        assertEquals(normalizeQueries([Query.equal('status', 'active'), Query.page(2, 10)]), [
            Query.equal('status', 'active'),
            Query.limit(10),
            Query.offset(10),
        ]);
    });

    test('flattenParam spreads wrapped builder', () => {
        assertEquals(flattenParam([Query.builder().limit(1)]), [Query.limit(1)]);
    });

    test('flattenParam keeps nested numeric arrays', () => {
        const geometry = [[1, 2], [3, 4]];
        assertEquals(flattenParam(geometry), geometry);
    });

    test('flattenParam keeps query string list', () => {
        assertEquals(flattenParam([Query.limit(1)]), [Query.limit(1)]);
    });
})
