{% set modelNames = [] %}
{% for definitionName, definition in definitions %}
{% set modelNames = modelNames | merge([definitionName | caseUcfirst]) %}
{% endfor %}
{% for requestModelName, requestModel in requestModels %}
{% set modelNames = modelNames | merge([requestModelName | caseUcfirst]) %}
{% endfor %}
{% set importedEnums = [] %}
{% for modelEnum in responseEnums | merge(requestModels is empty ? [] : requestModelEnums) %}
{# A model of the same name shadows the enum inside the namespace, which
   would leave this import unused. #}
{% if (modelEnum.title | caseUcfirst) not in modelNames and (modelEnum.title | caseUcfirst) not in importedEnums %}
import { {{ modelEnum.title | caseUcfirst }} } from './enums/{{ modelEnum.title | caseKebab }}';
{% set importedEnums = importedEnums | merge([modelEnum.title | caseUcfirst]) %}
{% endif %}
{% endfor %}
{% set usesDefault = false %}
{% for definition in definitions | merge(requestModels) %}
{% if definition.additionalProperties %}{% set usesDefault = true %}{% endif %}
{% endfor %}

/**
 * {{spec.info.title | caseUcfirst}} Models
 */
export namespace Models {
{% if usesDefault %}
    declare const __default: unique symbol;
{% endif %}
{% for definitionName, definition in definitions %}
{% if usesDefault or not loop.first %}

{% endif %}
    /**
     * {{ definition.description | trimLines }}
     */
{% if definition.properties is empty %}
    {{ (definitionName | caseUcfirst) | tsTypeAlias((definitionName | getGenerics(spec, true)), '{};', 4) | raw }}
{% else %}
    {{ (definitionName | caseUcfirst) | tsTypeAlias((definitionName | getGenerics(spec, true)), '{', 4) | raw }}
{% for property in definition.properties %}
        /**
         *{% if (property.description | trimLines) is not empty %} {{ property.description | trimLines | raw }}{% endif %}

         */
        {{ ((property | schemaName) | removeDash ~ ((property | schemaRequired) ? '' : '?')) | tsModelProperty((property | getSubSchema(spec, definitionName)), 8) | raw }}
{% endfor %}
    };
{% endif %}
{% if definition.additionalProperties %}

    export type Default{{ definitionName | caseUcfirst }}{{ definitionName | getGenerics(spec, true) | raw }} = {{ definitionName | caseUcfirst }}{{ definitionName | getGenerics(spec, true) | raw }} & {
        [key: string]: any;
        [__default]: true;
    };
{% endif %}
{% endfor %}
{% for requestModelName, requestModel in requestModels %}
{% if usesDefault or definitions is not empty or not loop.first %}

{% endif %}
    /**
     * {{ requestModel.description | trimLines }}
     */
    {{ (requestModelName | caseUcfirst) | tsTypeAlias((requestModelName | getGenerics(spec, true)), '{', 4) | raw }}
{% for property in requestModel.properties %}
        /**
         *{% if (property.description | trimLines) is not empty %} {{ property.description | trimLines | raw }}{% endif %}

         */
        {{ ((property | schemaName) | removeDash ~ ((property | schemaRequired) ? '' : '?')) | tsModelProperty((property | getSubSchema(spec, requestModelName)), 8) | raw }}
{% endfor %}
    };
{% if requestModel.additionalProperties %}

    export type Default{{ requestModelName | caseUcfirst }}{{ requestModelName | getGenerics(spec, true) | raw }} = {{ requestModelName | caseUcfirst }}{{ requestModelName | getGenerics(spec, true) | raw }} & {
        [key: string]: any;
        [__default]: true;
    };
{% endif %}
{% endfor %}
}
