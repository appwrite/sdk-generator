func (srv *{{ service.name | caseUcfirst }}) {{ (method | methodName) | caseUcfirst }}URL({{ params }}) (*string, error) {
{% if (method | parameters('path'))|length > 0 %}
	r := strings.NewReplacer({% for parameter in (method | parameters('path')) %}"{{ '{' }}{{ parameter.name }}{{ '}' }}", client.EncodePath({% if (parameter.extensions['x-sdk-source']|default('')) == 'security' %}srv.client.Config["{{ parameter.extensions['x-sdk-config'] | caseLower }}"]{% else %}{{ parameter.name | caseUcfirst }}{% endif %}){% if not loop.last %}, {% endif %}{% endfor %})
	path := r.Replace("{{ method.path }}")
{% else %}
	path := "{{ method.path }}"
{% endif %}
{% if (method | parameters('query'))|filter(v => not v.required)|length > 0 %}
	options := {{((method | methodName) ~ "Options") | caseUcfirst}}{}.New()
	for _, opt := range optionalSetters {
		opt(options)
	}
{% endif %}
	u, err := url.Parse(srv.client.Endpoint + path)
	if err != nil {
		return nil, err
	}
	q := u.Query()
{% for parameter in (method | parameters('query'))|filter(v => v.required) %}
	client.AddQueryParam(q, "{{ parameter.name }}", {{ parameter.name | caseUcfirst }})
{% endfor %}
{% for parameter in (method | parameters('query'))|filter(v => not v.required) %}
	if options.enabledSetters["{{ parameter.name | caseUcfirst }}"] {
		client.AddQueryParam(q, "{{ parameter.name }}", options.{{ parameter.name | caseUcfirst }})
	}
{% endfor %}
	u.RawQuery = q.Encode()
	result := u.String()
	return &result, nil
}
