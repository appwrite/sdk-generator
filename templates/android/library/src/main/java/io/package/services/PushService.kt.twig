package {{ sdk.namespace | caseDot }}.services

import android.app.Service
import android.content.Intent
import android.content.pm.ServiceInfo
import android.os.Build
import android.os.IBinder
import androidx.core.app.NotificationCompat
import androidx.core.app.NotificationManagerCompat
import androidx.core.app.ServiceCompat
import com.hivemq.client.mqtt.datatypes.MqttQos
import com.hivemq.client.mqtt.mqtt5.Mqtt5AsyncClient

/**
 * Foreground service that keeps the {{ spec.info.title | caseUcfirst }} push (MQTT) connection alive while the
 * app is backgrounded or swiped away (the process stays alive). It owns its own MQTT
 * client, subscribes to the topics configured through [Push.setBackground] +
 * `subscribe`, invokes any in-process listeners, and posts a local notification per
 * message. Started by PushForeground; not meant to be started directly. A hard process
 * kill is not recovered (see the START_NOT_STICKY note in onStartCommand).
 */
class PushService : Service() {
    private var mqtt: Mqtt5AsyncClient? = null

    override fun onBind(intent: Intent?): IBinder? = null

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        startForegroundCompat()
        connectAndSubscribe()
        // NOT sticky: the credential/topics/listeners live only in the process, so a
        // kill-and-recreate could not restore the connection anyway. This covers
        // backgrounding and swipe-away (process alive), not a hard process kill.
        return START_NOT_STICKY
    }

    private fun startForegroundCompat() {
        val notification = NotificationCompat.Builder(this, PushForeground.CHANNEL_ID)
            .setContentTitle(PushForeground.ongoingTitle)
            .setContentText("Listening for messages")
            .setSmallIcon(android.R.drawable.stat_notify_sync)
            .setOngoing(true)
            .build()

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            ServiceCompat.startForeground(
                this,
                PushForeground.NOTIFICATION_ID,
                notification,
                ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC,
            )
        } else {
            startForeground(PushForeground.NOTIFICATION_ID, notification)
        }
    }

    private fun connectAndSubscribe() {
        if (mqtt != null) {
            return
        }
        val config = PushForeground.config ?: return

        val client = buildPushClient(config)
        mqtt = client
        try {
            client.pushConnect(config)
            // Install the live subscribe/unsubscribe hooks and get the current topic union
            // atomically, so a topic added or removed concurrently is neither lost nor left
            // active.
            val initial = PushForeground.attach(
                { topics -> subscribeTopics(topics) },
                { topics -> unsubscribeTopics(topics) },
            )
            subscribeTopics(initial)
        } catch (e: Exception) {
            // Connection failed; the service stays up until stopped.
        }
    }

    private fun subscribeTopics(topics: List<String>) {
        val client = mqtt ?: return
        val qos = if (PushForeground.config?.replay != false) {
            MqttQos.AT_LEAST_ONCE
        } else {
            MqttQos.AT_MOST_ONCE
        }
        for (topic in topics) {
            client.subscribeWith()
                .topicFilter(topic)
                .qos(qos)
                .callback { publish -> onMessage(publish.toPushMessage()) }
                .send()
        }
    }

    private fun unsubscribeTopics(topics: List<String>) {
        val client = mqtt ?: return
        for (topic in topics) {
            client.unsubscribeWith()
                .topicFilter(topic)
                .send()
        }
    }

    private fun onMessage(message: PushMessage) {
        // Fan out to each listener whose own topics match; only notify when one did, so a
        // message that arrives for a just-removed topic (unsubscribe still in flight)
        // produces no unwanted notification.
        if (PushForeground.dispatch(message)) {
            postNotification(message)
        }
    }

    private fun postNotification(message: PushMessage) {
        val manager = NotificationManagerCompat.from(this)
        if (!manager.areNotificationsEnabled()) {
            return
        }
        val notification = NotificationCompat.Builder(this, PushForeground.CHANNEL_ID)
            .setContentTitle(message.topic)
            .setContentText(message.string)
            .setSmallIcon(android.R.drawable.stat_notify_chat)
            .setAutoCancel(true)
            .build()
        try {
            manager.notify(message.hashCode(), notification)
        } catch (e: SecurityException) {
            // POST_NOTIFICATIONS not granted; nothing to show.
        }
    }

    override fun onDestroy() {
        PushForeground.detach()
        mqtt?.disconnect()
        mqtt = null
        super.onDestroy()
    }
}
