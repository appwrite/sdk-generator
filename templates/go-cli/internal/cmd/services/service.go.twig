package services

{% set scope = service | cliServiceScope %}
{% set hasQueryParam = service | hasCliQueryParam %}
import (
{% if sdk.test %}
{% if hasQueryParam %}
	"encoding/json"

{% endif %}
	"github.com/spf13/cobra"

	"github.com/appwrite/appwrite-cli-go/internal/app"
{% if hasQueryParam %}
	"github.com/appwrite/appwrite-cli-go/internal/query"
{% endif %}
{% else %}
	"github.com/spf13/cobra"

	"{{ language.params.sdkImportPath }}/{{ service.name | goPackage }}"

	"github.com/appwrite/appwrite-cli-go/internal/app"
{% if hasQueryParam %}
	"github.com/appwrite/appwrite-cli-go/internal/query"
{% endif %}
{% endif %}
)

{% if sdk.test %}
{{ include('go-cli/base/mock.go.twig') }}
{% endif %}

// New{{ service.name | caseUcfirst }}Command builds the `{{ service.name | caseLower }}` command tree.
func New{{ service.name | caseUcfirst }}Command() *cobra.Command {
	cmd := &cobra.Command{
		Use:   "{{ service.name | caseLower }}",
{% if service.name == 'tablesDB' %}
		Aliases: []string{"tables-db"},
{% endif %}
		Short: {{ service.description | default('') | stripMarkdown | goString | raw }},
	}

{% set seenCommands = [] %}
{% for method in service.methods %}
{% set commandName = method.name | caseKebab %}
{% if commandName not in seenCommands %}
{% set seenCommands = seenCommands|merge([commandName]) %}
{% for target in method | cliCommandTargets(service) %}
{% if not target.standalone %}
	cmd.AddCommand(new{{ service.name | caseUcfirst }}{{ method.name | caseUcfirst }}Command())
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

	return cmd
}

{% set rootAliases = service | cliTopLevelAliases %}
{% if rootAliases is not empty %}
// New{{ service.name | caseUcfirst }}RootCommands returns the methods promoted to
// top-level commands. The service subcommand stays registered but hidden, so
// both spellings keep working.
func New{{ service.name | caseUcfirst }}RootCommands() []*cobra.Command {
	commands := []*cobra.Command{
{% for alias in rootAliases %}
		new{{ service.name | caseUcfirst }}{{ alias.method | caseUcfirst }}Command(),
{% endfor %}
	}

	// The same constructor builds both spellings, and it marks the command
	// hidden so it does not appear twice under its service. The promoted copy is
	// the one --help is meant to advertise, so it is made visible here.
	for _, command := range commands {
		command.Hidden = false
	}

	return commands
}

{% endif %}
{% set seenCommands = [] %}
{% for method in service.methods %}
{% set commandName = method.name | caseKebab %}
{% if commandName not in seenCommands %}
{% set seenCommands = seenCommands|merge([commandName]) %}
{% set query = method | cliQueryConfig %}
{% set hasScopedIdParam = false %}
{% for parameter in method.parameters.all %}
{% if scope and parameter.name == scope.idVar %}
{% set hasScopedIdParam = true %}
{% endif %}
{% endfor %}
{% set scopedFlag = scope and not hasScopedIdParam %}
{% set isTopLevel = false %}
{# `implementation` names a console-fallback helper this method routes through
   instead of the SDK. Captured here rather than read inside RunE, where the
   target loop variable is out of scope -- a branch on it there silently never
   fires and still compiles. #}
{% set implementation = null %}
{% for target in method | cliCommandTargets(service) %}
{% if target.standalone %}
{% set isTopLevel = true %}
{% endif %}
{% if target.implementation %}
{% set implementation = target.implementation %}
{% endif %}
{% endfor %}
func new{{ service.name | caseUcfirst }}{{ method.name | caseUcfirst }}Command() *cobra.Command {
{% for parameter in method.parameters.all %}
{% set opt = getGoCliOption(parameter) %}
	var {{ opt.var }} {{ opt.goType }}
{% endfor %}
{% if query.hasQueries %}
{% if query.hasFiltering %}
	var filter []string
	var where []string
	var sortAsc []string
	var sortDesc []string
{% endif %}
{% if query.hasPagination %}
	var limit int
	var offset int
{% endif %}
{% if query.hasCursors %}
	var cursorAfter string
	var cursorBefore string
{% endif %}
{% if query.hasSelect %}
	var selectAttributes []string
{% endif %}
{% endif %}
{% if method.type == 'location' %}
	var destination string
{% endif %}
{% if scopedFlag %}
	var {{ scope.idVar }} string
{% endif %}

	cmd := &cobra.Command{
		Use:   "{{ method.name | caseKebab }}",
		Short: {{ method.description | stripMarkdown | goString | raw }},
{% if isTopLevel %}
		Hidden: true,
{% endif %}
		RunE: func(cmd *cobra.Command, args []string) error {
{% set plan = getGoCallPlan(method, service) %}
{% if sdk.test %}
			service := new{{ service.name | caseUcfirst }}MockService()
{% elseif not implementation %}
{% if scope %}
			client, err := app.ClientFor{{ scope.label }}({{ scopedFlag ? scope.idVar : '""' }})
{% elseif service.isConsoleOnly %}
			client, err := app.ClientForConsole()
{% else %}
			client, err := app.ClientForProject("")
{% endif %}
			if err != nil {
				return err
			}
			service := {{ plan.package }}.New(client)
{% endif %}
{% if not sdk.test %}
{% for decode in plan.decodes %}
			{{ decode.var }}, err := app.{{ decode.helper }}({{ decode.source }})
			if err != nil {
				return err
			}
{% endfor %}
{% endif %}
{% if query.hasQueries %}

{% if query.hasFiltering %}
			parsedFilter, err := query.ParseFilters(filter)
			if err != nil {
				return err
			}
			parsedWhere, err := query.ParseFilters(where)
			if err != nil {
				return err
			}
{% endif %}

			queries, err := query.Build(query.Options{
				Queries: queries,
{% if query.hasFiltering %}
				Filter:   parsedFilter,
				Where:    parsedWhere,
				SortAsc:  sortAsc,
				SortDesc: sortDesc,
{% endif %}
{% if query.hasPagination %}
				Limit:  app.FlagInt(cmd, "limit", limit),
				Offset: app.FlagInt(cmd, "offset", offset),
{% endif %}
{% if query.hasCursors %}
				CursorAfter:  app.FlagString(cmd, "cursor-after", cursorAfter),
				CursorBefore: app.FlagString(cmd, "cursor-before", cursorBefore),
{% endif %}
{% if query.hasSelect %}
				Select: selectAttributes,
{% endif %}
			})
			if err != nil {
				return err
			}
{% endif %}
{% if plan.optional is not empty and not implementation and not sdk.test %}

			// An unset flag must be omitted, not sent as its zero value: the
			// TypeScript passes undefined and the SDK drops it.
			options := []{{ plan.package }}.{{ plan.optionType }}{}
{% for option in plan.optional %}
			if cmd.Flags().Changed("{{ option.flag }}") {
				options = append(options, service.{{ option.setter }}({{ option.expression }}))
			}
{% endfor %}
{% endif %}

{% if implementation == 'listOrganizationsForSession' %}
			result, err := app.ListOrganizationsForSession(
				app.FlagInt(cmd, "limit", limit), app.FlagInt(cmd, "offset", offset), search)
{% elseif implementation == 'listProjectsForSession' %}
			result, err := app.ListProjectsForSession({{ scopedFlag ? scope.idVar : '""' }},
				app.FlagInt(cmd, "limit", limit), app.FlagInt(cmd, "offset", offset), search)
{% elseif implementation == 'getOrganizationForSession' %}
			result, err := app.GetOrganizationForSession({{ scopedFlag ? scope.idVar : '""' }})
{% elseif sdk.test %}
			result, err := service.{{ plan.method }}({% if query.hasQueries %}queries, {% endif %}{% for parameter in method.parameters.all %}{{ getGoVarName(parameter) }}, {% endfor %})
{% else %}
			result, err := service.{{ plan.method }}({% for argument in plan.required %}{{ argument.expression }}, {% endfor %}{% if plan.optional is not empty %}options...{% endif %})
{% endif %}
			if err != nil {
				return err
			}
{% if method.type == 'location' and not sdk.test %}

			// A location method returns the file bytes, not a URL. The
			// TypeScript fetches the URL itself; the SDK has already done that.
			return app.WriteFile(destination, result)
{% else %}

			return app.Render(result)
{% endif %}
		},
	}

{% for parameter in method.parameters.all %}
{% set opt = getGoCliOption(parameter) %}
	cmd.Flags().{{ opt.register }}Var(&{{ opt.var }}, "{{ opt.flag }}", {% if opt.goType == '[]string' %}nil{% elseif opt.goType == 'bool' %}false{% elseif opt.goType == 'int' %}0{% elseif opt.goType == 'float64' %}0{% else %}""{% endif %}, {{ parameter.description | stripMarkdown | goString | raw }})
{% if opt.noOptDefault %}
	cmd.Flags().Lookup("{{ opt.flag }}").NoOptDefVal = "{{ opt.noOptDefault }}"
{% endif %}
{% if opt.required %}
	_ = cmd.MarkFlagRequired("{{ opt.flag }}")
{% endif %}
{% endfor %}
{% if query.hasQueries %}
{% if query.hasFiltering %}
	cmd.Flags().StringArrayVar(&filter, "filter", nil, "Filter using a simple comparison expression. Repeat for multiple filters. Supports field=value, field!=value, field>value, field>=value, field<value, and field<=value.")
	cmd.Flags().StringArrayVar(&where, "where", nil, "Deprecated. Use --filter instead. Filter using a simple comparison expression. Repeat for multiple filters.")
	cmd.Flags().StringArrayVar(&sortAsc, "sort-asc", nil, "Sort results by an attribute in ascending order. Repeat for multiple sort fields.")
	cmd.Flags().StringArrayVar(&sortDesc, "sort-desc", nil, "Sort results by an attribute in descending order. Repeat for multiple sort fields.")
{% endif %}
{% if query.hasPagination %}
	cmd.Flags().IntVar(&limit, "limit", 0, "Maximum number of results to return.")
	cmd.Flags().IntVar(&offset, "offset", 0, "Number of results to skip.")
{% endif %}
{% if query.hasCursors %}
	cmd.Flags().StringVar(&cursorAfter, "cursor-after", "", "Return results after this cursor ID.")
	cmd.Flags().StringVar(&cursorBefore, "cursor-before", "", "Return results before this cursor ID.")
{% endif %}
{% if query.hasSelect %}
	cmd.Flags().StringArrayVar(&selectAttributes, "select", nil, "Attribute to include in the response. Repeat for multiple attributes.")
{% endif %}
{% endif %}
{% if method.type == 'location' %}
	cmd.Flags().StringVar(&destination, "destination", "", "Path to save the file to.")
	_ = cmd.MarkFlagRequired("destination")
{% endif %}
{% if scopedFlag %}
	cmd.Flags().StringVar(&{{ scope.idVar }}, "{{ scope.flag }}", "", "{{ scope.label }} to act on. Defaults to the {{ scope.label | lower }} linked in {{ language.params.executableName }}.config.json.")
{% endif %}

	return cmd
}

{% endif %}
{% endfor %}
