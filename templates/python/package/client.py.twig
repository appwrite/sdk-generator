_ssl_context = None


def _default_ssl_context():
    """Build the TLS context once and reuse it across clients."""
    global _ssl_context
    if _ssl_context is None:
        _ssl_context = httpx2.create_ssl_context()
    return _ssl_context


class Client:
    def __init__(self):
        self._chunk_size = 5 * 1024 * 1024
        self._self_signed = False
        self._endpoint = '{{(spec | endpoint)}}'
        self._global_headers = {
            'content-type': '',
            'user-agent': f'{{spec.info.title | caseUcfirst}}{{ language.name | caseUcfirst }}SDK/{{ sdk.version }} ({platform.uname().system}; {platform.uname().version}; {platform.uname().machine})',
            'x-sdk-name': '{{ sdk.name }}',
            'x-sdk-platform': '{{ sdk.platform }}',
            'x-sdk-language': '{{ language.name | caseLower }}',
            'x-sdk-version': '{{ sdk.version }}',
{% for key,header in defaultHeaders %}
            '{{key}}': '{{header}}',
{% endfor %}
        }
        self._config = {}
        self._http = self._new_http_client(verify=True)
        self._retired_http = []

    def _new_http_client(self, verify):
        context = _default_ssl_context() if verify else False
        return httpx2.AsyncClient(verify=context, timeout=None)

    async def __aenter__(self):
        return self

    async def __aexit__(self, exc_type, exc_value, traceback):
        await self.aclose()

    async def aclose(self):
        """Close the underlying HTTP connection pool."""
        for client in self._retired_http:
            await client.aclose()
        self._retired_http = []
        await self._http.aclose()

    def set_self_signed(self, status=True):
        """Accept self-signed TLS certificates."""
        self._self_signed = status
        previous = self._http
        self._http = self._new_http_client(verify=not status)
        # anyio has no fire-and-forget tasks, so the replaced client is parked here
        # and closed together with the active one once aclose() runs.
        self._retired_http.append(previous)
        return self

    def set_endpoint(self, endpoint):
        if not endpoint.startswith('http://') and not endpoint.startswith('https://'):
            raise {{spec.info.title | caseUcfirst}}Exception('Invalid endpoint URL: ' + endpoint)

        self._endpoint = endpoint
        return self

    def add_header(self, key, value):
        self._global_headers[key.lower()] = value
        return self

    def get_headers(self):
        return dict(self._global_headers)

    def get_config(self, key):
        return self._config.get(key, '')
