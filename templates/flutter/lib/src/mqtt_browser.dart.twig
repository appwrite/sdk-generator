import 'dart:async';
import 'dart:convert';
// ignore: avoid_web_libraries_in_flutter, deprecated_member_use
import 'dart:html' as html;
import 'dart:math';
import 'dart:typed_data';
import 'package:mqtt5_client/mqtt5_client.dart';
import 'package:mqtt5_client/mqtt5_browser_client.dart';
import 'package:typed_data/typed_data.dart' as typed;
import 'client.dart';
import 'exception.dart';
import 'mqtt.dart';
import 'mqtt_message.dart';

Push createPush(
  Client client, {
  String? host,
  int? port,
  bool? tls,
  bool tlsInsecure = false,
  String? clientId,
  int keepAlive = 60,
  bool reliableDelivery = true,
}) =>
    PushWeb(
      client,
      host: host,
      port: port,
      tls: tls,
      clientId: clientId,
      keepAlive: keepAlive,
      reliableDelivery: reliableDelivery,
    );

class _PushSubscription {
  final String filter;
  final PushCallback callback;

  const _PushSubscription(this.filter, this.callback);
}

/// Web push transport. A browser cannot open a raw TCP socket, so the connection is
/// MQTT over WebSocket (`ws://` / `wss://`) via [MqttBrowserClient]; the native
/// (`dart:io`) build in `mqtt_io.dart` uses a TCP socket instead. The API is identical.
class PushWeb implements Push {
  @override
  final Client client;

  final String _host;
  final int _port;
  final bool _tls;
  final String _path;
  final String? _clientId;
  final int _keepAlive;
  final bool _reliableDelivery;

  MqttBrowserClient? _mqtt;
  Future<void>? _connecting;

  // Foreground mode on the web: there is no background execution (a tab cannot hold a
  // socket once closed), so [setForeground] just shows a browser notification per message
  // while the tab is open.
  bool _foreground = false;
  String? _foregroundTitle;

  // Resolved once per instance: a reconnect rebuilds the client, and if each rebuild drew a new
  // random id the broker would treat it as a new session and drop this client's replay cursor.
  // Reusing one id keeps the persistent session stable.
  late final String _resolvedClientId = _clientId ??
      'appwrite-${client.config['project'] ?? ''}-${_randomId().substring(0, 8)}';

  // Local id -> subscription (topic filter + callback). The id is never sent to
  // the broker; it only lets the same topic carry more than one callback.
  final Map<String, _PushSubscription> _subscriptions = {};
  // topic filter -> FIFO queue of completers resolved on each SUBACK. A queue (not a
  // single completer) so two concurrent subscribes to the same topic both resolve.
  final Map<String, List<Completer<void>>> _subAcks = {};

  factory PushWeb(
    Client client, {
    String? host,
    int? port,
    bool? tls,
    String? clientId,
    int keepAlive = 60,
    bool reliableDelivery = true,
  }) {
    // The broker location comes from Client.setPushEndpoint() when set (e.g.
    // "wss://host/mqtt"), otherwise from the regular endpoint.
    final pushEndpoint = client.config['endpointPush'] ?? client.endPoint;
    // Secure by default: WSS on when the endpoint scheme is secure (or port 8883), so the
    // credential in the CONNECT packet is not sent over a plaintext socket.
    final resolvedTls = tls ?? (port == 8883 || _secureScheme(pushEndpoint));
    final resolvedPort =
        port ?? _pushEndpointPort(client) ?? (resolvedTls ? 443 : 80);
    return PushWeb._(
      client,
      host: host ?? _hostOf(pushEndpoint),
      port: resolvedPort,
      tls: resolvedTls,
      path: _pushPath(client),
      clientId: clientId,
      keepAlive: keepAlive,
      reliableDelivery: reliableDelivery,
    );
  }

  PushWeb._(
    this.client, {
    required String host,
    required int port,
    required bool tls,
    required String path,
    required String? clientId,
    required int keepAlive,
    required bool reliableDelivery,
  })  : _host = host,
        _port = port,
        _tls = tls,
        _path = path,
        _clientId = clientId,
        _keepAlive = keepAlive,
        _reliableDelivery = reliableDelivery;

  static bool _secureScheme(String endpoint) {
    try {
      final scheme = Uri.parse(endpoint).scheme;
      return scheme == 'https' ||
          scheme == 'wss' ||
          scheme == 'mqtts' ||
          scheme == 'ssl';
    } catch (_) {
      return false;
    }
  }

  static String _hostOf(String endpoint) {
    try {
      final host = Uri.parse(endpoint).host;
      return host.isEmpty ? 'localhost' : host;
    } catch (_) {
      return 'localhost';
    }
  }

  // Take the port from an explicitly-set push endpoint only (a regular http/https
  // endpoint's port is the API port, not the broker's).
  static int? _pushEndpointPort(Client client) {
    final endpoint = client.config['endpointPush'];
    if (endpoint == null) {
      return null;
    }
    try {
      final port = Uri.parse(endpoint).port;
      return port == 0 ? null : port;
    } catch (_) {
      return null;
    }
  }

  // The WebSocket path from an explicitly-set push endpoint, or "/mqtt" by default
  // (the path the broker exposes MQTT-over-WebSocket on).
  static String _pushPath(Client client) {
    final endpoint = client.config['endpointPush'];
    if (endpoint != null) {
      try {
        final path = Uri.parse(endpoint).path;
        if (path.isNotEmpty && path != '/') {
          return path;
        }
      } catch (_) {}
    }
    return '/mqtt';
  }

  @override
  Push setForeground({String? title}) {
    _foreground = true;
    _foregroundTitle = title;
    if (html.Notification.permission != 'granted') {
      html.Notification.requestPermission();
    }
    return this;
  }

  @override
  Future<PushUnsubscribe> subscribe(
      Object topics, PushCallback callback) async {
    final topicList =
        topics is String ? <String>[topics] : List<String>.from(topics as List);

    final mqtt = await _connect();

    final ids = <String>[];
    final acks = <Future<void>>[];
    for (final topic in topicList) {
      final id = _randomId();
      ids.add(id);
      _subscriptions[id] = _PushSubscription(topic, callback);

      final completer = Completer<void>();
      (_subAcks[topic] ??= <Completer<void>>[]).add(completer);
      acks.add(completer.future);

      final subscription = MqttSubscription.withMaximumQos(
        MqttSubscriptionTopic(topic),
        _defaultQos,
      );
      mqtt.subscribeWithSubscriptionList([subscription]);
    }

    void unsubscribe() {
      for (final id in ids) {
        final entry = _subscriptions.remove(id);
        // Only unsubscribe the broker filter once its last local callback is gone.
        final stillUsed =
            _subscriptions.values.any((s) => s.filter == entry?.filter);
        if (entry != null && !stillUsed) {
          _mqtt?.unsubscribeStringTopic(entry.filter);
        }
      }
      if (_subscriptions.isEmpty) {
        close();
      }
    }

    // The broker only starts routing a topic once its subscription is registered,
    // so publishing before the SUBACK races the message ahead of the subscription
    // and it is dropped (no retained replay on MQTT). Awaiting makes it reliable.
    // If any topic's SUBACK fails, roll this call's registrations back (and drop any
    // now-unused broker filter) so a failed subscribe leaks no callback, then rethrow.
    try {
      await Future.wait(acks);
    } catch (_) {
      unsubscribe();
      rethrow;
    }

    return unsubscribe;
  }

  // QoS for subscribe, chosen once by [reliableDelivery]: at-least-once (1) when
  // reliable, at-most-once (0) when not.
  MqttQos get _defaultQos =>
      _reliableDelivery ? MqttQos.atLeastOnce : MqttQos.atMostOnce;

  @override
  void close() {
    _mqtt?.disconnect();
    _mqtt = null;
    _connecting = null;
  }

  Future<MqttBrowserClient> _connect() {
    final mqtt = _mqtt;
    if (mqtt != null &&
        mqtt.connectionStatus?.state == MqttConnectionState.connected) {
      return Future.value(mqtt);
    }
    var connecting = _connecting;
    if (connecting == null) {
      connecting = _open();
      _connecting = connecting;
      // A failed open must not poison future attempts — clear the cached in-flight
      // future so a later subscribe/publish can retry.
      unawaited(connecting.catchError((Object _) {
        _connecting = null;
      }));
    }
    return connecting.then((_) => _mqtt!);
  }

  Future<void> _open() async {
    // Read the credential set on the client (via Client.setJWT / setSession).
    final jwt = client.config['jwt'] ?? client.config['jWT'];
    final session = client.config['session'];
    final String authMethod;
    final String credential;
    if (jwt != null && jwt.isNotEmpty) {
      authMethod = 'appwrite-jwt';
      credential = jwt;
    } else if (session != null && session.isNotEmpty) {
      authMethod = 'appwrite-session';
      credential = session;
    } else {
      throw {{spec.info.title | caseUcfirst}}Exception(
          'No credential set on the client; call Client.setJWT() or Client.setSession() first.');
    }

    final project = client.config['project'] ?? '';
    // A non-empty client id is required for a persistent session (clean start off) — some
    // MQTT clients/brokers reject a zero-length id in that mode. The broker keys its
    // offline-replay cursor on this id, resolved once per instance (see [_resolvedClientId])
    // so a reconnect rebuild reuses it and resumes the same session.
    final clientId = _resolvedClientId;

    final scheme = _tls ? 'wss' : 'ws';
    final mqtt =
        MqttBrowserClient.withPort('$scheme://$_host$_path', clientId, _port);
    mqtt.keepAlivePeriod = _keepAlive;
    // The broker negotiates the "mqtt" WebSocket subprotocol; offer exactly that so the
    // handshake succeeds (a browser rejects the socket when the subprotocol is not echoed).
    mqtt.websocketProtocols = MqttConstants.protocolsSingleDefault;
    // Re-register every subscription automatically after a dropped connection.
    mqtt.autoReconnect = true;
    mqtt.resubscribeOnAutoReconnect = true;
    mqtt.onSubscribed = _onSubscribed;
    mqtt.onSubscribeFail = _onSubscribeFail;

    // Enhanced auth carried in the CONNECT properties, plus the project id as a
    // user property — exactly like the Python and React Native clients.
    final authData = typed.Uint8Buffer()..addAll(utf8.encode(credential));
    final connectMessage = MqttConnectMessage()
        .withClientIdentifier(clientId)
        .keepAliveFor(_keepAlive)
        .withAuthenticationMethod(authMethod)
        .withAuthenticationData(authData);
    // Clean start is the only session flag the broker reads: false (the default) keeps
    // the offline-replay cursor so a reconnect resumes where it left off; true purges
    // it. The replay window itself is the broker's concern — we set no session expiry.
    if (!_reliableDelivery) {
      connectMessage.startClean();
    }
    connectMessage.addUserPropertyPair('projectId', project);
    mqtt.connectionMessage = connectMessage;

    _mqtt = mqtt;

    try {
      await mqtt.connect();
    } catch (e) {
      close();
      throw {{spec.info.title | caseUcfirst}}Exception(e.toString());
    }

    final status = mqtt.connectionStatus;
    if (status == null || status.state != MqttConnectionState.connected) {
      close();
      throw {{spec.info.title | caseUcfirst}}Exception(
          'MQTT authentication failed (CONNACK reason ${status?.reasonCode})');
    }

    // Attach the delivery listener only after CONNACK — the `updates` stream is not
    // available until the connection is established.
    mqtt.updates.listen(_onData);
  }

  void _onData(List<MqttReceivedMessage<MqttMessage>> events) {
    for (final received in events) {
      final publish = received.payload;
      if (publish is! MqttPublishMessage) {
        continue;
      }
      final topic = received.topic ?? '';
      final bytes = publish.payload.message;
      final payload =
          bytes == null ? Uint8List(0) : Uint8List.fromList(bytes.toList());
      final message = PushMessage(
        topic: topic,
        payload: payload,
        qos: publish.header?.qos.index ?? 0,
      );
      var matched = false;
      for (final subscription in _subscriptions.values) {
        if (_matches(subscription.filter, topic)) {
          matched = true;
          subscription.callback(message);
        }
      }
      // Show a browser notification per delivered message when foreground mode is on.
      if (matched && _foreground && html.Notification.permission == 'granted') {
        html.Notification(_foregroundTitle ?? topic, body: message.string);
      }
    }
  }

  Completer<void>? _takeSubAck(String? topic) {
    final queue = _subAcks[topic];
    if (queue == null || queue.isEmpty) {
      return null;
    }
    final completer = queue.removeAt(0);
    if (queue.isEmpty) {
      _subAcks.remove(topic);
    }
    return completer;
  }

  void _onSubscribed(MqttSubscription subscription) {
    final completer = _takeSubAck(subscription.topic.rawTopic);
    if (completer != null && !completer.isCompleted) {
      completer.complete();
    }
  }

  void _onSubscribeFail(MqttSubscription subscription) {
    final topic = subscription.topic.rawTopic;
    final completer = _takeSubAck(topic);
    if (completer != null && !completer.isCompleted) {
      completer
          .completeError({{spec.info.title | caseUcfirst}}Exception('Failed to subscribe to $topic'));
    }
  }
}

/// A hex id, uuid4-like enough for a client-generated subId / client id suffix.
String _randomId() {
  final random = Random();
  final buffer = StringBuffer();
  for (var i = 0; i < 32; i++) {
    buffer.write(random.nextInt(16).toRadixString(16));
  }
  return buffer.toString();
}

/// MQTT topic-filter match with '+' (single level) and '#' (multi level).
bool _matches(String filter, String topic) {
  final filterParts = filter.split('/');
  final topicParts = topic.split('/');
  for (var i = 0; i < filterParts.length; i++) {
    final part = filterParts[i];
    if (part == '#') {
      return true;
    }
    if (i >= topicParts.length) {
      return false;
    }
    if (part != '+' && part != topicParts[i]) {
      return false;
    }
  }
  return filterParts.length == topicParts.length;
}
