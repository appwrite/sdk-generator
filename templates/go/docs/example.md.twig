{%- set packagePath = sdk | goPackagePath -%}
{%- set imports = [packagePath ~ '/client', packagePath ~ '/' ~ (service.name | caseLower)] -%}
{%- if requireFilesPkg -%}
{%- set imports = imports | merge([packagePath ~ '/file']) -%}
{%- endif %}
package main

import (
	"fmt"

{% for import in imports | sort %}
	"{{ import }}"
{% endfor %}
)

func main() {
	client := client.New(
{% if [(method | securitySchemes)]|length > 0 %}
		client.WithEndpoint("{{ endpointDocs | raw }}"),
{% for node in [(method | securitySchemes)] %}
{% for key,header in node|keys|filter(h => not node[h].extensions['x-appwrite']['optional']) %}
		client.With{{header}}("{{node[header].extensions['x-appwrite']['demo'] | raw }}"),
{% endfor %}
{% endfor %}
{% endif %}
	)

	service := {{ service.name | caseLower }}.New(client)

	response, err := service.{{ (method | methodName) | caseUcfirst }}(
{% for parameter in (method | parameters('all')) %}
{% if parameter.required %}
		{{ parameter | paramExample }},
{% else %}
		{{ service.name | caseLower }}.With{{ (method | methodName) | caseUcfirst }}{{ parameter.name | caseUcfirst }}({{ parameter | paramExample }}),
{% endif %}
{% endfor %}
	)
	fmt.Println(response, err)
}
