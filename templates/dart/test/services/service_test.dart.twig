{# A request model is typed, so a test builds one from its required properties. #}
{% macro request_model(requestModels, definitions, name, indent) -%}
    {%- set model = requestModels[name] ?? definitions[name] ?? null -%}
    {%- set requiredProperties = model ? model.properties | filter(p => p | schemaRequired) : [] -%}
    models.{{ name | caseUcfirst | overrideIdentifier }}(
    {%- for property in requiredProperties -%}
        {{ "\n" ~ indent }}  {{ (property | schemaName) | escapeKeyword }}: {{ _self.property_value(requestModels, definitions, property, indent ~ '  ') }},
    {%- endfor -%}
    {%- if requiredProperties is not empty %}{{ "\n" ~ indent }}{% endif -%}
    )
{%- endmacro %}
{% macro property_value(requestModels, definitions, property, indent) -%}
    {%- set type = property | schemaType -%}
    {%- if type == 'array' -%}
        []
    {%- elseif property | schemaModel -%}
        {{ _self.request_model(requestModels, definitions, property | schemaModel, indent) }}
    {%- elseif (property | enumValues) is not empty -%}
        enums.{{ (property | enumName) | caseUcfirst }}.{{ ((property | enumKeys)[0] ?? (property | enumValues)[0]) | caseEnumKey }}
    {%- elseif type == 'object' -%}
        <String, dynamic>{}
    {%- elseif type == 'string' -%}
        {{ ((property | schemaExample) | default(property | schemaName)) | dartString }}
    {%- elseif type == 'boolean' -%}
        true
    {%- elseif type == 'number' -%}
        1.0
    {%- else -%}
        1
    {%- endif -%}
{%- endmacro %}
{% macro sub_schema(definitions, property, indent = '          ', closeIndent = '        ') %}{% if (property | schemaModel) %}{% if (property | schemaType) == 'array' %}List<Map<String, dynamic>>{% else %}{% set modelDefinition = definitions[(property | schemaModel)] ?? null %}{% set requiredProperties = modelDefinition ? modelDefinition.properties | filter(p => p | schemaRequired) : [] %}<String, dynamic>{% if requiredProperties|length == 0 %}{}{% else %}{
{% for property in requiredProperties %}{{ indent }}'{{ (property | schemaName) | escapeDollarSign }}': {% if (property | schemaType) == 'object' %}{% if (property | schemaModel) and ((property | schemaModel) != 'prefs' and (property | schemaModel) != 'preferences') %}{{ _self.sub_schema(definitions, property, indent ~ '  ', indent) }}{% else %}<String, dynamic>{}{% endif %}{% elseif (property | schemaType) == 'array' %}[]{% elseif (property | schemaType) == 'string' %}{{ (property | schemaExample) | dartString }}{% elseif (property | schemaType) == 'boolean' %}true{% else %}{{ property | schemaExample }}{% endif %},
{% endfor %}{{ closeIndent }}}{% endif %}{% endif %}{% else %}{% if (property | schemaType) == 'object' and property.additionalProperties %}Map<String, dynamic>{% else %}{{ property | typeName }}{% endif %}{% endif %}{% endmacro %}
{% macro path_value(parameter, method) -%}
    {%- set configKey = parameter | configKey(method) -%}
    {%- if configKey -%}
        {{ configKey | caseLower == 'project' ? 'testproject' : '' }}
    {%- elseif not parameter.required -%}
    {%- elseif (parameter | enumValues) is not empty -%}
        {{ (parameter | schemaExample) in (parameter | enumValues) ? (parameter | schemaExample) : (parameter | enumValues)[0] | raw }}
    {%- elseif (parameter | schemaType) == 'integer' -%}
        1
    {%- elseif (parameter | schemaType) == 'number' -%}
        1.0
    {%- elseif (parameter | schemaType) == 'boolean' -%}
        true
    {%- else -%}
        {{ (parameter | schemaExample) | default(parameter.name) | raw }}
    {%- endif -%}
{%- endmacro %}
{% macro expected_path(method) -%}
    {%- set path = method.path -%}
    {%- for parameter in (method | parameters('path')) -%}
        {%- set path = path | replace({('{' ~ parameter.name ~ '}'): _self.path_value(parameter, method)}) -%}
    {%- endfor -%}
    {%- for security in (method | securityQueries) -%}
        {%- set path = path ~ (loop.first ? '?' : '&') ~ security.name ~ '=' ~ ((security.name | caseCamel) == 'project' ? 'testproject' : '') -%}
    {%- endfor -%}
    {{ path | raw }}
{%- endmacro %}
{% macro sent_parameters(method) -%}
    {%- set names = ((method | parameters('query')) | merge(method | parameters('body'))) | filter((param) => param.required) | map((param) => param.name | dartString) -%}
    {{ (names is empty ? 'isEmpty' : 'unorderedEquals([' ~ (names | join(', ')) ~ '])') | raw }}
{%- endmacro %}
{% if language.name == 'Dart' %}
import 'package:test/test.dart';
{% else %}
import 'package:flutter_test/flutter_test.dart';
{% endif %}
import 'package:mockito/mockito.dart';
import 'package:{{ language.params.packageName }}/models.dart' as models;
import 'package:{{ language.params.packageName }}/enums.dart' as enums;
import 'package:{{ language.params.packageName }}/src/enums.dart';
import 'package:{{ language.params.packageName }}/src/response.dart';
import 'dart:typed_data';
import 'package:{{ language.params.packageName }}/{{ language.params.packageName }}.dart';

class MockClient extends Mock implements Client {
  Map<String, String> config = {'project': 'testproject'};
  String endPoint = 'https://localhost/v1';

  @override
  Future<Response> call(
    HttpMethod? method, {
    String? path = '',
    Map<String, String>? headers = const {},
    Map<String, dynamic>? params = const {},
    ResponseType? responseType,
  }) async {
    return super.noSuchMethod(
      Invocation.method(#call, [method], {
        #path: path,
        #headers: headers,
        #params: params,
        #responseType: responseType,
      }),
      returnValue: Response(),
    );
  }

  @override
  Future<String?> webAuth(Uri? url) async {
    return super.noSuchMethod(
      Invocation.method(#webAuth, [url]),
      returnValue: 'done',
    );
  }

  @override
  Future<Response> chunkedUpload({
    String? path,
    Map<String, dynamic>? params,
    String? paramName,
    String? idParamName,
    Map<String, String>? headers,
    Function(UploadProgress)? onProgress,
    ResponseType? responseType,
    HttpMethod? method = HttpMethod.post,
  }) async {
    return super.noSuchMethod(
      Invocation.method(#chunkedUpload, [], {
        #path: path,
        #params: params,
        #paramName: paramName,
        #idParamName: idParamName,
        #headers: headers,
        #method: method,
      }),
      returnValue: Response(data: {}),
    );
  }
}

void main() {
  group('{{ service.name | caseUcfirst }} test', () {
    late MockClient client;
    late {{ service.name | caseUcfirst }} {{ service.name | caseCamel }};

    setUp(() {
      client = MockClient();
      {{ service.name | caseCamel }} = {{ service.name | caseUcfirst }}(client);
    });

{% for method in (service | operations) %}
    test('test method {{ (method | methodName) | caseCamel }}()', () async {
{% set responseModels = method | getValidResponseModels %}
{% set responseModelName = '' %}
{% if responseModels|length > 1 %}
{% set responseModelName = responseModels|last %}
{% elseif (method | responseModel) and (method | responseModel) != 'any' %}
{% set responseModelName = (method | responseModel) %}
{% endif %}
{% if (method | methodType) == 'location' %}
      final Uint8List data = Uint8List.fromList([]);
{% elseif responseModelName %}
{% set discriminatorConditions = (responseModels|length > 1 and (method | responseDiscriminator)[responseModelName] is defined) ? (method | responseDiscriminator)[responseModelName] : {} %}
{% set responseDefinition = definitions[responseModelName] ?? null %}
{% set requiredProperties = responseDefinition ? responseDefinition.properties | filter((param) => (param | schemaRequired) and (param | schemaName) not in (discriminatorConditions|keys)) : [] %}
{% if requiredProperties|length == 0 and discriminatorConditions|length == 0 %}
      final Map<String, dynamic> data = {};
{% else %}
      final Map<String, dynamic> data = {
{% for property in requiredProperties %}{% set propertyName = property | schemaName %}{% set stringExample = '' %}{% if (property | schemaType) == 'string' %}{% set stringExample = (property | schemaExample) | dartString %}{% endif %}        '{{ propertyName | escapeDollarSign }}':{% if (property | schemaType) == 'string' and propertyName|length + stringExample|length > 67 %}{% else %} {% endif %}{% if (property | schemaType) == 'object' %}{% if (property | schemaModel) and ((property | schemaModel) != 'prefs' and (property | schemaModel) != 'preferences') %}{{ _self.sub_schema(definitions, property) }}{% else %}<String, dynamic>{}{% endif %}{% elseif (property | schemaType) == 'array' %}[]{% elseif (property | schemaType) == 'string' %}{% if propertyName|length + stringExample|length > 67 %}{{ "\n" }}            {{ stringExample | raw }}{% else %}{{ stringExample | raw }}{% endif %}{% elseif (property | schemaType) == 'boolean' %}true{% else %}{{ (property | schemaExample) }}{% endif %},
{% endfor %}{% for field, value in discriminatorConditions %}{% if value is iterable %}{% set discriminatorValue = value | json_encode %}{% else %}{% set discriminatorValue = value | dartString %}{% endif %}        '{{ field | escapeDollarSign }}':{% if field|length + discriminatorValue|length > 67 %}{{ "\n" }}{% else %} {% endif %}{% if field|length + discriminatorValue|length > 67 %}            {{ discriminatorValue | raw }}{% else %}{{ discriminatorValue | raw }}{% endif %},
{% endfor %}      };
{% endif %}
{% else %}
      final data = '';
{% endif %}

{% if (method | methodType) == 'webAuth' %}
      when(client.webAuth(argThat(isNotNull))).thenAnswer((_) async => 'done');
{% elseif 'multipart/form-data' in (method | consumes) %}
      when(
        client.chunkedUpload(
          path: anyNamed('path'),
          params: anyNamed('params'),
          paramName: anyNamed('paramName'),
          idParamName: anyNamed('idParamName'),
          headers: anyNamed('headers'),
          method: anyNamed('method'),
        ),
      ).thenAnswer((_) async => Response(data: data));
{% else %}
      when(
        client.call(
          HttpMethod.{{ method.method.value | caseLower }},
          path: anyNamed('path'),
          headers: anyNamed('headers'),
          params: anyNamed('params'),
          responseType: anyNamed('responseType'),
        ),
      ).thenAnswer((_) async => Response(data: data));
{% endif %}

{% set requiredParams = (method | parameters('all')) | filter((param) => param.required) %}
{% if requiredParams|length == 0 %}
      final response = await {{ service.name | caseCamel }}.{{ (method | methodName) | caseCamel | overrideIdentifier }}();
{% else %}
      final response = await {{ service.name | caseCamel }}.{{ (method | methodName) | caseCamel | overrideIdentifier }}(
{% for parameter in requiredParams %}
        {{ parameter.name | escapeKeyword | caseCamel }}: {% if (parameter | enumValues) | length > 0 %}{{ parameter | enumExample }}{% elseif (parameter | typeName) starts with 'models.' %}{{ _self.request_model(requestModels, definitions, parameter | schemaModel, '        ') }}{% elseif (parameter | schemaType) == 'object' %}{}{% elseif (parameter | schemaType) == 'array' %}[]{% elseif (parameter | schemaType) == 'file' %}InputFile.fromPath(path: './image.png'){% elseif (parameter | schemaType) == 'boolean' %}true{% elseif (parameter | schemaType) == 'string' %}{{ ((parameter | schemaExample) | default(parameter.name)) | dartString }}{% elseif (parameter | schemaType) == 'integer' %}1{% elseif (parameter | schemaType) == 'number' %}1.0{% else %}{{ (parameter | schemaExample) }}{% endif %},
{% endfor %}
      );
{% endif %}
{% if (method | methodType) == 'webAuth' %}
      final Uri url = verify(client.webAuth(captureAny)).captured.single;
      expect(Uri.decodeFull(url.path), {{ ('/v1' ~ _self.expected_path(method)) | dartString }});
{% elseif 'multipart/form-data' in (method | consumes) %}
      final Map<String, dynamic> params = verify(
        client.chunkedUpload(
          path: {{ (_self.expected_path(method) ~ '') | dartString }},
          params: captureAnyNamed('params'),
          paramName: anyNamed('paramName'),
          idParamName: anyNamed('idParamName'),
          headers: anyNamed('headers'),
          method: HttpMethod.{{ method.method.value | caseLower }},
        ),
      ).captured.single;
      expect(params.keys, {{ _self.sent_parameters(method) }});
{% else %}
      final Map<String, dynamic> params = verify(
        client.call(
          HttpMethod.{{ method.method.value | caseLower }},
          path: {{ (_self.expected_path(method) ~ '') | dartString }},
          headers: anyNamed('headers'),
          params: captureAnyNamed('params'),
          responseType: anyNamed('responseType'),
        ),
      ).captured.single;
      expect(params.keys, {{ _self.sent_parameters(method) }});
{% endif %}
{% if (method | methodType) == 'location' %}
      expect(response, isA<Uint8List>());
{% elseif (method | methodType) == 'webAuth' %}
      expect(response, equals('done'));
{% elseif (method | textResponse) %}
      expect(response, isA<String>());
{% elseif responseModelName %}
      expect(response, isA<models.{{ responseModelName | caseUcfirst | overrideIdentifier }}>());
{% endif %}
    });{% if not loop.last %}{{ "\n\n" }}{% else %}{{ "\n" }}{% endif %}{% endfor %}  });
}
