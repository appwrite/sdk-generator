    public function page(int $page, int $perPage = 25): self
    {
        return $this->push(Query::page($page, $perPage));
    }

    /**
     * @param string|list<string> $query
     */
    private function push(string|array $query): self
    {
        if (\is_array($query)) {
            array_push($this->queries, ...$query);
        } else {
            $this->queries[] = $query;
        }

        return $this;
    }
}
