{% endif %}
{% if 'dart' in language.params.packageName %}
import 'package:test/test.dart';
{% else %}
import 'package:flutter_test/flutter_test.dart';
{% endif %}

void main() {
  group('{{ definitionName | caseUcfirst | overrideIdentifier }}', () {
    test('model', () {
      final model = {{ definitionName | caseUcfirst | overrideIdentifier }}(
{% for property in definition.properties | filter(p => p.required) %}
        {{ (property | schemaName) | escapeKeyword }}: {% if (property | schemaType) == 'array' %}[]{% elseif (property | schemaType) == 'object' and ((property | schemaModel) == 'prefs' or (property | schemaModel) == 'preferences') %}Preferences(data: {}){% elseif (property | schemaType) == 'object' and (property | schemaModel) %}{{_self.sub_schema(definitions, property)}}{% elseif (property | schemaType) == 'object' %}{}{% elseif property.enum %}{{ (property | enumName) | caseUcfirst }}.{{ ((property | enumKeys)[0] ?? property.enum[0]) | caseEnumKey }}{% elseif (property | schemaType) == 'string' %}'{{(property | schemaExample) | escapeDollarSign}}'{% elseif (property | schemaType) == 'boolean' %}true{% else %}{{(property | schemaExample)}}{% endif %},
{% endfor %}
{% if definition.additionalProperties %}
        {{ 'data' | escapeKeyword }}: {},
{% endif %}
      );

      final map = model.toMap();
      final result = {{ definitionName | caseUcfirst | overrideIdentifier }}.fromMap(map);

{% for property in definition.properties | filter(p => p.required) %}
      {% if (property | schemaType) != 'object' or not (property | schemaModel) or ((property | schemaModel) == 'prefs' and (property | schemaModel) == 'preferences') %}
      expect(result.{{ (property | schemaName) | escapeKeyword }}{% if (property | schemaType) == 'object' and ((property | schemaModel) == 'prefs' or (property | schemaModel) == 'preferences') %}.data{% endif %}, {% if (property | schemaType) == 'array' %}[]{% elseif (property | schemaType) == 'object' and ((property | schemaModel) == 'prefs' or (property | schemaModel) == 'preferences') %}{"data": {}}{% elseif (property | schemaType) == 'object' %}{}{% elseif property.enum %}{{ (property | enumName) | caseUcfirst }}.{{ ((property | enumKeys)[0] ?? property.enum[0]) | caseEnumKey }}{% elseif (property | schemaType) == 'string' %}'{{(property | schemaExample) | escapeDollarSign}}'{% elseif (property | schemaType) == 'boolean' %}true{% else %}{{(property | schemaExample)}}{% endif %});
      {% endif %}
{% endfor %}
    });
  });
