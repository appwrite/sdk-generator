    /**
     * Return limit and offset queries for 1-based page pagination.
     *
     * @param int $page
     * @param int $perPage
     * @return array<string>
     */
    public static function page(int $page, int $perPage = 25): array
    {
        if ($page < 1) {
            throw new \InvalidArgumentException('Page must be >= 1, got ' . $page);
        }
        if ($perPage < 1) {
            throw new \InvalidArgumentException('Per page must be >= 1, got ' . $perPage);
        }

        return [
            self::limit($perPage),
            self::offset(($page - 1) * $perPage),
        ];
    }

    /**
     * Start a fluent query builder.
     *
     * @return QueryBuilder
     */
    public static function builder(): QueryBuilder
    {
        return new QueryBuilder();
    }

    /**
     * @param string|array<string> $leftOrAliasOrOn
     * @param string|array<string> $rightOrOn
     */
    private static function createJoin(string $method, string $table, string|array $leftOrAliasOrOn, string|array $rightOrOn, string $operator, string $alias): string
    {
        if (\is_array($leftOrAliasOrOn)) {
            return self::nestedJoin($method, $table, '', $leftOrAliasOrOn);
        }
        if (\is_array($rightOrOn)) {
            return self::nestedJoin($method, $table, $leftOrAliasOrOn, $rightOrOn);
        }

        return self::joinQuery($method, $table, $leftOrAliasOrOn, $rightOrOn, $operator, $alias);
    }

    /**
     * @param array<string> $on
     */
    private static function nestedJoin(string $method, string $table, string $alias, array $on): string
    {
        $values = [];
        if ($alias !== '') {
            $values[] = $alias;
        }
        foreach ($on as $query) {
            $values[] = \json_decode($query, true);
        }

        return (new Query($method, $table, $values))->__toString();
    }

    private static function joinQuery(string $method, string $table, string $left, string $right, string $operator, string $alias): string
    {
        $values = [$left, $operator, $right];
        if ($alias !== '') {
            $values[] = $alias;
        }

        return (new Query($method, $table, $values))->__toString();
    }
