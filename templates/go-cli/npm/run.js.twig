#!/usr/bin/env node
// Launcher for the npm distribution of the {{ spec.title | caseUcfirst }} CLI.
//
// `npm i -g {{ language.params.npmPackage }}` used to install a JavaScript bundle and run it
// under node. It now installs a native binary, and this file is the shim that
// finds and executes it. Keeping the package name and the `{{ language.params.executableName }}` bin
// entry identical is what makes the switch invisible: a CI job that installs
// the CLI this way keeps working without touching its config.
//
// WHY optionalDependencies AND NOT A POSTINSTALL DOWNLOAD
//
// The obvious shim downloads the right binary from GitHub in a postinstall
// script. That breaks in exactly the environments that install a CLI from npm:
// `npm ci --ignore-scripts` is common CI hardening and would leave the package
// installed but unusable, an air-gapped or proxied registry has no route to
// github.com, and nothing checks the download's integrity.
//
// Per-platform packages avoid all of it. npm reads the `os` and `cpu` fields
// and installs only the one matching package, the tarball is integrity-checked
// and cached like any other dependency, and no network access happens after
// resolution. This is what esbuild, swc and turbo all do.
//
// The consequence to remember when releasing: the platform packages must be
// published BEFORE this one, or an install resolves optionalDependencies that
// do not exist yet. scripts/build-npm-packages.mjs builds them from the
// goreleaser output and the release workflow publishes in that order.

const { spawnSync } = require("node:child_process");

// Keyed to match the release asset names rather than node's own spelling --
// `win` not `win32`, `x64` not `amd64` -- so one set of six suffixes names the
// GitHub assets, the npm packages, and the entries in install.sh.
const PLATFORMS = {
  "darwin arm64": "darwin-arm64",
  "darwin x64": "darwin-x64",
  "linux arm64": "linux-arm64",
  "linux x64": "linux-x64",
  "win32 arm64": "win-arm64",
  "win32 x64": "win-x64",
};

const suffix = PLATFORMS[`${process.platform} ${process.arch}`];
if (!suffix) {
  console.error(
    `{{ language.params.npmPackage }} does not ship a binary for ${process.platform}/${process.arch}.`,
  );
  process.exit(1);
}

const packageName = `{{ language.params.npmPackage }}-${suffix}`;
const binary = process.platform === "win32" ? "{{ language.params.executableName }}.exe" : "{{ language.params.executableName }}";

let executable;
try {
  executable = require.resolve(`${packageName}/bin/${binary}`);
} catch {
  // An optional dependency that fails to install is not an error to npm, so
  // this is the first place a user hears about it. Name the package: the
  // install looked successful, and without it there is nothing to search for.
  console.error(
    `${packageName} is not installed, so there is no {{ language.params.executableName }} binary to run.\n` +
      `Reinstall {{ language.params.npmPackage }}, or download the binary directly from {{ sdk.gitURL }}/releases.`,
  );
  process.exit(1);
}

// stdio: "inherit" rather than piping, so the child keeps the real terminal.
// The CLI's prompts need a TTY, and piping would silently turn every
// interactive command into a hang.
const result = spawnSync(executable, process.argv.slice(2), { stdio: "inherit" });

if (result.error) {
  console.error(result.error.message);
  process.exit(1);
}

// A signalled child has a null status. Reporting 0 there would tell a CI job
// that a cancelled command succeeded.
process.exit(result.status === null ? 1 : result.status);
