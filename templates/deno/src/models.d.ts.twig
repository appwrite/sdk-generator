{% macro sub_schema(property, definition, spec) %}
{% apply spaceless %}
    {% if (property | schemaModel) %}
        {% if _self.get_generics_sub(definition, spec) %}
            {{(property | schemaModel) | caseUcfirst}}<{{ _self.get_generics_sub(definition, spec) }}>{% if (property | schemaType) == 'array' %}[]{% endif %}
        {% else %}
            {{(property | schemaModel) | caseUcfirst}}{% if (property | schemaType) == 'array' %}[]{% endif %}
        {% endif %}
    {% elseif (property | schemaModels) %}
        ({% for subProperty in (property | schemaModels) %}{{subProperty | caseUcfirst}}{% if loop.last == false %} | {% endif %}{% endfor %}){% if (property | schemaType) == 'array' %}[]{% endif %}
    {% else %}
        {{property | typeName}}
    {% endif %}
{% endapply %}
{% endmacro %}
{% macro get_generics(definition, spec) %}
{% apply spaceless %}
    {% for property in definition.properties %}
        {% if definitions[(property | schemaModel)].additionalProperties %}
            {{(property | schemaModel) | caseUcfirst}} extends Models.{{(property | schemaModel) | caseUcfirst}}
        {% endif %}
        {% if definitions[(property | schemaModel)] %}
            {{_self.get_generics(definitions[(property | schemaModel)], spec)}}
        {% endif %}
    {% endfor %}
{% endapply %}
{% endmacro %}
{% macro get_generics_sub(definition, spec, output = false) %}
{% apply spaceless %}
    {% for property in definition.properties %}
        {% if definitions[(property | schemaModel)].additionalProperties and output %}
            {{(property | schemaModel) | caseUcfirst}}
        {% endif %}
        {% if definitions[(property | schemaModel)] %}
            {{_self.get_generics_sub(definitions[(property | schemaModel)], spec, true)}}
        {% endif %}
    {% endfor %}
{% endapply %}
{% endmacro %}
export namespace Models {
{% for definitionName, definition in definitions %}
    /**
     * {{ definition.description }}
     */
    export type {{ definitionName | caseUcfirst }}{% if _self.get_generics(definition, spec) %}<{{_self.get_generics(definition, spec)}}>{% endif %} = {
{% for property in definition.properties %}
        /**
         * {{ property.description }}
         */
        {{ (property | schemaName) | escapeKeyword }}{% if not (property | schemaRequired) %}?{% endif %}: {{_self.sub_schema(property, definition, spec)}};
{% endfor %}
    }
{% endfor %}
}