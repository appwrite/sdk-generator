// Mock {{ service.name | caseUcfirst }} service, generated when sdk.test is set.
//
// The e2e suite asserts on strings the CLI prints, not on network traffic, so
// the SDK is replaced by a stand-in returning the fixtures the suite expects.
// That keeps the conformance run free of any dependency on a published SDK
// release, and means every build is checked against one set of expectations in
// tests/e2e/Base.php.
//
// `x-sdk-language` is the literal `cli`, not the language name: internal/sdk
// sends `cli` so requests are attributed to the CLI, and the mock has to report
// what the real client would.

type {{ service.name | caseUcfirst }}MockService struct{}

func new{{ service.name | caseUcfirst }}MockService() *{{ service.name | caseUcfirst }}MockService {
	return &{{ service.name | caseUcfirst }}MockService{}
}
{% for method in (service | operations) %}
{% set query = method | cliQueryConfig %}

// {{ (method | methodName) | caseUcfirst }} is a mock.
func (srv *{{ service.name | caseUcfirst }}MockService) {{ (method | methodName) | caseUcfirst }}(args ...any) (*mockResult, error) {
{% if query.hasQueries %}
	// Query commands echo the queries they built, so the harness can assert the
	// exact JSON the real client would have sent.
	queries := []string{}
	for _, argument := range args {
		if list, ok := argument.([]string); ok {
			queries = list

			break
		}
	}
	encoded, err := json.Marshal(queries)
	if err != nil {
		return nil, err
	}

	return &mockResult{Result: string(encoded)}, nil
{% elseif (method | methodName) == 'redirect' %}
	return &mockResult{Result: "{{ method.method.value | upper }}:/v1{{ method.path }}/done:passed"}, nil
{% elseif (method | methodName) == 'headers' %}
	return &mockResult{Result: "x-sdk-name: {{ sdk.name }}; x-sdk-platform: {{ sdk.platform }}; " +
		"x-sdk-language: cli; x-sdk-version: {{ sdk.version }}" +
		"{% for key, header in (method | methodHeaders) %}; {{ key }}: {{ header }}{% endfor %}"}, nil
{% else %}
	return &mockResult{Result: "{{ method.method.value | upper }}:/v1{{ method.path }}:passed"}, nil
{% endif %}
}
{% endfor %}
