import {afterEach, describe, it as test} from "https://deno.land/std@0.204.0/testing/bdd.ts";
import {restore, stub} from "https://deno.land/std@0.204.0/testing/mock.ts";
import {assertEquals} from "https://deno.land/std@0.204.0/assert/assert_equals.ts";
import { {{ service.name | caseUcfirst }} } from "../../src/services/{{ service.name | caseKebab }}.ts";
import {Client} from "../../src/client.ts";
import {InputFile} from "../../src/inputFile.ts"
{% set added = [] %}
{% set usesModels = false %}
{% for method in (service | operations) %}
{% for parameter in (method | parameters('all')) | filter((param) => param.required) %}
{% if (parameter | schemaType) != 'array' and (parameter | enumValues) is not empty and (parameter | enumName) not in added %}
import { {{ (parameter | enumName) | caseUcfirst }} } from "../../src/enums/{{ (parameter | enumName) | caseKebab }}.ts";
{% set added = added | merge([(parameter | enumName)]) %}
{% endif %}
{% if (parameter | schemaType) != 'array' and (parameter | schemaModel) %}{% set usesModels = true %}{% endif %}
{% endfor %}
{% endfor %}
{% if usesModels %}
import type { Models } from "../../src/models.d.ts";
{% endif %}
{% macro value(parameter, requestModels) %}
{%- if (parameter | schemaType) == 'array' -%}
[]
{%- elseif (parameter | schemaModel) -%}
{ {% for property in (requestModels[(parameter | schemaModel)].properties ?? []) | filter((param) => param | schemaRequired) %}'{{ property | schemaName }}': {{ _self.value(property, requestModels) }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if requestModels[(parameter | schemaModel)] is not defined %} as Models.{{ (parameter | schemaModel) | caseUcfirst }}{% endif %}
{%- elseif (parameter | schemaType) == 'object' -%}
{}
{%- elseif (parameter | schemaType) == 'file' -%}
InputFile.fromBuffer(new Uint8Array(0), 'image.png')
{%- elseif (parameter | schemaType) == 'boolean' -%}
true
{%- elseif (parameter | enumValues) is not empty -%}
{{ (parameter | enumName) | caseUcfirst }}.{{ (parameter | enumKeys)[0] | caseEnumKey }}
{%- elseif (parameter | schemaType) == 'string' -%}
'{% if (parameter | schemaExample) is not empty %}{{ (parameter | schemaExample) | escapeDollarSign }}{% else %}{{ parameter.name ?? (parameter | schemaName) }}{% endif %}'
{%- elseif (parameter | schemaType) == 'integer' -%}
1
{%- elseif (parameter | schemaType) == 'number' -%}
1.0
{%- else -%}
{{ parameter | schemaExample }}
{%- endif -%}
{% endmacro %}

describe('{{ service.name | caseUcfirst }} service', () => {
    const client = new Client();
    const {{ service.name | caseCamel }} = new {{ service.name | caseUcfirst }}(client);

    afterEach(() => restore())

    {% for method in (service | operations) ~%}
    test('test method {{ (method | methodName) | caseCamel }}()', async () => {
        {% set responseModels = method | getValidResponseModels %}
        {% set responseModelName = '' %}
        {% if responseModels|length > 1 %}
        {% set responseModelName = responseModels|last %}
        {% elseif (method | responseModel) and (method | responseModel) != 'any' %}
        {% set responseModelName = (method | responseModel) %}
        {% endif %}
        {%~ if (method | methodType) == 'webAuth' %}
        const data = 'https://example.com/';
        {%~ elseif (method | methodType) == 'location' %}
        const data = new Uint8Array(0);
        {%~ else %}
            {%- if responseModelName %}
        const data = {
            {%- for definitionName, definition in definitions ~%}{%~ if definitionName == responseModelName -%}{%~ for property in definition.properties | filter((param) => param | schemaRequired) ~%}
            '{{(property | schemaName) | escapeDollarSign}}': {% if (property | schemaType) == 'object' %}{}{% elseif (property | schemaType) == 'array' %}[]{% elseif (property | schemaType) == 'string' %}'{{(property | schemaExample) | escapeDollarSign}}'{% elseif (property | schemaType) == 'boolean' %}true{% else %}{{(property | schemaExample)}}{% endif %},{%~ endfor ~%}{% set break = true %}{%- else -%}{% set continue = true %}{%- endif -%}{%~ endfor -%}
        };
            {%~ else %}
        const data = '';
            {%~ endif %}
        {%~ endif %}

        {%~ if (method | methodType) == 'webAuth' %}
        const stubbedFetch = stub(globalThis, 'fetch', () => Promise.resolve(new Response(null, { status: 301, headers: { location: data } })));
        {%~ elseif (method | methodType) == 'location' %}
        const stubbedFetch = stub(globalThis, 'fetch', () => Promise.resolve(new Response(data.buffer)));
        {%~ elseif responseModelName %}
        const stubbedFetch = stub(globalThis, 'fetch', () => Promise.resolve(new Response(JSON.stringify(data), { headers: { 'content-type': 'application/json' } })));
        {%~ else %}
        const stubbedFetch = stub(globalThis, 'fetch', () => Promise.resolve(new Response(data)))
        {%~ endif %}

        const response = await {{ service.name | caseCamel }}.{{ (method | methodName) | caseCamel }}({%~ for parameter in (method | parameters('all')) | filter((param) => param.required) ~%}
            {{ _self.value(parameter, requestModels) }},{%~ endfor ~%}
        );

        {%~ if (method | methodType) == 'location' %}
        assertEquals(response.byteLength, 0);
        {%~ elseif (method | methodType) == 'webAuth' or (method | textResponse) %}
        assertEquals(response, data);
        {%~ else %}
        assertEquals<unknown>(response, data);
        {%~ endif %}
        stubbedFetch.restore();
    });

    {% endfor %}
})
