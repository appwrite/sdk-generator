    pub fn page(page: u32, per_page: u32) -> Vec<Self> {
        if page < 1 {
            panic!("Page must be >= 1, got {}", page);
        }
        if per_page < 1 {
            panic!("Per page must be >= 1, got {}", per_page);
        }
        vec![Self::limit(per_page), Self::offset((page - 1) * per_page)]
    }

    pub fn builder() -> Builder {
        Builder::new()
    }

    pub(crate) fn normalize(value: impl Serialize) -> Vec<String> {
        match serde_json::to_value(value) {
            Ok(v) => Self::normalize_value(&v),
            Err(_) => vec![],
        }
    }

    pub(crate) fn normalize_value(value: &Value) -> Vec<String> {
        match value {
            Value::Null => vec![],
            Value::String(s) => vec![s.clone()],
            Value::Array(items) => items.iter().flat_map(Self::normalize_value).collect(),
            Value::Object(_) => vec![value.to_string()],
            _ => vec![],
        }
    }

    fn aliased(method: &str, attribute: impl Into<String>, alias: impl Into<String>) -> Self {
        let alias = alias.into();
        let values = if alias.is_empty() {
            vec![]
        } else {
            vec![Value::String(alias)]
        };
        Self::new(method.to_string(), Some(attribute.into()), values)
    }

    fn join_query(
        method: &str,
        table: impl Into<String>,
        left: impl Into<String>,
        right: impl Into<String>,
        operator: impl Into<String>,
        alias: impl Into<String>,
    ) -> Self {
        let mut values = vec![
            Value::String(left.into()),
            Value::String(operator.into()),
            Value::String(right.into()),
        ];
        let alias = alias.into();
        if !alias.is_empty() {
            values.push(Value::String(alias));
        }
        Self::new(method.to_string(), Some(table.into()), values)
    }

    fn nested_join<I, S>(method: &str, table: impl Into<String>, alias: impl Into<String>, on: I) -> Self
    where
        I: IntoIterator<Item = S>,
        S: AsRef<str>,
    {
        let mut values = Vec::new();
        let alias = alias.into();
        if !alias.is_empty() {
            values.push(Value::String(alias));
        }
        for query in on {
            if let Ok(parsed) = serde_json::from_str::<Value>(query.as_ref()) {
                values.push(parsed);
            }
        }
        Self::new(method.to_string(), Some(table.into()), values)
    }

    /// Convert query to JSON value (matches Go/Python SDK format)
    pub fn to_value(self) -> Value {
        let mut obj = serde_json::Map::new();
        obj.insert("method".to_string(), Value::String(self.method));

        if let Some(attr) = self.attribute {
            obj.insert("attribute".to_string(), Value::String(attr));
        }

        if !self.values.is_empty() {
            obj.insert("values".to_string(), Value::Array(self.values));
        }

        Value::Object(obj)
    }
}

impl std::fmt::Display for Query {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        let json_str = serde_json::to_string(self).unwrap_or_else(|_| String::new());
        write!(f, "{}", json_str)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_equal_query() {
        let query = Query::equal("name", "John");
        let value = query.to_value();
        assert_eq!(value["method"], "equal");
        assert_eq!(value["attribute"], "name");
        assert_eq!(value["values"][0], "John");
    }

    #[test]
    fn test_greater_than_query() {
        let query = Query::greater_than("age", 18);
        let value = query.to_value();
        assert_eq!(value["method"], "greaterThan");
        assert_eq!(value["attribute"], "age");
        assert_eq!(value["values"][0], 18);
    }

    #[test]
    fn test_between_query() {
        let query = Query::between("age", 18, 65);
        let value = query.to_value();
        assert_eq!(value["method"], "between");
        assert_eq!(value["attribute"], "age");
        assert_eq!(value["values"][0], 18);
        assert_eq!(value["values"][1], 65);
    }

    #[test]
    fn test_select_query() {
        let query = Query::select(vec!["name", "age"]);
        let value = query.to_value();
        assert_eq!(value["method"], "select");
        assert_eq!(value["values"][0], "name");
        assert_eq!(value["values"][1], "age");
    }

