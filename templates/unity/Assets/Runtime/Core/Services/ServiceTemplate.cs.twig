{% import 'dotnet/base/utils.twig' as utils %}
#if UNI_TASK
using System;
using System.Collections.Generic;
using System.Linq;
using Cysharp.Threading.Tasks;
{% if definitions is not empty %}
using {{ spec.info.title | caseUcfirst }}.Models;
{% endif %}
{% if service.name|lower == 'account' or service.name|lower == 'general' %}
using {{ spec.info.title | caseUcfirst }}.Extensions;
using UnityEngine;
{% endif %}

namespace {{ spec.info.title | caseUcfirst }}.Services
{
    public class {{ service.name | caseUcfirst }} : Service
    {
        public {{ service.name | caseUcfirst }}(Client client) : base(client)
        {
        }

        {%~ for method in (service | operations) %}
        {%~ if method.description %}
        /// <summary>
        /// <para>
        {{~ method.description | wrap(75, '        /// ') }}
        /// </para>
        /// </summary>
        {%~ endif %}
        {%~ if method.deprecated %}
        {%~ if (method | appwrite('deprecated', {})['since'] ?? '') and (method | appwrite('deprecated', {})['replaceWith'] ?? '') %}
        [Obsolete("This API has been deprecated since {{ (method | appwrite('deprecated', {})['since'] ?? '') }}. Please use `{{ (method | appwrite('deprecated', {})['replaceWith'] ?? '') | capitalizeFirst }}` instead.")]
        {%~ else %}
        [Obsolete("This API has been deprecated.")]
        {%~ endif %}
        {%~ endif %}
{% if (method | methodType) == "webAuth" %}
#if UNITY_EDITOR || UNITY_IOS || UNITY_ANDROID || UNITY_WEBGL
{% endif %}
        public {% if (method | methodType) == "webAuth" %}async {% endif ~%} UniTask{% if (method | methodType) == "webAuth" %}{% else %}<{{ utils.resultType(spec.info.title, method) }}>{% endif %} {{ (method | methodName) | caseUcfirst }}({{ utils.method_parameters((method | parameters('all')), (method | consumes)) }})
        {
            var apiPath = "{{ method.path }}"{% if (method | parameters('path')) | length == 0 %};{% endif %}

            {{~ include('dotnet/base/params.twig') }}

            {%~ if (method | responseModel) %}
            static {{ utils.resultType(spec.info.title, method) }} Convert(Dictionary<string, object> it) =>
            {%~ if (method | responseModel) == 'any' or (method | responseModels)|length > 1 %}
                it;
            {%~ else %}
                {{ utils.resultType(spec.info.title, method) }}.From(map: it);
            {%~ endif %}
            {%~ endif %}

            {%~ if (method | methodType) == 'location' %}
            {{~ include('dotnet/base/requests/location.twig') }}
            {%~ elseif (method | methodType) == 'webAuth' %}
            {{~ include('unity/base/requests/oauth.twig') }}
            {%~ elseif 'multipart/form-data' in (method | consumes) %}
            {{~ include('dotnet/base/requests/file.twig') }}
            {%~ else %}
            {{~ include('dotnet/base/requests/api.twig')}}
            {%~ endif %}
        }
{% if (method | methodType) == "webAuth" %}
#else
        public UniTask {{ (method | methodName) | caseUcfirst }}({{ utils.method_parameters((method | parameters('all')), (method | consumes)) }})
        {
            Debug.LogWarning("[{{ spec.info.title | caseUcfirst }}] OAuth2 authorization is not supported on this platform. Available only in Editor, WebGL, iOS or Android.");
            return UniTask.CompletedTask;
        }
#endif{% endif %}

    {%~ endfor %}
    }
}
#endif
