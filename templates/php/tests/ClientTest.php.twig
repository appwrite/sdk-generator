    public function testHttpClientIsReusedUntilTransportOptionsChange(): void
    {
        $client = new Client();
        $client->setEndpoint('https://example.com/v1');

        $first = $this->httpClient($client);
        $this->assertInstanceOf(HttpClient::class, $first);
        $this->assertSame($first, $this->httpClient($client));

        $client->setTimeout(5);
        $this->assertNull(new ReflectionProperty(Client::class, 'httpClient')->getValue($client));
        $rebuilt = $this->httpClient($client);
        $this->assertInstanceOf(HttpClient::class, $rebuilt);
        $this->assertNotSame($first, $rebuilt);
    }

    public function testSelfSignedAndConnectTimeoutResetHttpClient(): void
    {
        $client = new Client();
        $original = $this->httpClient($client);

        $client->setSelfSigned(true);
        $this->assertNotSame($original, $this->httpClient($client));

        $afterSelfSigned = $this->httpClient($client);
        $client->setConnectTimeout(2);
        $this->assertNotSame($afterSelfSigned, $this->httpClient($client));
    }

    public function testInjectedTransportReceivesEncodedRequests(): void
    {
        $received = [];
        $transport = $this->createMock(ClientInterface::class);
        $transport->expects($this->once())->method('sendRequest')
            ->willReturnCallback(function (RequestInterface $request) use (&$received): ResponseInterface {
                $received[] = $request;

                return new Response(body: new Stream('{"received":true}'))
                    ->withHeader('content-type', 'application/json');
            });

        $client = new Client($transport)
            ->setEndpoint('https://example.com/v1')
            ->addHeader('x-test', 'injected');

        $this->assertSame(['received' => true], $client->call(Client::METHOD_POST, '/items', ['content-type' => 'application/json'], ['name' => 'item']));
        $this->assertCount(1, $received);
        $this->assertSame('POST', $received[0]->getMethod());
        $this->assertSame('https://example.com/v1/items', (string) $received[0]->getUri());
        $this->assertSame(['name' => 'item'], json_decode((string) $received[0]->getBody(), true));
        $this->assertSame('injected', $received[0]->getHeaderLine('x-test'));
    }

    public function testHeaderLineBreaksAreRefused(): void
    {
        $transport = $this->createMock(ClientInterface::class);
        $transport->expects($this->never())->method('sendRequest');

        $client = new Client($transport)
            ->setEndpoint('https://example.com/v1')
            ->addHeader('x-test', "value\r\nx-injected: 1");

        $this->expectException({{ namespace | split('\\') | last | caseUcfirst }}Exception::class);
        $this->expectExceptionMessage('Header contains a line break: x-test');
        $client->call(Client::METHOD_GET, '/items');
    }

