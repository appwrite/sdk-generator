{% if language.params.cdnPath %}
import { existsSync, readdirSync, readFileSync } from 'fs';
{% else %}
import { readFileSync } from 'fs';
{% endif %}
const pkg = JSON.parse(readFileSync('./package.json', 'utf8'));
import typescript from '@rollup/plugin-typescript';
import resolve from '@rollup/plugin-node-resolve';
import commonjs from '@rollup/plugin-commonjs';
import nodePolyfills from 'rollup-plugin-polyfill-node';
import terser from '@rollup/plugin-terser';

const external = Object.keys(pkg.dependencies ?? {});

// The Push service uses mqtt.js, which references Node built-ins
// (buffer/process/stream/…); polyfill them for the browser bundles.
const browser = (options) => [
    nodePolyfills(),
    resolve({ browser: true, preferBuiltins: false }),
    commonjs(),
    typescript(options),
];

const minify = (options = {}) =>
    terser({
        ecma: 2020,
        format: { comments: false },
        compress: { passes: 3 },
        ...options,
    });

const iife = (file, options) => ({
    input: 'src/index.ts',
    plugins: browser(options),
    output: [
        {
            format: 'iife',
            file,
            name: 'Appwrite',
            extend: true,
            // A script tag has no module loader, so the lazy mqtt.js import is inlined here.
            inlineDynamicImports: true,
            sourcemap: true,
            plugins: [minify()],
        },
    ],
});

{% if language.params.cdnPath %}
const libs = [
{% else %}
export default [
{% endif %}
    {
        input: 'src/index.ts',
        external,
        plugins: [typescript({ outDir: 'dist' })],
        output: [
            {
                format: 'cjs',
                file: pkg.main,
                esModule: false,
                sourcemap: true,
            },
            {
                format: 'es',
                file: pkg.module,
                sourcemap: true,
            },
        ],
    },
    iife(pkg.jsdelivr, { outDir: 'dist' }),
];
{% if language.params.cdnPath %}

const helpers = [
    'client',
    'query',
    'id',
    'permission',
    'role',
    'operator',
    'channel',
    'topic',
]
    .filter((name) => existsSync(`src/${name}.ts`))
    .map((name) => [name, `src/${name}.ts`]);

const services = readdirSync('src/services')
    .filter((file) => file.endsWith('.ts'))
    .map((file) => [file.slice(0, -3), `src/services/${file}`]);

const modern = { outDir: 'dist/cdn', target: 'ES2020' };

const cdn = [
    {
        input: {
            index: 'src/index.ts',
            ...Object.fromEntries(helpers),
            ...Object.fromEntries(services),
        },
        plugins: browser(modern),
        output: {
            format: 'es',
            dir: 'dist/cdn',
            entryFileNames: '[name].js',
            chunkFileNames: 'chunks/[name]-[hash].js',
            minifyInternalExports: true,
            sourcemap: true,
            plugins: [minify({ module: true })],
        },
    },
    iife('dist/cdn/sdk.min.js', modern),
];

export default process.env.CDN ? cdn : libs;
{% endif %}
