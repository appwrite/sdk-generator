         */
        fun sum(attribute: String, alias: String = "") = Query("sum", attribute, if (alias.isNotEmpty()) listOf(alias) else null).toJson()

        /**
         * Average values of [attribute], optionally aliased.
         *
         * @param attribute The attribute to average.
         * @param alias Optional result alias.
         * @returns The query string.
         */
        fun avg(attribute: String, alias: String = "") = Query("avg", attribute, if (alias.isNotEmpty()) listOf(alias) else null).toJson()

