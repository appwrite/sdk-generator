                return {{ spec.info.title | caseUcfirst}}Models.{{ modelName | caseUcfirst }}.from(map: responseMap)
            }
{% endfor %}
            throw AppwriteError(message: "Unable to match response to any expected response model")
            {%~ else %}
            return {{ spec.info.title | caseUcfirst}}Models.{{(method | responseModel) | caseUcfirst}}.from(map: response as! [String: Any])
            {%~ endif %}
            {%~ else %}
            return {{ spec.info.title | caseUcfirst}}Models.{{(method | responseModel) | caseUcfirst}}.from(map: response as! [String: Any])
            {%~ endif %}
