[
  {
    "name": "the CLI's own defaults",
    "patterns": [
      ".appwrite",
      "code.tar.gz"
    ],
    "expected": {
      ".appwrite": true,
      ".appwrite/build.tar.gz": true,
      "src/.appwrite/x": true,
      "code.tar.gz": true,
      "src/code.tar.gz": true,
      "codeXtar.gz": false,
      "src/index.js": false
    }
  },
  {
    "name": "a representative .gitignore",
    "patterns": [
      "node_modules",
      "*.log",
      "!important.log",
      "build/",
      "/root-only.txt",
      "dist/**",
      "**/generated",
      ".env*",
      "!.env.example"
    ],
    "expected": {
      "node_modules": true,
      "node_modules/pkg/index.js": true,
      "src/node_modules/pkg/index.js": true,
      "debug.log": true,
      "logs/debug.log": true,
      "important.log": false,
      "logs/important.log": false,
      "build": false,
      "build/out.js": true,
      "src/build/out.js": true,
      "root-only.txt": true,
      "nested/root-only.txt": false,
      "dist/a/b.js": true,
      "dist": false,
      "generated": true,
      "a/generated": true,
      "a/generated/file.ts": true,
      ".env": true,
      ".env.local": true,
      ".env.example": false,
      "config/.env": true,
      "src/index.js": false
    }
  },
  {
    "name": "anchoring and depth",
    "patterns": [
      "a/b",
      "/c",
      "d/",
      "e/**/f"
    ],
    "expected": {
      "a/b": true,
      "a/b/c": true,
      "x/a/b": false,
      "c": true,
      "c/d": true,
      "x/c": false,
      "d": false,
      "d/e": true,
      "x/d/e": true,
      "e/f": true,
      "e/x/f": true,
      "e/x/y/f": true,
      "x/e/f": false
    }
  },
  {
    "name": "character classes, escapes and negation order",
    "patterns": [
      "file?.txt",
      "[abc].md",
      "[!x].bin",
      "temp/",
      "!temp/keep.txt",
      "\\#literal",
      "trailing   "
    ],
    "expected": {
      "file1.txt": true,
      "file10.txt": false,
      "file.txt": false,
      "a.md": true,
      "x.md": false,
      "a.bin": true,
      "x.bin": false,
      "temp/drop.txt": true,
      "temp/keep.txt": true,
      "#literal": true,
      "literal": false,
      "trailing": true,
      "trailing   ": false
    }
  },
  {
    "name": "comments and blanks are not patterns",
    "patterns": [
      "# a comment",
      "",
      "   ",
      "real.txt"
    ],
    "expected": {
      "a comment": false,
      "# a comment": false,
      "real.txt": true,
      "other.txt": false
    }
  },
