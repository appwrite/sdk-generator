package services

{% set scope = resourceHeader | cliServiceScope %}
{% set hasQueryParam = (service | operations) | hasCliQueryParam %}
import (
{% if sdk.test %}
{% if hasQueryParam %}
	"encoding/json"

{% endif %}
	"github.com/spf13/cobra"

	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/app"
{% if hasQueryParam %}
	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/query"
{% endif %}
	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/sdk"
{% else %}
	"github.com/spf13/cobra"

	"{{ language.params.sdkImportPath }}/{{ service.name | goPackage }}"

	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/app"
{% if hasQueryParam %}
	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/query"
{% endif %}
	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/sdk"
{% endif %}
)
{% if sdk.test %}

{{ include('cli/base/mock.go.twig') -}}
{% endif %}

// New{{ service.name | caseUcfirst }}Command builds the `{{ service.name | caseLower }}` command tree.
func New{{ service.name | caseUcfirst }}Command() *cobra.Command {
{% set serviceKeyFormat = service.name == 'tablesDB' ? '%-9s' : '%-7s' %}
	cmd := &cobra.Command{
		{{ serviceKeyFormat|format('Use:') }}"{{ service.name | caseLower }}",
{% if service.name == 'tablesDB' %}
		{{ serviceKeyFormat|format('Aliases:') }}[]string{"tables-db"},
{% endif %}
		{{ serviceKeyFormat|format('Short:') }}{{ service.description | default('') | stripMarkdown | goString | raw }},
		{{ serviceKeyFormat|format('Args:') }}cobra.NoArgs,
		RunE: func(cmd *cobra.Command, args []string) error {
			return cmd.Help()
		},
	}

{% set seenCommands = [] %}
{% for method in (service | operations) %}
{% set commandName = (method | methodName) | caseKebab %}
{% if commandName not in seenCommands %}
{% set seenCommands = seenCommands|merge([commandName]) %}
{% for target in method | cliCommandTargets(service) %}
{% if not target.standalone %}
	cmd.AddCommand(new{{ service.name | caseUcfirst }}{{ (method | methodName) | caseUcfirst }}Command())
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

	return cmd
}
{% set rootAliases = service | cliTopLevelAliases(service | operations) %}
{% if rootAliases is not empty %}

// New{{ service.name | caseUcfirst }}RootCommands returns the methods promoted to
// top-level commands. The service subcommand stays registered but hidden, so
// both spellings keep working.
func New{{ service.name | caseUcfirst }}RootCommands() []*cobra.Command {
	commands := []*cobra.Command{
{% for alias in rootAliases %}
		new{{ service.name | caseUcfirst }}{{ alias.method | caseUcfirst }}Command(),
{% endfor %}
	}

	// The same constructor builds both spellings, and it marks the command
	// hidden so it does not appear twice under its service. The promoted copy is
	// the one --help is meant to advertise, so it is made visible here.
	for _, command := range commands {
		command.Hidden = false
	}

	return commands
}
{% endif %}
{% set seenCommands = [] %}
{% for method in (service | operations) %}
{% set commandName = (method | methodName) | caseKebab %}
{% if commandName not in seenCommands %}
{% set seenCommands = seenCommands|merge([commandName]) %}
{% set query = method | cliQueryConfig %}
{% set hasScopedIdParam = false %}
{% for parameter in (method | parameters('all')) %}
{% if scope and parameter.name == scope.idVar %}
{% set hasScopedIdParam = true %}
{% endif %}
{% endfor %}
{% set scopedFlag = scope and not hasScopedIdParam %}
{% set isTopLevel = false %}
{# `implementation` names a console-fallback helper this method routes through
   instead of the SDK. Captured here rather than read inside RunE, where the
   target loop variable is out of scope -- a branch on it there silently never
   fires and still compiles. #}
{% set implementation = null %}
{% for target in method | cliCommandTargets(service) %}
{% if target.standalone %}
{% set isTopLevel = true %}
{% endif %}
{% if target.implementation %}
{% set implementation = target.implementation %}
{% endif %}
{% endfor %}

func new{{ service.name | caseUcfirst }}{{ (method | methodName) | caseUcfirst }}Command() *cobra.Command {
{% for parameter in (method | parameters('all')) %}
{% set opt = getCliOption(parameter) %}
	var {{ opt.var }} {{ opt.goType }}
{% endfor %}
{% if query.hasQueries %}
{% if query.hasFiltering %}
	var filter []string
	var where []string
	var sortAsc []string
	var sortDesc []string
{% endif %}
{% if query.hasPagination %}
	var limit int
	var offset int
{% endif %}
{% if query.hasCursors %}
	var cursorAfter string
	var cursorBefore string
{% endif %}
{% if query.hasSelect %}
	var selectAttributes []string
{% endif %}
{% endif %}
{% if (method | methodType) == 'location' %}
	var destination string
{% endif %}
{% if scopedFlag %}
	var {{ scope.idVar }} string
{% endif %}

{# Same alignment rule as query.Options below: `Hidden` only renders for a
   promoted command, and its presence widens the run. RunE is excluded -- gofmt
   ends an alignment run at a value that spans lines. #}
{% set commandKeyFormat = isTopLevel ? '%-8s' : '%-7s' %}
	cmd := &cobra.Command{
		{{ commandKeyFormat|format('Use:') }}"{{ (method | methodName) | caseKebab }}",
		{{ commandKeyFormat|format('Short:') }}{{ cliMethodDescription(method, service) | stripMarkdown | goString | raw }},
{% if isTopLevel %}
		{{ commandKeyFormat|format('Hidden:') }}true,
{% endif %}
		{{ commandKeyFormat|format('Args:') }}cobra.NoArgs,
		RunE: func(cmd *cobra.Command, args []string) error {
{% set plan = getGoCallPlan(method, service) %}
{% if sdk.test %}
			service := new{{ service.name | caseUcfirst }}MockService()
{% elseif not implementation %}
{% if scope %}
			client, err := app.ClientFor{{ scope.label }}({{ scopedFlag ? scope.idVar : '""' }})
{% elseif isConsoleOnly %}
			client, err := app.ClientForConsole()
{% else %}
			client, err := app.ClientForProject("")
{% endif %}
			if err != nil {
				return err
			}
			service := {{ plan.package }}.New(client)
{% endif %}
{% if not sdk.test %}
{% for decode in plan.decodes %}
{% if decode.cleanup is defined %}
			{{ decode.var }}, {{ decode.cleanup }}, err := app.{{ decode.helper }}({{ decode.source }})
			if err != nil {
				return err
			}
			defer {{ decode.cleanup }}()
{% else %}
			{{ decode.var }}, err := app.{{ decode.helper }}({{ decode.source }})
			if err != nil {
				return err
			}
{% endif %}
{% endfor %}
{% endif %}
{% if query.hasQueries %}

{% if query.hasFiltering %}
			parsedFilter, err := query.ParseFilters(filter)
			if err != nil {
				return err
			}
			parsedWhere, err := query.ParseFilters(where)
			if err != nil {
				return err
			}

{% endif %}
{# gofmt aligns a struct literal's values to the longest key present, and which
   keys are present depends on the flags this method has. Padding to a fixed
   width would leave the generated file needing a gofmt pass, so the width is
   computed from the keys actually emitted. #}
{% set queryKeyPad = 'Queries'|length %}
{% if query.hasFiltering and 'SortDesc'|length > queryKeyPad %}{% set queryKeyPad = 'SortDesc'|length %}{% endif %}
{% if query.hasCursors and 'CursorBefore'|length > queryKeyPad %}{% set queryKeyPad = 'CursorBefore'|length %}{% endif %}
{% if query.hasSelect and 'Select'|length > queryKeyPad %}{% set queryKeyPad = 'Select'|length %}{% endif %}
{% set queryKeyFormat = '%-' ~ (queryKeyPad + 2) ~ 's' %}
			queries, err := query.Build(query.Options{
				{{ queryKeyFormat|format('Queries:') }}queries,
{% if query.hasFiltering %}
				{{ queryKeyFormat|format('Filter:') }}parsedFilter,
				{{ queryKeyFormat|format('Where:') }}parsedWhere,
				{{ queryKeyFormat|format('SortAsc:') }}sortAsc,
				{{ queryKeyFormat|format('SortDesc:') }}sortDesc,
{% endif %}
{% if query.hasPagination %}
				{{ queryKeyFormat|format('Limit:') }}app.FlagInt(cmd, "limit", limit),
				{{ queryKeyFormat|format('Offset:') }}app.FlagInt(cmd, "offset", offset),
{% endif %}
{% if query.hasCursors %}
				{{ queryKeyFormat|format('CursorAfter:') }}app.FlagString(cmd, "cursor-after", cursorAfter),
				{{ queryKeyFormat|format('CursorBefore:') }}app.FlagString(cmd, "cursor-before", cursorBefore),
{% endif %}
{% if query.hasSelect %}
				{{ queryKeyFormat|format('Select:') }}selectAttributes,
{% endif %}
			})
			if err != nil {
				return err
			}
{% endif %}
{% if plan.optional is not empty and not implementation and not sdk.test %}

			// An unset flag must be omitted, not sent as its zero value: the
			// TypeScript passes undefined and the SDK drops it.
			options := []{{ plan.package }}.{{ plan.optionType }}{}
{% for option in plan.optional %}
{% if option.flag == 'queries' and query.hasQueries %}
			if app.AnyFlagChanged(cmd, "queries", "filter", "where", "sort-asc", "sort-desc", "limit", "offset", "cursor-after", "cursor-before", "select") {
				options = append(options, service.{{ option.setter }}({{ option.expression }}))
			}
{% else %}
			if cmd.Flags().Changed("{{ option.flag }}") {
				options = append(options, service.{{ option.setter }}({{ option.expression }}))
			}
{% endif %}
{% endfor %}
{% endif %}

{% if implementation == 'listOrganizationsForSession' %}
			result, err := app.ListOrganizationsForSession(
				app.FlagInt(cmd, "limit", limit), app.FlagInt(cmd, "offset", offset), search)
{% elseif implementation == 'listProjectsForSession' %}
			result, err := app.ListProjectsForSession({{ scopedFlag ? scope.idVar : '""' }},
				app.FlagInt(cmd, "limit", limit), app.FlagInt(cmd, "offset", offset), search)
{% elseif implementation == 'getOrganizationForSession' %}
			result, err := app.GetOrganizationForSession({{ scopedFlag ? scope.idVar : '""' }})
{% elseif sdk.test %}
{# Joined rather than suffixed per argument: a trailing ", " leaves a method
   with no arguments after it reading `Method(id, )`, which compiles but is not
   what anyone would write. #}
{% set callArguments = query.hasQueries ? ['queries'] : [] %}
{% for parameter in (method | parameters('all')) %}{% set callArguments = callArguments|merge([getGoVarName(parameter)]) %}{% endfor %}
			result, err := service.{{ plan.method }}({{ callArguments|join(', ') }})
{% else %}
{% set callArguments = [] %}
{% for argument in plan.required %}{% set callArguments = callArguments|merge([argument.expression]) %}{% endfor %}
{% if plan.optional is not empty %}{% set callArguments = callArguments|merge(['options...']) %}{% endif %}
			result, err := service.{{ plan.method }}({{ callArguments|join(', ') }})
{% endif %}
			if err != nil {
				return sdk.WrapMutationError("{{ method.method.value | upper }}", err)
			}
{% if (method | methodType) == 'location' and not sdk.test %}

			// A location method returns the file bytes, not a URL. The
			// TypeScript fetches the URL itself; the SDK has already done that.
			return app.WriteFile(destination, result)
{% else %}

			return app.Render(result)
{% endif %}
		},
	}

{% for parameter in (method | parameters('all')) %}
{% set opt = getCliOption(parameter) %}
	cmd.Flags().{{ opt.register }}Var(&{{ opt.var }}, "{{ opt.flag }}", {% if opt.goType == '[]string' %}nil{% elseif opt.goType == 'bool' %}false{% elseif opt.goType == 'int' %}0{% elseif opt.goType == 'float64' %}0{% else %}""{% endif %}, {{ cliParameterDescription(parameter, method, service) | stripMarkdown | goString | raw }})
{% if opt.noOptDefault %}
	cmd.Flags().Lookup("{{ opt.flag }}").NoOptDefVal = "{{ opt.noOptDefault }}"
{% endif %}
{% if opt.required %}
	_ = cmd.MarkFlagRequired("{{ opt.flag }}")
{% endif %}
{% endfor %}
{% if query.hasQueries %}
{% if query.hasFiltering %}
	cmd.Flags().StringArrayVar(&filter, "filter", nil, "Filter using a simple comparison expression. Repeat for multiple filters. Supports field=value, field!=value, field>value, field>=value, field<value, and field<=value.")
	cmd.Flags().StringArrayVar(&where, "where", nil, "Deprecated. Use --filter instead. Filter using a simple comparison expression. Repeat for multiple filters.")
	cmd.Flags().StringArrayVar(&sortAsc, "sort-asc", nil, "Sort results by an attribute in ascending order. Repeat for multiple sort fields.")
	cmd.Flags().StringArrayVar(&sortDesc, "sort-desc", nil, "Sort results by an attribute in descending order. Repeat for multiple sort fields.")
{% endif %}
{% if query.hasPagination %}
	cmd.Flags().IntVar(&limit, "limit", 0, "Maximum number of results to return.")
	cmd.Flags().IntVar(&offset, "offset", 0, "Number of results to skip.")
{% endif %}
{% if query.hasCursors %}
	cmd.Flags().StringVar(&cursorAfter, "cursor-after", "", "Return results after this cursor ID.")
	cmd.Flags().StringVar(&cursorBefore, "cursor-before", "", "Return results before this cursor ID.")
{% endif %}
{% if query.hasSelect %}
	cmd.Flags().StringArrayVar(&selectAttributes, "select", nil, "Attribute to include in the response. Repeat for multiple attributes.")
{% endif %}
{% endif %}
{% if (method | methodType) == 'location' %}
	cmd.Flags().StringVar(&destination, "destination", "", "Path to save the file to.")
	_ = cmd.MarkFlagRequired("destination")
{% endif %}
{% if scopedFlag %}
	cmd.Flags().StringVar(&{{ scope.idVar }}, "{{ scope.flag }}", "", "{{ scope.label }} to act on. Defaults to the {{ scope.label | lower }} linked in {{ language.params.executableName }}.config.json.")
{% endif %}
	return cmd
}
{% endif %}
{% endfor %}
