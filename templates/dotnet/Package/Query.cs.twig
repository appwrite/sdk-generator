        public static List<string> Page(int page, int perPage = 25)
        {
            if (page < 1)
            {
                throw new ArgumentException("Page must be >= 1, got " + page);
            }
            if (perPage < 1)
            {
                throw new ArgumentException("Per page must be >= 1, got " + perPage);
            }

            return new List<string> { Limit(perPage), Offset((page - 1) * perPage) };
        }

        internal static object? Flatten(object? value)
        {
            if (value is Builder builder)
            {
                return builder.Build();
            }
            if (value is Query query)
            {
                return query.ToString();
            }
            if (value is not IEnumerable enumerable || value is string)
            {
                return value;
            }

            var items = enumerable.Cast<object?>().ToList();
            var output = new List<object?>();
            var changed = false;
            foreach (var item in items)
            {
                var flat = Flatten(item);
                if (item is Builder || item is Query)
                {
                    if (flat is IEnumerable nested && flat is not string)
                    {
                        output.AddRange(nested.Cast<object?>());
                    }
                    else
                    {
                        output.Add(flat);
                    }
                    changed = true;
                    continue;
                }
                if (item is IEnumerable nestedItems && item is not string && IsStringList(flat))
                {
                    output.AddRange(((IEnumerable)flat!).Cast<object?>());
                    changed = true;
                    continue;
                }
                if (!Equals(flat, item))
                {
                    changed = true;
                }
                output.Add(flat);
            }

            return changed ? output : value;
        }

        private static bool IsStringList(object? value)
        {
            if (value is not IEnumerable enumerable || value is string)
            {
                return false;
            }
            foreach (var item in enumerable)
            {
                if (item is not string)
                {
                    return false;
                }
            }
            return true;
        }

        internal static List<string> Normalize(object? queries)
        {
            var flat = Flatten(queries);
            if (flat is string s)
            {
                return new List<string> { s };
            }
            if (flat is IEnumerable enumerable && flat is not string)
            {
                return enumerable.Cast<object?>().Select(item => item?.ToString() ?? string.Empty).ToList();
            }
            return new List<string>();
        }

        private static string JoinQuery(string method, string table, string left, string right, string @operator, string alias)
        {
            var values = new List<string> { left, @operator, right };
            if (alias != "")
            {
                values.Add(alias);
            }

            return new Query(method, table, values).ToString();
        }

        private static string NestedJoin(string method, string table, string alias, List<string> on)
        {
            var values = new List<object>();
            if (alias != "")
            {
                values.Add(alias);
            }
            foreach (var query in on)
            {
                var parsed = JsonSerializer.Deserialize<Query>(query, Client.DeserializerOptions);
                if (parsed != null)
                {
                    values.Add(parsed);
                }
            }

            return new Query(method, table, values).ToString();
        }
