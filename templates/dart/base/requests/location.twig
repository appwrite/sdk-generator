{% import 'dart/base/utils.twig' as utils %}
    final Map<String, dynamic> apiParams = {
      {{ utils.map_parameter((method | parameters('query'))) }}
      {{ utils.map_parameter((method | parameters('body'))) }}
    };

    final Map<String, String> apiHeaders = {
      {%~ for key, security in (method | securityHeaders) %}
      '{{ security.name }}': client.config['{{ key | caseCamel }}'] ?? '',
      {%~ endfor %}
      {{ utils.map_headers((method | methodHeaders)) }}
    };

    final res = await client.call(HttpMethod.{{ method.method.value | caseLower }}, path: apiPath, params: apiParams, headers: apiHeaders, responseType: ResponseType.bytes);
    return res.data;
