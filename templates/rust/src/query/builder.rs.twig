    pub fn vector_dot<S: Into<String>, N: Into<Value>>(mut self, attribute: S, vector: Vec<N>) -> Self {
        let values = Value::Array(vector.into_iter().map(|n| n.into()).collect());
        self.queries.push(Query::vector_dot(attribute, values));
        self
    }

    pub fn vector_cosine<S: Into<String>, N: Into<Value>>(mut self, attribute: S, vector: Vec<N>) -> Self {
        let values = Value::Array(vector.into_iter().map(|n| n.into()).collect());
        self.queries.push(Query::vector_cosine(attribute, values));
        self
    }

    pub fn vector_euclidean<S: Into<String>, N: Into<Value>>(mut self, attribute: S, vector: Vec<N>) -> Self {
        let values = Value::Array(vector.into_iter().map(|n| n.into()).collect());
        self.queries.push(Query::vector_euclidean(attribute, values));
        self
    }

    pub fn covers<S: Into<String>, V: Into<Value>>(mut self, attribute: S, values: V) -> Self {
        self.queries.push(Query::covers(attribute, values));
