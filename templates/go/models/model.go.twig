package models
{% set defaults = {} %}
{% for property in definition.properties | filter((property) => (property | schemaRequired) and (property | schemaDefault) is not null) %}
{% set defaults = defaults | merge({((property | schemaName)): (property | schemaDefault)}) %}
{% endfor %}

import (
	"encoding/json"
	"errors"
)

{{ ((definition.description | caseUcfirst) ~ " Model") | godocComment }}
type {{ definitionName | caseUcfirst }} struct {
	{%~ for property in definition.properties %}
	{{ (property.description | godocComment | replace({"\n": "\n\t"})) | raw }}
	{{ (property | schemaName) | caseUcfirst | escapeKeyword }} {{ property | responsePropertyType(spec) }} `json:"{{ (property | schemaName) }}"`
	{%~ endfor %}

	// Used by Decode() method
	data []byte
}

func (model {{ definitionName | caseUcfirst }}) New(data []byte) *{{ definitionName | caseUcfirst }} {
	model.data = data
	return &model
}

{%~ if defaults is not empty %}
func (model *{{ definitionName | caseUcfirst }}) UnmarshalJSON(data []byte) error {
	type alias {{ definitionName | caseUcfirst }}
	if err := json.Unmarshal([]byte({{ defaults | goJsonString }}), (*alias)(model)); err != nil {
		return err
	}

	return json.Unmarshal(data, (*alias)(model))
}

{%~ endif %}
{%~ if definition.additionalProperties %}
// Use this method to get response in desired type
{%~ endif %}
func (model *{{ definitionName | caseUcfirst }}) Decode(value interface{}) error {
	if len(model.data) <= 0 {
		return errors.New("method Decode() cannot be used on nested struct")
	}

	err := json.Unmarshal(model.data, value)
	if err != nil {
		return err
	}

	return nil
}
