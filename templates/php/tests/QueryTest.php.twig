    public function testBuilderBuild(): void
    {
        $expected = [
            Query::equal('status', 'published'),
            Query::leftJoin('orders', '$id', 'customerId', '=', 'ord'),
            Query::count('*', 'total'),
            Query::groupBy(['status']),
            Query::limit(25),
        ];

        $built = Query::builder()
            ->equal('status', 'published')
            ->leftJoin('orders', '$id', 'customerId', '=', 'ord')
            ->count('*', 'total')
            ->groupBy(['status'])
            ->limit(25)
            ->build();

        $this->assertSame($expected, $built);
    }

