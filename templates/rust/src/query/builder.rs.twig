    {
        self.queries.push(Query::group_by(attributes));
        self
    }

    pub fn having<I, S>(mut self, queries: I) -> Self
    where
        I: IntoIterator<Item = S>,
        S: AsRef<str>,
    {
        self.queries.push(Query::having(queries));
        self
    }

    pub fn distinct(mut self) -> Self {
        self.queries.push(Query::distinct());
        self
    }

    pub fn join(
        mut self,
        table: impl Into<String>,
        left: impl Into<String>,
        right: impl Into<String>,
        operator: impl Into<String>,
        alias: impl Into<String>,
    ) -> Self {
        self.queries.push(Query::join(table, left, right, operator, alias));
        self
    }

    pub fn left_join(
        mut self,
        table: impl Into<String>,
