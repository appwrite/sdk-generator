<?php

declare(strict_types=1);

namespace {{ namespace | caseNamespace }};

use {{ namespace | caseNamespace }}\Query\Builder as QueryBuilder;
{% if globalHeaders | hasBearerAuth %}
use Ahc\Jwt\JWT;
{% endif %}

class Client
{
    public const METHOD_GET = 'GET';
    public const METHOD_POST = 'POST';
    public const METHOD_PUT = 'PUT';
    public const METHOD_PATCH = 'PATCH';
    public const METHOD_DELETE = 'DELETE';
    public const METHOD_HEAD = 'HEAD';
    public const METHOD_OPTIONS = 'OPTIONS';
    public const METHOD_CONNECT = 'CONNECT';
    public const METHOD_TRACE = 'TRACE';

    public const CHUNK_SIZE = 5 * 1024 * 1024;
{% if globalHeaders | hasBearerAuth %}
    public const JWT_MAX_AGE_SECONDS = 3600;
{% endif %}

    /**
     * Is Self Signed Certificates Allowed?
     *
     */
    protected bool $selfSigned = false;

    /**
     * Service host name
     *
     */
    protected string $endpoint = '{{(spec | endpoint)}}';

    /**
     * Global Headers
     *
     */
    protected array $headers = [
        'content-type' => '',
        'user-agent' => '{{spec.info.title | caseUcfirst}}{{ language.name | caseUcfirst }}SDK/{{ sdk.version }} ({{deviceInfo}})',
        'x-sdk-name' => '{{ sdk.name }}',
        'x-sdk-platform' => '{{ sdk.platform }}',
        'x-sdk-language' => '{{ language.name | caseLower }}',
        'x-sdk-version' => '{{ sdk.version }}',
    ];

    /**
     * Auth/config values used by generated service methods.
     *
     */
    protected array $config = [];

{% if globalHeaders | hasBearerAuth %}
    /**
     * API key for JWT generation
     *
     */
    protected ?string $key = null;

    /**
     * Cached authorization header value
     *
     */
    protected ?string $authorization = null;

    /**
     * Authorization header expiry time
     *
     */
    protected ?\DateTime $authorizationExpiresAt = null;

{% endif %}
    /**
     * Timeout in seconds
     *
     */
    protected ?int $timeout = null;

    /**
     * Connect timeout in seconds
     *
     */
    protected ?int $connectTimeout = null;

    /**
     * Client constructor.
     */
    public function __construct()
    {
{% for key,header in defaultHeaders %}
        $this->headers['{{key}}'] = '{{header}}';
{% endfor %}
    }

{% for headerKey, header in globalHeaders %}
    /**
     * Set {{headerKey | caseUcfirst}}
     *
{% if header.description %}
     * {{header.description}}
     *
{% endif %}
     *
     */
    public function set{{headerKey | caseUcfirst}}(string $value): Client
    {
        {%~ if (headerKey != 'Project') %}
        $this->addHeader('{{header.name}}', {% if header.scheme == 'bearer' %}"Bearer {$value}"{% else %}$value{% endif %});
        {%~ endif %}
        $this->config['{{ headerKey | caseLower }}'] = $value;
{% if header.scheme == 'bearer' %}
        $this->key = null;
        $this->authorization = null;
        $this->authorizationExpiresAt = null;
{% endif %}

        return $this;
    }

{% endfor %}
{% if globalHeaders | hasBearerAuth %}
    /**
     * Set Signing Key
     *
     * Set a secret key used to self-sign short-lived JWTs for the Authorization header
     *
     *
     */
    public function setSigningKey(string $key): Client
    {
        $this->key = $key;
        $this->authorization = null;
        $this->authorizationExpiresAt = null;
{% for headerKey, header in globalHeaders %}
{% if header.scheme == 'bearer' %}
        unset($this->headers['{{ header.name | caseLower }}'], $this->config['{{ headerKey | caseLower }}']);
{% endif %}
{% endfor %}

        return $this;
    }

{% endif %}

    public function getConfig(string $key): string
    {
        return $this->config[$key] ?? '';
    }

    /***
     */
    public function setSelfSigned(bool $status = true): Client
    {
        $this->selfSigned = $status;

        return $this;
    }

    /***
     */
    public function setEndpoint(string $endpoint): Client
    {
        if (!str_starts_with($endpoint, 'http://') && !str_starts_with($endpoint, 'https://')) {
            throw new {{ namespace | split('\\') | last | caseUcfirst }}Exception("Invalid endpoint URL: $endpoint");
        }

        $this->endpoint = $endpoint;
        return $this;
    }

    /**
     * Set Timeout
     *
     */
    public function setTimeout(int $timeout): Client
    {
        $this->timeout = $timeout;
        return $this;
    }

    /**
     * Set Connect Timeout
     *
     */
    public function setConnectTimeout(int $connectTimeout): Client
    {
        $this->connectTimeout = $connectTimeout;
        return $this;
    }

    /**
     */
    public function addHeader(string $key, string $value): Client
    {
        $this->headers[strtolower($key)] = $value;

        return $this;
    }

    /**
     * Get the request headers.
     *
     */
    public function getHeaders(): array
    {
        return $this->headers;
    }

{% if globalHeaders | hasBearerAuth %}
    /**
     * Get authorization header, generating a new JWT if needed
     *
     */
    private function getAuthorization(): string
    {
        if (\is_string($this->authorization) && $this->authorizationExpiresAt > new \DateTime()) {
            return $this->authorization;
        }

        $jwt = new JWT($this->key, maxAge: self::JWT_MAX_AGE_SECONDS);
        $this->authorization = "Bearer {$jwt->encode([])}";

        $this->authorizationExpiresAt = (new \DateTime())->modify('+' . (self::JWT_MAX_AGE_SECONDS - 5) . ' seconds');

        return $this->authorization;
    }

{% endif %}
    /**
     * Call
     *
     * Make an API call
     *
     * @throws {{ namespace | split('\\') | last | caseUcfirst}}Exception
     */
    public function call(
        string $method,
        string $path = '',
        array $headers = [],
        array $params = [],
        ?string $responseType = null
    ) {
{% if globalHeaders | hasBearerAuth %}
        if ($this->key !== null) {
            $this->headers['authorization'] = $this->getAuthorization();
        }
{% endif %}
        $headers = array_merge($this->headers, $headers);
        $params = \array_map(self::flatten(...), $params);
        $querySeparator = str_contains($path, '?') ? '&' : '?';
        $ch = curl_init($this->endpoint . $path . (($method === self::METHOD_GET && $params !== []) ? $querySeparator . http_build_query($params) : ''));
        $responseHeaders = [];

        $query = match ($headers['content-type']) {
            'application/json' => json_encode($this->prepareParams($params)),
            'multipart/form-data' => $this->flattenForm($params),
            default => http_build_query($params),
        };

        $curlHeaders = [];
        foreach ($headers as $name => $value) {
            $curlHeaders[] = $name . ':' . $value;
        }

        curl_setopt($ch, CURLOPT_CUSTOMREQUEST, $method);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_USERAGENT, php_uname('s') . '-' . php_uname('r') . ':{{ language.name | caseLower }}-' . phpversion());
        curl_setopt($ch, CURLOPT_HTTPHEADER, $curlHeaders);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, $responseType !== 'location');
        curl_setopt($ch, CURLOPT_HEADERFUNCTION, function ($curl, string $header) use (&$responseHeaders): int {
            $len = strlen($header);
            $parts = explode(':', strtolower($header), 2);

            if (count($parts) < 2) { // ignore invalid headers
                return $len;
            }

            $responseHeaders[strtolower(trim($parts[0]))] = trim($parts[1]);

            return $len;
        });

        if ($method !== self::METHOD_GET) {
            curl_setopt($ch, CURLOPT_POSTFIELDS, $query);
        }

        // Allow self signed certificates
        if ($this->selfSigned) {
            curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 0);
            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        }

        // Set timeout if configured
        if ($this->timeout !== null) {
            curl_setopt($ch, CURLOPT_TIMEOUT, $this->timeout);
        }

        // Set connect timeout if configured
        if ($this->connectTimeout !== null) {
            curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, $this->connectTimeout);
        }

        $responseBody   = curl_exec($ch);
        $contentType    = $responseHeaders['content-type'] ?? '';
        $responseStatus = curl_getinfo($ch, CURLINFO_HTTP_CODE);

        if ($responseBody === false) {
            throw new {{ namespace | split('\\') | last | caseUcfirst}}Exception(curl_error($ch), $responseStatus);
        }

        $warnings = $responseHeaders['x-{{spec.info.title | caseLower}}-warning'] ?? '';
        if ($warnings) {
            foreach (explode(';', $warnings) as $warning) {
                \trigger_error($warning, E_USER_WARNING);
            }
        }

        if (str_starts_with($contentType, 'application/json')) {
            $responseBody = json_decode($responseBody, true);
        }

        if ($responseStatus >= 400) {
            if (is_array($responseBody)) {
                throw new {{ namespace | split('\\') | last | caseUcfirst}}Exception($responseBody['message'], $responseStatus, $responseBody['type'] ?? '', json_encode($responseBody));
            }
            throw new {{ namespace | split('\\') | last | caseUcfirst}}Exception($responseBody, $responseStatus, '', $responseBody);
        }

        if ($responseType === 'location') {
            return $responseHeaders['location'];
        }

        return $responseBody;
    }

    /**
     * Flatten params array to PHP multiple format
     */
    protected function flattenForm(array $data, string $prefix = ''): array
    {
        $output = [];

        foreach ($data as $key => $value) {
            $finalKey = $prefix ? "{$prefix}[{$key}]" : $key;

            if (is_array($value)) {
                $output = array_merge($output, $this->flattenForm($value, $finalKey));
            } else {
                $output[$finalKey] = $value;
            }
        }

        return $output;
    }

    /**
     * Prepare params for JSON encoding by converting model objects to arrays
     */
    protected function prepareParams($data)
    {
        if (is_array($data)) {
            return array_map($this->prepareParams(...), $data);
        }

        if (is_object($data) && method_exists($data, 'toArray')) {
            return $data->toArray();
        }

        return $data;
    }

    public static function flatten(mixed $value): mixed
    {
        if ($value instanceof QueryBuilder) {
            return $value->build();
        }
        if ($value instanceof Query) {
            return $value->__toString();
        }
        if (!\is_array($value) || !\array_is_list($value)) {
            return $value;
        }

        $out = [];
        $changed = false;
        foreach ($value as $item) {
            $flat = self::flatten($item);
            if ($item instanceof QueryBuilder || $item instanceof Query) {
                if (\is_array($flat)) {
                    array_push($out, ...$flat);
                } else {
                    $out[] = $flat;
                }
                $changed = true;
                continue;
            }
            if (\is_array($item) && \array_is_list($item) && self::isStringList($flat)) {
                array_push($out, ...$flat);
                $changed = true;
                continue;
            }
            if ($flat !== $item) {
                $changed = true;
            }
            $out[] = $flat;
        }

        return $changed ? $out : $value;
    }

    private static function isStringList(mixed $value): bool
    {
        if (!\is_array($value) || !\array_is_list($value)) {
            return false;
        }
        foreach ($value as $item) {
            if (!\is_string($item)) {
                return false;
            }
        }

        return true;
    }
}
