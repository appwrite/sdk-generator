func TestUpdateOAuth2ProviderUsesProjectClient(t *testing.T) {
	home := t.TempDir()
	t.Setenv("HOME", home)
	t.Setenv("USERPROFILE", home)
	directory := filepath.Join(home, ".appwrite")
	if err := os.MkdirAll(directory, 0o755); err != nil {
		t.Fatal(err)
	}
	for _, provider := range []string{"kakao", "tiktok"} {
		t.Run(provider, func(t *testing.T) {
			cases := []map[string]interface{}{
				{},
				{"clientId": "", "enabled": false},
			}
			for _, params := range cases {
				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
					if r.Method != "PATCH" || r.URL.Path != "/v1/project/oauth2/"+provider {
						t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
					}
					if r.Header.Get("X-Appwrite-Project") != "test-project" || r.Header.Get("X-Appwrite-Key") != "test-key" {
						t.Error("project authentication headers missing")
					}
					if r.Header.Get("Content-Type") != "application/json" {
						t.Error("JSON content type missing")
					}
					var body map[string]interface{}
					if err := json.NewDecoder(r.Body).Decode(&body); err != nil || !reflect.DeepEqual(body, params) {
						t.Errorf("body = %#v, error = %v; want %#v", body, err, params)
					}
					w.Header().Set("Content-Type", "application/json")
					w.Write([]byte(`{"enabled":false,"newField":"preserved"}`))
				}))
				defer server.Close()
				preferences := `{"current":"test","test":{"key":"test-key","endpoint":"` + server.URL + `/v1"}}`
				if err := os.WriteFile(filepath.Join(directory, "prefs.json"), []byte(preferences), 0o600); err != nil {
					t.Fatal(err)
				}
				t.Setenv("APPWRITE_ENDPOINT", server.URL+"/v1")
				result, err := UpdateOAuth2Provider("test-project", "/project/oauth2/"+provider, params)
				if err != nil || string(result) != `{"enabled":false,"newField":"preserved"}` {
					t.Fatalf("result = %s, error = %v", result, err)
				}
				if string(sdk.LastResponse.Take()) != string(result) {
					t.Error("raw response was not captured")
				}
			}
		})
	}
}

func intPointer(value int) *int { return &value }

func TestListHintsAreContextual(t *testing.T) {
	tests := []struct {
		name           string
		kind           string
		total          int
		count          int
		limit          *int
		offset         *int
		search         string
		organizationID string
		want           []string
	}{
		{
			name: "complete unfiltered list is quiet", kind: "projects", total: 3, count: 3,
			want: []string{},
		},
		{
			name: "next page preserves filters", kind: "projects", total: 80, count: 10,
			limit: intPointer(10), offset: intPointer(20), search: "billing api",
			organizationID: "org-id",
			want: []string{
				"Showing 21–30 of 80. Next page: appwrite list-projects --organization-id org-id --search 'billing api' --limit 10 --offset 30",
				"Project details: appwrite project get --project-id <PROJECT_ID>",
			},
		},
		{
			name: "organization search suggests details", kind: "organizations", total: 1, count: 1,
			search: "Example",
			want:   []string{"Organization details: appwrite organization get --organization-id <ORGANIZATION_ID>"},
		},
		{
			name: "empty search suggests recovery", kind: "projects", total: 0, count: 0,
			search: "missing",
			want:   []string{"Try a shorter search or remove --search."},
		},
	}

	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			got := listHints(test.kind, test.total, test.count, test.limit, test.offset,
				test.search, test.organizationID)
			if !reflect.DeepEqual(got, test.want) {
				t.Errorf("listHints() = %#v, want %#v", got, test.want)
			}
		})
	}
}

func TestShellArgumentQuotesApostrophes(t *testing.T) {
	got := shellArgument("Chirag's Organization")
	if got != `'Chirag'"'"'s Organization'` {
		t.Fatalf("shellArgument() = %q", got)
	}
}
