{
    "name": "{{ language.params.composerVendor }}/{{ language.params.composerPackage }}",
    "description": "{{ sdk.shortDescription }}",
    "type": "library",
    "license": "{{ spec.info.license.name }}",
    "support": {
        "url": "{{ spec.info.contact.url }}",
        "email": "{{ spec.info.contact.email }}"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "refactor": "vendor/bin/rector process --dry-run"
    },
    "autoload": {
        "psr-4": {
            "{{ namespace | caseNamespace | escapeJson }}\\": "src/{{ namespace | caseNamespacePath }}"
        }
    },
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "utopia-php/client": "^0.3"
{%- if globalHeaders | hasBearerAuth %},
        "adhocore/jwt": "^1.1"
{%- endif %}

    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "mockery/mockery": "1.6.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.2"
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
