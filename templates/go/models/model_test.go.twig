func Test{{ definitionName | caseUcfirst }}{{ field }}Nullable(t *testing.T) {
	var model {{ definitionName | caseUcfirst }}
	var zero {{ property | propertyType(spec) }}
	data, err := json.Marshal(map[string]interface{}{"{{ property | schemaName }}": zero})
	if err != nil {
