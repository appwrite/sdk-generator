<?php

declare(strict_types=1);

namespace {{ namespace | caseNamespace }};

class Query implements \JsonSerializable, \Stringable
{
    protected ?array $values;

    public function __construct(protected string $method, protected ?string $attribute = null, $values = null)
    {

        if (is_null($values) || is_array($values)) {
            $this->values = $values;
        } else {
            $this->values = [$values];
        }
    }

    public function __toString(): string
    {
        return (string) json_encode($this);
    }

    public function jsonSerialize(): mixed
    {
        return array_filter([
            'method' => $this->method,
            'attribute' => $this->attribute,
            'values' => $this->values,
        ]);
    }

    /**
     * Equal
     *
     */
    public static function equal(string $attribute, mixed $value): string
    {
        return new Query('equal', $attribute, $value)->__toString();
    }

    /**
     * Not Equal
     *
     */
    public static function notEqual(string $attribute, mixed $value): string
    {
        return new Query('notEqual', $attribute, $value)->__toString();
    }

