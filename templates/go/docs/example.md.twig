{% for parameter in (method | parameters('all')) %}
{% if parameter.required %}
		{{ parameter | paramExample }},
{% else %}
		service.With{{ (method | methodName) | caseUcfirst }}{{ parameter.name | caseUcfirst }}({{ parameter | paramExample }}),
{% endif %}
{% endfor %}
	)
{% endif %}
	fmt.Println(response, err)
}
