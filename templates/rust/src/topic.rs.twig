//! Topic builder for {{ spec.info.title }} Push, level by level.
//!
//! ```
//! use {{ sdk.cratePackage | default('appwrite') | rustCrateName }}::topic;
//!
//! # fn main() -> Result<(), topic::TopicError> {
//! assert_eq!(topic::path(&["user", "123", "notification"])?.to_string(), "user/123/notification");
//! assert_eq!(topic::path(&["user"])?.any().path(&["notification"])?.to_string(), "user/+/notification");
//! assert_eq!(topic::path(&["org"])?.any().path(&["logs"])?.all().to_string(), "org/+/logs/#");
//! # Ok(())
//! # }
//! ```
//!
//! `any()` matches exactly one level and `all()` everything below, at any depth (including the
//! parent itself). `all()` ends the topic, so it returns a [`ResolvedTopic`], which has no methods
//! to append further levels.

use std::fmt;

/// Error returned by [`path`] and [`Topic::path`] for invalid levels.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct TopicError {
    message: String,
}

impl TopicError {
    fn new(message: impl Into<String>) -> Self {
        Self {
            message: message.into(),
        }
    }

    /// The error message
    pub fn message(&self) -> &str {
        &self.message
    }
}

impl fmt::Display for TopicError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str(&self.message)
    }
}

impl std::error::Error for TopicError {}

/// A topic being built. Start one with [`path`] or [`any`].
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Topic {
    levels: Vec<String>,
}

/// A topic ended by `all()`: nothing can be appended after the `#` wildcard.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ResolvedTopic {
    levels: Vec<String>,
}

/// Start a topic with the given levels, e.g. `topic::path(&["user", user_id])`.
pub fn path<S: AsRef<str>>(levels: &[S]) -> Result<Topic, TopicError> {
    Ok(Topic {
        levels: levels_of(levels)?,
    })
}

/// Start a topic with a single-level wildcard (`+`).
pub fn any() -> Topic {
    Topic {
        levels: vec!["+".to_string()],
    }
}

/// The multi-level wildcard alone (`#`): matches every topic.
pub fn all() -> ResolvedTopic {
    ResolvedTopic {
        levels: vec!["#".to_string()],
    }
}

impl Topic {
    /// Append the given levels.
    pub fn path<S: AsRef<str>>(mut self, levels: &[S]) -> Result<Topic, TopicError> {
        self.levels.extend(levels_of(levels)?);
        Ok(self)
    }

    /// Append a single-level wildcard (`+`): matches exactly one level.
    pub fn any(mut self) -> Topic {
        self.levels.push("+".to_string());
        self
    }

    /// Append the multi-level wildcard (`#`) and end the topic.
    pub fn all(mut self) -> ResolvedTopic {
        self.levels.push("#".to_string());
        ResolvedTopic {
            levels: self.levels,
        }
    }
}

impl fmt::Display for Topic {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str(&self.levels.join("/"))
    }
}

impl fmt::Display for ResolvedTopic {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str(&self.levels.join("/"))
    }
}

/// Validate the levels passed to `path()`: a non-empty list of non-empty strings, none holding
/// the level separator `/` or the wildcards `+` and `#` (use `any()` and `all()` for those).
fn levels_of<S: AsRef<str>>(levels: &[S]) -> Result<Vec<String>, TopicError> {
    if levels.is_empty() {
        return Err(TopicError::new("path() needs at least one level"));
    }
    levels
        .iter()
        .enumerate()
        .map(|(index, level)| {
            let level = level.as_ref();
            if level.is_empty() {
                return Err(TopicError::new(format!("empty level at index {}", index)));
            }
            if level.contains('/') {
                let parts = level
                    .split('/')
                    .map(|part| format!("'{}'", part))
                    .collect::<Vec<_>>()
                    .join(", ");
                return Err(TopicError::new(format!(
                    "\"{}\" contains \"/\", split it: path([{}])",
                    level, parts
                )));
            }
            if level == "+" {
                return Err(TopicError::new("\"+\" is reserved, use any()"));
            }
            if level.contains('+') {
                return Err(TopicError::new(format!(
                    "\"{}\" contains \"+\", use any() for wildcards",
                    level
                )));
            }
            if level == "#" {
                return Err(TopicError::new("\"#\" is reserved, use all()"));
            }
            if level.contains('#') {
                return Err(TopicError::new(format!(
                    "\"{}\" contains \"#\", use all() for wildcards",
                    level
                )));
            }
            Ok(level.to_string())
        })
        .collect()
}

#[cfg(test)]
mod tests {
    use super::*;

    fn message<S: AsRef<str>>(levels: &[S]) -> String {
        path(levels).unwrap_err().to_string()
    }

    #[test]
    fn test_paths() {
        assert_eq!(
            path(&["user", "123", "notification"]).unwrap().to_string(),
            "user/123/notification"
        );
        assert_eq!(
            path(&["org", "42", "user", "123"])
                .unwrap()
                .path(&["notification"])
                .unwrap()
                .to_string(),
            "org/42/user/123/notification"
        );
        assert_eq!(
            path(&[String::from("user"), String::from("123")])
                .unwrap()
                .to_string(),
            "user/123"
        );
    }

    #[test]
    fn test_any() {
        assert_eq!(
            path(&["user"])
                .unwrap()
                .any()
                .path(&["notification"])
                .unwrap()
                .to_string(),
            "user/+/notification"
        );
        assert_eq!(
            path(&["chat"])
                .unwrap()
                .any()
                .any()
                .path(&["message"])
                .unwrap()
                .to_string(),
            "chat/+/+/message"
        );
    }

    #[test]
    fn test_all() {
        assert_eq!(
            path(&["org"])
                .unwrap()
                .any()
                .path(&["logs"])
                .unwrap()
                .all()
                .to_string(),
            "org/+/logs/#"
        );
    }

    #[test]
    fn test_static_any_and_all() {
        assert_eq!(
            any().path(&["notification"]).unwrap().to_string(),
            "+/notification"
        );
        assert_eq!(any().to_string(), "+");
        assert_eq!(all().to_string(), "#");
    }

    #[test]
    fn test_errors() {
        assert_eq!(message::<&str>(&[]), "path() needs at least one level");
        assert_eq!(message(&["user", ""]), "empty level at index 1");
        assert_eq!(
            message(&["user/123"]),
            "\"user/123\" contains \"/\", split it: path(['user', '123'])"
        );
        assert_eq!(message(&["user", "+"]), "\"+\" is reserved, use any()");
        assert_eq!(
            message(&["user", "a+b"]),
            "\"a+b\" contains \"+\", use any() for wildcards"
        );
        assert_eq!(message(&["user", "#"]), "\"#\" is reserved, use all()");
        assert_eq!(
            message(&["user", "a#b"]),
            "\"a#b\" contains \"#\", use all() for wildcards"
        );
        assert_eq!(
            any().path(&["a+b"]).unwrap_err().message(),
            "\"a+b\" contains \"+\", use any() for wildcards"
        );
    }
}
