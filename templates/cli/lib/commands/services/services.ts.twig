import { Command } from "commander";
{% set hasLocationMethod = false %}
{% set hasFileParam = false %}
{% set hasObjectParam = false %}
{% set hasGraphQLInput = false %}
{% set hasQueryParam = (service | operations) | hasCliQueryParam %}
{% set enumNames = [] %}
{% for method in (service | operations) %}
{% if (method | methodType) == 'location' %}
{% set hasLocationMethod = true %}
{% endif %}
{% for parameter in (method | parameters('all')) %}
{% if (parameter | schemaType) == 'file' %}
{% set hasFileParam = true %}
{% endif %}
{% if cliIsGraphQLInput(parameter, method, service) %}
{% set hasGraphQLInput = true %}
{% elseif (parameter | schemaType) == 'object' %}
{% set hasObjectParam = true %}
{% endif %}
{% if (parameter | enumName) is not empty and (parameter | enumName) not in enumNames %}
{% set enumNames = enumNames|merge([(parameter | enumName)]) %}
{% endif %}
{% endfor %}
{% endfor %}
{% if hasLocationMethod %}
import fs from "fs";
{% endif %}
{% if hasFileParam %}
import { resolveFileParam } from "../utils/deployment.js";
{% endif %}
{% if hasQueryParam %}
import {
  buildQueries,
  collectQueryValue,
  parseDeprecatedWhereQuery,
  parseFilterQuery,
} from "../utils/query.js";
{% endif %}
{% set consoleOnlyMethods = consoleOnlyMethods | default([]) %}
{# Set when the service names its target in a header instead of the path, so it takes an ID flag. #}
{% set scope = resourceHeader | cliServiceScope %}
{% if scope %}
import { {{ scope.factory }} } from "../../sdks.js";
{% elseif isConsoleOnly %}
import { sdkForConsole } from "../../sdks.js";
{% elseif consoleOnlyMethods is not empty %}
import { sdkForConsole, sdkForProject } from "../../sdks.js";
{% else %}
import { sdkForProject } from "../../sdks.js";
{% endif %}
{% set fallbackHelpers = service | cliFallbackHelpers(service | operations) %}
{% if fallbackHelpers is not empty %}
import { {{ fallbackHelpers | join(', ') }} } from "../../console-fallback.js";
{% endif %}
import {
  actionRunner,
  commandDescriptions,
  success,
  parse,
  parseBool,
  parseInteger,
{% if hasObjectParam %}
  parseJsonObject,
{% endif %}
{% if hasGraphQLInput %}
  parseGraphQLParams,
{% endif %}
{% if service.name == 'teams' %}
  hint,
{% endif %}
} from "../../parser.js";
{% if sdk.test %}
{{ include('cli/base/mock.twig') }}
{% else %}
import { {{ service.name | caseUcfirst }} } from "@appwrite.io/console";
{% endif %}

{% if scope %}
// Every endpoint here targets one {{ scope.label | lower }}, so the client is built per
// command rather than cached across differing --{{ scope.flag }} values.
const get{{ service.name | caseUcfirst }}Client = async (
  {{ scope.idVar }}?: string,
): Promise<{{ service.name | caseUcfirst }}> =>
  new {{ service.name | caseUcfirst }}(await {{ scope.factory }}({{ scope.idVar }}));
{% else %}
let {{ service.name | caseCamel }}Client: {{ service.name | caseUcfirst }} | null = null;

const get{{ service.name | caseUcfirst }}Client = async (): Promise<{{ service.name | caseUcfirst }}> => {
  if (!{{ service.name | caseCamel }}Client) {
{% if service.name == 'teams' %}
    let sdkClient;
    try {
      sdkClient = await sdkForProject();
    } catch (e) {
      if (e instanceof Error && e.message.includes("Project is not set")) {
        hint(`To manage organization members, use the 'organization' command instead.`);
      }
      throw e;
    }
{% else %}
    const sdkClient = await {{ isConsoleOnly ? 'sdkForConsole' : 'sdkForProject' }}();
{% endif %}
    {{ service.name | caseCamel }}Client = new {{ service.name | caseUcfirst }}(sdkClient);
  }
  return {{ service.name | caseCamel }}Client;
};
{% endif %}
{% if consoleOnlyMethods is not empty %}

let {{ service.name | caseCamel }}ConsoleClient: {{ service.name | caseUcfirst }} | null = null;

// A few endpoints on this service are only served on the console project.
const get{{ service.name | caseUcfirst }}ConsoleClient = async (): Promise<{{ service.name | caseUcfirst }}> => {
  if (!{{ service.name | caseCamel }}ConsoleClient) {
    {{ service.name | caseCamel }}ConsoleClient = new {{ service.name | caseUcfirst }}(await sdkForConsole());
  }
  return {{ service.name | caseCamel }}ConsoleClient;
};
{% endif %}

export const {{ service.name | caseCamel }} = new Command("{{ service.name | caseLower }}")
{% if service.name == 'tablesDB' %}
  // TODO: Move CLI alias configuration to the API spec.
  .alias("tables-db")
{% endif %}
{% if service.description %}
  .description(commandDescriptions["{{ service.name | caseCamel }}"] || {{ service.description | stripMarkdown | json_encode | raw }})
{% else %}
  .description(commandDescriptions["{{ service.name | caseCamel }}"] ?? "")
{% endif %}
  .configureHelp({
    helpWidth: process.stdout.columns || 80,
  });

{% set seenCommands = [] %}
{% for method in (service | operations) %}
{% set commandName = (method | methodName) | caseKebab %}
{% if commandName not in seenCommands %}
{% set seenCommands = seenCommands|merge([commandName]) %}
{% set commandVar = service.name | caseCamel ~ (method | methodName) | caseUcfirst ~ 'Command' %}
{% set clientGetter = 'get' ~ (service.name | caseUcfirst) ~ (((method | methodName) | caseCamel) in consoleOnlyMethods ? 'Console' : '') ~ 'Client' %}
{% set hasScopedIdParam = false %}
{% for parameter in (method | parameters('all')) %}
{% if scope and parameter.name == scope.idVar %}
{% set hasScopedIdParam = true %}
{% endif %}
{% endfor %}
{% set scopedFlag = scope and not hasScopedIdParam %}
{% set clientCall = clientGetter ~ (scope ? '(' ~ scope.idVar ~ ')' : '()') %}
{% set query = method | cliQueryConfig %}
{% for target in method | cliCommandTargets(service) %}
{% if target.standalone %}
export const {{ target.var }} = new Command(`{{ commandName }}`)
  .configureHelp({
    helpWidth: process.stdout.columns || 80,
  })
{% else %}
const {{ target.var }} = {{ service.name | caseCamel }}
  .command(`{{ commandName }}`{% if target.hidden %}, { hidden: true }{% endif %})
{% endif %}
  .description(`{{ cliMethodDescription(method, service) | stripMarkdown | replace({'`': '\\`'}) | raw }}`)
{% for parameter in (method | parameters('all')) %}
{% set opt = getCliOption(parameter) %}
{% set optDescription = cliParameterDescription(parameter, method, service) | stripMarkdown | replace({'`': '\\`'}) %}
{% if parameter.name == 'queries' and (parameter | schemaType) == 'array' %}
{% set optDescription = query.rawDescriptionPrefix ~ ' ' ~ optDescription %}
{% endif %}
{% if opt.customParserCode is defined %}
  .{{ opt.method }}(
    `{{ opt.syntax | raw }}`,
    `{{ optDescription | raw }}`,
    {{ opt.customParserCode | raw }},
  )
{% elseif opt.parser %}
  .{{ opt.method }}(`{{ opt.syntax | raw }}`, `{{ optDescription | raw }}`, {{ opt.parser }})
{% else %}
  .{{ opt.method }}(`{{ opt.syntax | raw }}`, `{{ optDescription | raw }}`)
{% endif %}
{% endfor %}
{% if query.hasQueries %}
{% if query.hasFiltering %}
  .option(`--filter <expression>`, `Filter using a simple comparison expression. Repeat for multiple filters. Supports field=value, field!=value, field>value, field>=value, field<value, and field<=value.`, (value: string, previous: string[] | undefined) => collectQueryValue(parseFilterQuery(value), previous))
  .option(`--where <expression>`, `Deprecated. Use --filter instead. Filter using a simple comparison expression. Repeat for multiple filters.`, (value: string, previous: string[] | undefined) => collectQueryValue(parseDeprecatedWhereQuery(value), previous))
  .option(`--sort-asc <attribute>`, `Sort results by an attribute in ascending order. Repeat for multiple sort fields.`, (value: string, previous: string[] | undefined) => collectQueryValue(value, previous))
  .option(`--sort-desc <attribute>`, `Sort results by an attribute in descending order. Repeat for multiple sort fields.`, (value: string, previous: string[] | undefined) => collectQueryValue(value, previous))
{% endif %}
{% if query.hasPagination %}
  .option(`--limit <limit>`, `Maximum number of results to return.`, parseInteger)
  .option(`--offset <offset>`, `Number of results to skip.`, parseInteger)
{% endif %}
{% if query.hasCursors %}
  .option(`--cursor-after <id>`, `Return results after this cursor ID.`)
  .option(`--cursor-before <id>`, `Return results before this cursor ID.`)
{% endif %}
{% if query.hasSelect %}
  .option(`--select <attribute>`, `Attribute to include in the response. Repeat for multiple attributes.`, (value: string, previous: string[] | undefined) => collectQueryValue(value, previous))
{% endif %}
{% endif %}
{% if (method | methodType) == 'location' %}
  .requiredOption(`--destination <destination>`, `Path to save the file to.`)
{% endif %}
{% if scopedFlag %}
  .option(`--{{ scope.flag }} <{{ scope.flag }}>`, `{{ scope.label }} to act on. Defaults to the {{ scope.label | lower }} linked in {{ language.params.executableName|caseLower }}.config.json.`)
{% endif %}
  .action(
    actionRunner(
{% set params = [] %}
{% for parameter in (method | parameters('all')) %}
{% set params = params|merge([getCliVarName(parameter)]) %}
{% endfor %}
{% if query.hasQueries %}
{% set params = params|merge(query.extraParams) %}
{% endif %}
{% if scopedFlag %}
{% set params = params|merge([scope.idVar]) %}
{% endif %}
{% set hasParams = params | length > 0 %}
{% set actionParams = hasParams ? '{ ' ~ params | join(', ') ~ ((method | methodType) == 'location' ? ', destination' : '') ~ ' }' : ((method | methodType) == 'location' ? '{ destination }' : '') %}
{% set argExpressions = [] %}
{% for parameter in (method | parameters('all')) %}
{% if parameter.name == 'queries' and (parameter | schemaType) == 'array' %}
{% set argExpressions = argExpressions|merge(['buildQueries({ ' ~ query.builderParams | join(', ') ~ ' })']) %}
{% else %}
{% set argExpressions = argExpressions|merge([getCliArgExpression(parameter, method, service)]) %}
{% endif %}
{% endfor %}
{% if (method | methodType) == 'location' %}
      async ({{ actionParams }}) => {
        const url = await (await {{ clientCall }}).{{ (method | methodName) | caseCamel }}({{ argExpressions | join(', ') | raw }});
        const response = await fetch(url);
        if (!response.ok) {
          throw new Error(`Failed to download file: ${response.status} ${response.statusText}`);
        }
        const buffer = Buffer.from(await response.arrayBuffer());
        fs.writeFileSync(destination, buffer);
        success(`File saved to ${destination}`);
      },
{% elseif (method | methodType) == 'webAuth' %}
      async ({{ actionParams }}) => {
        const url = (await {{ clientCall }}).{{ (method | methodName) | caseCamel }}({{ argExpressions | join(', ') | raw }});
        if (url) console.log(url);
      },
{% elseif target.implementation %}
{# The helper resolves the scoped resource itself, so it takes the ID directly. #}
{% set implementationArgs = (scopedFlag ? [scope.idVar] : [])|merge(argExpressions) %}
      async ({{ actionParams }}) =>
        parse(await {{ target.implementation }}({{ implementationArgs | join(', ') | raw }})),
{% elseif hasParams %}
      async ({{ actionParams }}) =>
        parse(await (await {{ clientCall }}).{{ (method | methodName) | caseCamel }}({{ argExpressions | join(', ') | raw }})),
{% else %}
      async () => parse(await (await {{ clientCall }}).{{ (method | methodName) | caseCamel }}()),
{% endif %}
    ),
  );

{% endfor %}
{% if service.name == 'projects' and (method | methodName) == 'list' %}
({{ commandVar }} as Command & { outputFields?: string[] }).outputFields = ["name", "$id", "region", "status"];
{% endif %}

{% endif %}
{% endfor %}
