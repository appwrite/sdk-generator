{% if sdk.test %}
package cmd

// The conformance fixture has no project OAuth provider commands.
{% else %}
package cmd

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"os"
	"path/filepath"
	"reflect"
	"strings"
	"testing"

	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/app"
)

func TestOAuthProviderCommands(t *testing.T) {
	home := t.TempDir()
	t.Setenv("HOME", home)
	t.Setenv("USERPROFILE", home)
	t.Chdir(home)
	originalChecker := newUpdateChecker
	newUpdateChecker = func() updateAvailabilityChecker { return nil }
	originalFlags := *app.Flags()
	t.Cleanup(func() {
		newUpdateChecker = originalChecker
		*app.Flags() = originalFlags
	})

	providers := []struct{ command, path string }{
		{"update-o-auth-2-kakao", "/v1/project/oauth2/kakao"},
		{"update-o-auth-2-tik-tok", "/v1/project/oauth2/tiktok"},
	}
	cases := []struct {
		name      string
		flags     []string
		body      map[string]interface{}
		wantError bool
	}{
		{name: "omitted", body: map[string]interface{}{}},
		{
			name:  "explicit zero values",
			flags: []string{"--client-id=", "--client-secret=", "--enabled=false"},
			body:  map[string]interface{}{"clientId": "", "clientSecret": "", "enabled": false},
		},
		{
			name:      "API error",
			flags:     []string{"--client-id=bad"},
			body:      map[string]interface{}{"clientId": "bad"},
			wantError: true,
		},
	}
	for _, provider := range providers {
		for _, test := range cases {
			t.Run(provider.command+"/"+test.name, func(t *testing.T) {
				called := make(chan struct{}, 1)
				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
					called <- struct{}{}
					if r.Method != "PATCH" || r.URL.Path != provider.path {
						t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
					}
					if r.Header.Get("X-Appwrite-Project") != "test-project" || r.Header.Get("X-Appwrite-Key") != "test-key" {
						t.Error("project authentication headers missing")
					}
					if r.Header.Get("Content-Type") != "application/json" {
						t.Error("JSON content type missing")
					}
					var body map[string]interface{}
					if err := json.NewDecoder(r.Body).Decode(&body); err != nil || !reflect.DeepEqual(body, test.body) {
						t.Errorf("body = %#v, error = %v; want %#v", body, err, test.body)
					}
					w.Header().Set("Content-Type", "application/json")
					if test.wantError {
						w.WriteHeader(http.StatusBadRequest)
						w.Write([]byte(`{"message":"invalid provider","code":400,"type":"provider_invalid"}`))

						return
					}
					w.Write([]byte(`{"enabled":false,"newField":"preserved"}`))
				}))
				defer server.Close()

				directory := filepath.Join(home, "."+app.ExecutableName)
				if err := os.MkdirAll(directory, 0o755); err != nil {
					t.Fatal(err)
				}
				preferences := `{"current":"test","test":{"key":"test-key","endpoint":"` + server.URL + `/v1"}}`
				if err := os.WriteFile(filepath.Join(directory, "prefs.json"), []byte(preferences), 0o600); err != nil {
					t.Fatal(err)
				}
				t.Setenv("APPWRITE_ENDPOINT", server.URL+"/v1")

				root := NewRootCommand()
				root.SetArgs(append([]string{"project", provider.command, "--project-id=test-project", "--raw"}, test.flags...))
				stdout, err := os.CreateTemp(t.TempDir(), "stdout")
				if err != nil {
					t.Fatal(err)
				}
				defer stdout.Close()
				originalStdout := os.Stdout
				os.Stdout = stdout
				t.Cleanup(func() { os.Stdout = originalStdout })
				_, runErr := Execute(root)
				os.Stdout = originalStdout
				if test.wantError {
					if runErr == nil || !strings.Contains(runErr.Error(), "invalid provider") {
						t.Fatalf("expected API error, got %v", runErr)
					}
				} else {
					if runErr != nil {
						t.Fatal(runErr)
					}
					printed, err := os.ReadFile(stdout.Name())
					if err != nil {
						t.Fatal(err)
					}
					var result map[string]interface{}
					if err := json.Unmarshal(printed, &result); err != nil || result["newField"] != "preserved" || result["enabled"] != false {
						t.Fatalf("raw response lost fields: %s (error %v)", printed, err)
					}
				}
				select {
				case <-called:
				default:
					t.Fatal("command did not send a request")
				}
			})
		}
	}
}
{% endif %}
