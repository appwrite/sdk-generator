	{%- endif -%}
{% for parameter in (method | parameters('all')) %}
	{%- if (parameter | typeName) ends with "InputFile"  -%}
		{%- set requireFilesPkg = true -%}
	{%- endif -%}
	{%- if (parameter | schemaModel) is not empty -%}
		{%- set requireModelsPkg = true -%}
	{%- endif -%}
{% endfor %}
{%- endfor -%}
