            {{ parameter.name | caseCamel | escapeSwiftKeyword }}: {{ parameter.name | caseCamel | escapeSwiftKeyword }},
            {%~ endfor %}
            nestedType: [String: AnyCodable].self
            {%~ if 'multipart/form-data' in (method | consumes) %}
            onProgress: onProgress
