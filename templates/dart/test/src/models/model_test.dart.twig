  {% endfor %}{% endif %}){% endif %}{% else %}{% if (property | schemaType) == 'object' and property.additionalProperties %}Map<String, dynamic>{% else %}{{property | typeName}}{% endif %}{% endif %}{% endmacro %}
import 'package:{{ language.params.packageName }}/models.dart';
{% if (definition.properties | filter(p => p.enum) | length > 0) or (definition.properties | filter(p => p.required and p.sub_schema and definitions[p.sub_schema] and (definitions[p.sub_schema].properties | filter(sp => sp.required and sp.enum) | length > 0)) | length > 0) %}
