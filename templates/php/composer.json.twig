{
    "name": "{{ language.params.composerVendor }}/{{ language.params.composerPackage }}",
    "description": "{{ sdk.shortDescription }}",
    "type": "library",
    "license": "{{ spec.info.license.name }}",
    "support": {
        "url": "{{ spec.info.contact.url }}",
        "email": "{{ spec.info.contact.email }}"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "autoload": {
        "psr-4": {
            "{{ namespace | caseNamespace | escapeJson }}\\": "src/{{ namespace | caseNamespacePath }}"
        }
    },
    "require": {
        "php": ">=8.2.0",
        "ext-curl": "*",
        "ext-json": "*"
{%- if globalHeaders | hasBearerAuth %},
        "adhocore/jwt": "^1.1"
{%- endif %}

    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "mockery/mockery": "1.6.13"
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
