    }

    pub fn or<I, S>(mut self, queries: I) -> Self
    where
        I: IntoIterator<Item = S>,
        S: AsRef<str>,
    {
        self.queries.push(Query::or(queries));
        self
    }

    pub fn and<I, S>(mut self, queries: I) -> Self
    where
        I: IntoIterator<Item = S>,
        S: AsRef<str>,
    {
        self.queries.push(Query::and(queries));
        self
    }

    pub fn regex<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::regex(attribute, value));
