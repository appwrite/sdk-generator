    }

    pub fn distance_equal<S: Into<String>, V: Into<Value>>(mut self, attribute: S, values: V, distance: impl Into<Value>, meters: bool) -> Self {
        self.queries.push(Query::distance_equal(attribute, values, distance, meters));
