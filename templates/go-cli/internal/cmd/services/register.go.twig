package services

import (
	"github.com/spf13/cobra"
)

{% if sdk.test %}
// mockResult is what every mock service returns. The e2e suite asserts on the
// printed `result` string, so the shape only has to survive rendering.
type mockResult struct {
	Result string `json:"result"`
}

{% endif %}
// Register attaches every generated service command to root, plus the methods
// promoted to top-level commands.
func Register(root *cobra.Command) {
{% for service in spec.services %}
	root.AddCommand(New{{ service.name | caseUcfirst }}Command())
{% endfor %}

{% for service in spec.services %}
{% if service | cliTopLevelAliases is not empty %}
	root.AddCommand(New{{ service.name | caseUcfirst }}RootCommands()...)
{% endif %}
{% endfor %}
}
