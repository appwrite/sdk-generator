package {{ sdk.namespace | caseDot }}.services

import android.net.Uri
{% if serviceFeatures.webAuth %}
import androidx.activity.ComponentActivity
{% endif %}
import {{ sdk.namespace | caseDot }}.Client
import {{ sdk.namespace | caseDot }}.Service
{% if serviceFeatures.webAuth %}
import {{ sdk.namespace | caseDot }}.WebAuthComponent
{% endif %}
import {{ sdk.namespace | caseDot }}.exceptions.{{ spec.info.title | caseUcfirst }}Exception
import {{ sdk.namespace | caseDot }}.extensions.classOf
{% if definitions is not empty %}
import {{ sdk.namespace | caseDot }}.models.*
{% endif %}
import okhttp3.Cookie
{% if (serviceFeatures.webAuth or serviceFeatures.location) %}
import okhttp3.HttpUrl
import okhttp3.HttpUrl.Companion.toHttpUrl
{% endif %}
import java.io.File

/**
 *{% if service.description is not empty %} {{ service.description | replace({"\n": "\n * "}) | kotlinDoc }}{% endif %}
 */
class {{ service.name | caseUcfirst }}(client: Client) : Service(client) {
{% for method in (service | operations) %}
{% set allParameters = (method | parameters('all')) %}
{% set apiParameters = (method | parameters('query')) | merge((method | parameters('body'))) %}
{% set pathParameters = (method | parameters('path')) %}
{% set securityQueries = (method | securityQueries) %}
    /**
     * {{ method.description | replace({"\n": "\n     * "}) | kotlinDoc }}
     *
    {%~ for parameter in (method | parameters('all')) %}
     * @param {{ parameter.name | caseCamel }} {{ parameter.description | raw }}
    {%~ endfor %}
    {%~ if (method | methodType) != "webAuth" %}
     * @return [{{ method | returnType(spec, sdk.namespace | caseDot) | raw }}]
    {%~ endif %}
     */
    {%~ if method.deprecated %}
    {%~ if (method | appwrite('deprecated', {})['since'] ?? '') and (method | appwrite('deprecated', {})['replaceWith'] ?? '') %}
    @Deprecated(
        message = "This API has been deprecated since {{ (method | appwrite('deprecated', {})['since'] ?? '') }}. Please use `{{ (method | appwrite('deprecated', {})['replaceWith'] ?? '') | capitalizeFirst }}` instead.",
        replaceWith = ReplaceWith("{{ sdk.namespace | caseDot }}.services.{{ (method | appwrite('deprecated', {})['replaceWith'] ?? '') | capitalizeFirst }}")
    )
    {%~ else %}
    @Deprecated(
        message = "This API has been deprecated."
    )
    {%~ endif %}
    {%~ endif %}
    {%~ if (method | parameters('all')) | reduce((carry, param) => carry or not param.required) %}
    @JvmOverloads
    {%~ endif %}
    {%~ if allParameters is empty and (method | methodType) != "webAuth" and not ((method | responseModel) | hasGenericType(spec)) and 'multipart/form-data' not in (method | consumes) %}
    suspend fun {{ (method | methodName) | caseCamel }}(): {{ method | returnType(spec, sdk.namespace | caseDot) | raw }} {
    {%~ else %}
    suspend fun {% if (method | responseModel) | hasGenericType(spec) %}{{ '<T>' | raw }} {% endif %}{{ (method | methodName) | caseCamel }}(
        {%~ if (method | methodType) == "webAuth" %}
        activity: ComponentActivity,
        {%~ endif %}
        {%~ for parameter in allParameters %}
        {{ parameter.name | caseCamel }}: {{ parameter | typeName }}{%~ if not parameter.required or (parameter | schemaNullable) %}? = null{% endif %},
        {%~ endfor %}
        {%~ if (method | responseModel) | hasGenericType(spec) %}
        nestedType: Class<T>,
        {%~ endif %}
        {%~ if 'multipart/form-data' in (method | consumes) %}
        onProgress: ((UploadProgress) -> Unit)? = null
        {%~ endif %}
    ){% if (method | methodType) != "webAuth" %}: {{ method | returnType(spec, sdk.namespace | caseDot) | raw }}{% endif %} {
    {%~ endif %}
        val apiPath = {% if pathParameters is empty and securityQueries is empty %}"{{ method.path }}"{% else %}("{{ method.path }}"
        {%~ for parameter in pathParameters %}
            .replace("{{ '{' ~ parameter.name ~ '}' }}", {% if (parameter.extensions['x-sdk-source']|default('')) == 'security' %}client.config["{{ parameter.extensions['x-sdk-config'] | caseCamel }}"].orEmpty(){% else %}{{ parameter.name | caseCamel }}{% if (parameter | enumValues) is not empty %}.value{% endif %}{% endif %})
        {%~ endfor %}
            {%~ for security in securityQueries %}
            + "{% if loop.first %}?{% else %}&{% endif %}{{ security.name }}=${java.net.URLEncoder.encode(client.config.get("{{ security.name | caseCamel }}").orEmpty(), "UTF-8")}"
            {%~ endfor %}
        ){% endif %}

        {%~ if apiParameters is empty and (method | methodType) != 'webAuth' %}
        val apiParams = mutableMapOf<String, Any?>()
        {%~ else %}
        val apiParams = mutableMapOf<String, Any?>(
        {%~ for parameter in apiParameters %}
            "{{ parameter.name }}" to {{ parameter.name | caseCamel }},
        {%~ endfor %}
        {%~ if (method | methodType) == 'webAuth' %}
        {%~ if [(method | securitySchemes)] | length > 0 %}
        {%~ for node in [(method | securitySchemes)] %}
        {%~ for key,header in node | keys %}
            "{{ header | caseLower }}" to client.config["{{ header | caseLower }}"],
        {%~ endfor %}
        {%~ endfor %}
        {%~ endif %}
        {%~ endif %}
        )
        {%~ endif %}
        {%~ if (method | methodType) == 'webAuth' %}
        val apiQuery = mutableListOf<String>()
        apiParams.forEach {
            when (it.value) {
                null -> {
                    return@forEach
                }
                is List<*> -> {
                    (it.value as List<*>).forEach { v ->
                        apiQuery.add("${it.key}[]=${v.toString()}")
                    }
                }
                else -> {
                    apiQuery.add("${it.key}=${it.value.toString()}")
                }
            }
        }

        val apiUrl = Uri.parse("${client.endpoint}${apiPath}?${apiQuery.joinToString("&")}")
        val callbackUrlScheme = "{{ spec.info.title | caseLower }}-callback-${client.config["project"]}"

        WebAuthComponent.authenticate(activity, apiUrl, callbackUrlScheme) {
            if (it.isFailure) {
                throw it.exceptionOrNull()!!
            }

            val resultUrl = it.getOrNull()!!
            val uri = Uri.parse(resultUrl)
            val key = uri.getQueryParameter("key")
            val secret = uri.getQueryParameter("secret")
            if (key == null || secret == null) {
                throw {{ spec.info.title | caseUcfirst }}Exception("Authentication cookie missing!")
            }
            val cookie = Cookie.Builder()
                .name(key)
                .value(secret)
                .domain(Uri.parse(client.endpoint).host!!)
                .httpOnly()
                .build()

            client.http.cookieJar.saveFromResponse(
                client.endpoint.toHttpUrl(),
                listOf(cookie)
            )
        }
        {%~ elseif (method | methodType) == 'location' %}
        {%~ if (method | securityHeaders) is empty and (method | methodHeaders) is empty %}
        val apiHeaders = mutableMapOf<String, String>()
        {%~ else %}
        val apiHeaders = mutableMapOf<String, String>(
        {%~ for key, security in (method | securityHeaders) %}
            "{{ security.name }}" to client.config["{{ key | caseCamel }}"].orEmpty(),
        {%~ endfor %}
        {%~ for key, header in (method | methodHeaders) %}
            "{{ key }}" to "{{ header }}",
        {%~ endfor %}
        )
        {%~ endif %}
        return client.call(
            "{{ method.method.value | caseUpper }}",
            apiPath,
            headers = apiHeaders,
            params = apiParams,
            responseType = {{ method | returnType(spec, sdk.namespace | caseDot) | raw }}::class.java
        )
        {%~ else %}
        {%~ if (method | securityHeaders) is empty and (method | methodHeaders) is empty %}
        val apiHeaders = mutableMapOf<String, String>()
        {%~ else %}
        val apiHeaders = mutableMapOf<String, String>(
        {%~ for key, security in (method | securityHeaders) %}
            "{{ security.name }}" to client.config["{{ key | caseCamel }}"].orEmpty(),
        {%~ endfor %}
        {%~ for key, header in (method | methodHeaders) %}
            "{{ key }}" to "{{ header }}",
        {%~ endfor %}
        )
        {%~ endif %}
        {%~ if (method | responseModel) %}
        val converter: (Any) -> {{ method | returnType(spec, sdk.namespace | caseDot) | raw }} = {
        {%~ if (method | responseModel) == 'any' %}
            it
        {%~ elseif (method | getValidResponseModels)|length > 1 %}
{% set hasResponseDiscriminator = (method | responseDiscriminator) is not empty %}
{% set responseDiscriminator = (method | responseDiscriminator) %}
        {%~ if hasResponseDiscriminator %}
            val responseMap = it as? Map<String, Any>
                ?: throw Exception("Unable to match response to any expected response model")
            when {
{% for modelName, conditions in responseDiscriminator %}
                {% for field, expectedValue in conditions %}responseMap["{{ field | escapeDollarSign }}"]?.toString() == "{{ expectedValue | escapeDollarSign }}"{% if not loop.last %} && {% endif %}{% endfor %} -> {{sdk.namespace | caseDot}}.models.{{ modelName | caseUcfirst }}.from(map = responseMap)
{% endfor %}
                else -> throw Exception("Unable to match response to any expected response model")
            }
        {%~ else %}
            @Suppress("UNCHECKED_CAST")
            {{sdk.namespace | caseDot}}.models.{{ (method | responseModel) | caseUcfirst }}.from(map = it as Map<String, Any>{% if (method | responseModel) | hasGenericType(spec) %}, nestedType{% endif %})
        {%~ endif %}
        {%~ else %}
            @Suppress("UNCHECKED_CAST")
            {{sdk.namespace | caseDot}}.models.{{ (method | responseModel) | caseUcfirst }}.from(map = it as Map<String, Any>{% if (method | responseModel) | hasGenericType(spec) %}, nestedType{% endif %})
        {%~ endif %}
        }
        {%~ endif %}
        {%~ if 'multipart/form-data' in (method | consumes) %}
{% set uploadIdParameter = method | uploadIdParameter %}
        val idParamName: String? = {% if uploadIdParameter %}"{{ uploadIdParameter.name }}"{% else %}null{% endif %}

        {%~ for parameter in (method | parameters('all')) %}
        {%~ if (parameter | schemaType) == 'file' %}
        val paramName = "{{ parameter.name }}"
        {%~ endif %}
        {%~ endfor %}
        return client.chunkedUpload(
            apiPath,
            apiHeaders,
            apiParams,
            responseType = {{ method | returnType(spec, sdk.namespace | caseDot) | raw }}::class.java,
            {%~ if (method | responseModel) %}
            converter,
            {%~ endif %}
            paramName,
            idParamName,
            onProgress,
        )
        {%~ else %}
        return client.call(
            "{{ method.method.value | caseUpper }}",
            apiPath,
            apiHeaders,
            apiParams,
            {%~ if (method | responseModel) | hasGenericType(spec) %}
            responseType = classOf(),
            {%~ else %}
            responseType = {{ method | returnType(spec, sdk.namespace | caseDot) | raw }}::class.java,
            {%~ endif %}
            {%~ if (method | responseModel) %}
            converter,
            {%~ endif %}
        )
        {%~ endif %}
        {%~ endif %}
    }
    {%~ if (method | responseModel) | hasGenericType(spec) %}

    /**
     * {{ method.description | replace({"\n": "\n     * "}) | kotlinDoc }}
     *
    {%~ for parameter in (method | parameters('all')) %}
     * @param {{ parameter.name | caseCamel }} {{ parameter.description | raw }}
    {%~ endfor %}
    {%~ if (method | methodType) != "webAuth" %}
     * @return [{{ method | returnType(spec, sdk.namespace | caseDot) | raw }}]
    {%~ endif %}
     */
    {%~ if method.deprecated %}
    {%~ if (method | appwrite('deprecated', {})['since'] ?? '') and (method | appwrite('deprecated', {})['replaceWith'] ?? '') %}
    @Deprecated(
        message = "This API has been deprecated since {{ (method | appwrite('deprecated', {})['since'] ?? '') }}. Please use `{{ (method | appwrite('deprecated', {})['replaceWith'] ?? '') | capitalizeFirst }}` instead.",
        replaceWith = ReplaceWith("{{ sdk.namespace | caseDot }}.services.{{ (method | appwrite('deprecated', {})['replaceWith'] ?? '') | capitalizeFirst }}")
    )
    {%~ else %}
    @Deprecated(
        message = "This API has been deprecated."
    )
    {%~ endif %}
    {%~ endif %}
    {%~ if (method | parameters('all')) | reduce((carry, param) => carry or not param.required) %}
    @JvmOverloads
    {%~ endif %}
    @Throws({{ spec.info.title | caseUcfirst }}Exception::class)
    {%~ if allParameters is empty and (method | methodType) != "webAuth" and 'multipart/form-data' not in (method | consumes) %}
    suspend fun {{ (method | methodName) | caseCamel }}(): {{ method | returnType(spec, sdk.namespace | caseDot, 'Map<String, Any>') | raw }} = {{ (method | methodName) | caseCamel }}(
    {%~ else %}
    suspend fun {{ (method | methodName) | caseCamel }}(
        {%~ if (method | methodType) == "webAuth" %}
        activity: ComponentActivity,
        {%~ endif %}
        {%~ for parameter in allParameters %}
        {{ parameter.name | caseCamel }}: {{ parameter | typeName }}{%~ if not parameter.required or (parameter | schemaNullable) %}? = null{% endif %},
        {%~ endfor %}
        {%~ if 'multipart/form-data' in (method | consumes) %}
        onProgress: ((UploadProgress) -> Unit)? = null
        {%~ endif %}
    ): {{ method | returnType(spec, sdk.namespace | caseDot, 'Map<String, Any>') | raw }} = {{ (method | methodName) | caseCamel }}(
    {%~ endif %}
        {%~ if (method | methodType) == "webAuth" %}
        activity,
        {%~ endif %}
        {%~ for parameter in (method | parameters('all')) %}
        {{ parameter.name | caseCamel }},
        {%~ endfor %}
        {%~ if (method | responseModel) | hasGenericType(spec) %}
        nestedType = classOf(),
        {%~ endif %}
        {%~ if 'multipart/form-data' in (method | consumes) %}
        onProgress = onProgress
        {%~ endif %}
    )
    {%~ endif %}
    {%~ if not loop.last %}

    {%~ endif %}
    {%~ endfor %}
}
