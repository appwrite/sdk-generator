import Foundation
import MQTTNIO
import NIOCore

#if canImport(UserNotifications)
    import UserNotifications
#endif

/// A message delivered on a subscribed topic — the MQTT push analog of a realtime event.
public struct PushMessage {
    /// The topic the message was published to.
    public let topic: String

    /// The raw message payload.
    public let payload: [UInt8]

    /// The MQTT quality of service the message was delivered with.
    public let qos: Int

    /// The payload decoded as a UTF-8 string.
    public var string: String {
        String(decoding: payload, as: UTF8.self)
    }
}

/// {{ spec.info.title | caseUcfirst }} native push service — the realtime analog delivered over an MQTT broker,
/// without FCM or APNS. Built on SwiftNIO (MQTTNIO), the same stack the rest of the SDK's
/// networking uses.
///
/// Mirrors the realtime service: `Push(client).subscribe(topic, callback:)` opens the
/// connection lazily and returns an unsubscribe callable. The credential is read off the
/// client — set a JWT or session on it (`Client.setJWT` / `Client.setSession`), the same
/// way every other service reads auth.
///
///     let push = Push(client)
///     let unsubscribe = try await push.subscribe("user/123/#") { message in
///         print("\(message.topic): \(message.string)")
///     }
///     // ...later
///     unsubscribe()
open class Push: Service {
    // Fixed keep-alive (PINGREQ interval) in seconds — not exposed as an option.
    private static let keepAliveSeconds: UInt16 = 60

    private let host: String
    private let port: Int
    private let tls: Bool
    private let tlsInsecure: Bool

    // Replay (reliable delivery): QoS 1 + clean start off so the broker keeps this client's
    // replay cursor. Default on; toggle with setReplayMessages().
    private var replay = true

    // Resolved once per instance: a reconnect rebuilds the MQTTClient, and if each rebuild drew
    // a new random id the broker would treat it as a new session and drop this client's replay
    // cursor. A stable id from Client.setPushClientId() resumes replay across restarts;
    // otherwise one is generated. Reusing one id keeps it stable.
    private let resolvedClientId: String

    private var background = false
    private var backgroundTitle: String?

    private var mqtt: MQTTClient?
    private var connecting: Task<MQTTClient, Swift.Error>?

    private var onOpenCb: (() -> Void)?
    private var onCloseCb: (() -> Void)?
    private var onErrorCb: ((Swift.Error) -> Void)?

    // Guards the mutable state below; the publish listener fires on an event loop.
    private let sync = DispatchQueue(label: "{{ spec.info.title | caseLower }}.push")

    // Local id -> (topic filter, callback). The id is never sent to the broker; it
    // only lets the same topic carry more than one callback.
    private var subscriptions: [String: (filter: String, callback: (PushMessage) -> Void)] = [:]

    public init(_ client: Client, tlsInsecure: Bool = false) {
        // The broker location is taken from Client.setPushEndpoint() when set (e.g.
        // "mqtts://host:8883"), otherwise from the regular endpoint.
        let pushEndpoint = client.endPointPush ?? client.endPoint
        let url = URL(string: pushEndpoint)
        self.host = url?.host ?? "localhost"
        // Secure by default: TLS on when the endpoint scheme is secure (https/wss/mqtts/ssl),
        // so the credential in the CONNECT packet is not sent in the clear.
        let secure = ["https", "wss", "mqtts", "ssl"].contains(url?.scheme ?? "")
        self.tls = secure
        // Take the port from the push endpoint only (a regular http/https endpoint's port is
        // the API port, not the broker's); otherwise fall back to the MQTT default.
        let pushPort = client.endPointPush != nil ? url?.port : nil
        self.port = pushPort ?? (secure ? 8883 : 1883)
        self.tlsInsecure = tlsInsecure
        let project = client.config["project"] ?? ""
        let pushClientId = client.pushClientId
        self.resolvedClientId = (pushClientId?.isEmpty == false)
            ? pushClientId!
            : "appwrite-\(project)-\(UUID().uuidString.prefix(8))"
        super.init(client)
    }

    // QoS for subscribe, chosen by replay mode: at-least-once when replaying missed
    // messages, at-most-once when not.
    private var defaultQos: MQTTQoS {
        replay ? .atLeastOnce : .atMostOnce
    }

    /// Toggle replay of messages missed while disconnected. `true` (the default) subscribes
    /// at QoS 1 with clean start off, so the broker keeps this client's replay cursor and
    /// redelivers missed messages on reconnect; `false` uses QoS 0 and a clean session. May
    /// be called any time: if already connected in the other mode it reconnects and
    /// resubscribes at the new QoS.
    @discardableResult
    public func setReplayMessages(_ enabled: Bool = true) -> Self {
        if enabled == replay {
            return self
        }
        replay = enabled
        if sync.sync(execute: { self.mqtt }) != nil {
            Task { try? await reconnect() }
        }
        return self
    }

    /// Enable (or disable) surfacing every delivered message as a local notification via
    /// `UserNotifications`, requesting authorization on the spot.
    ///
    /// Note: iOS cannot keep a raw MQTT socket alive once the app is fully killed
    /// (that requires APNs) — this covers delivery while the app is running or briefly
    /// backgrounded. Presentation while the app is in the foreground follows the host
    /// app's `UNUserNotificationCenterDelegate`. `setBackground(false)` turns it off.
    ///
    /// - Parameters:
    ///   - enabled: Whether to show notifications. Defaults to true.
    ///   - title: Fixed notification title. Defaults to the message topic.
    @discardableResult
    public func setBackground(_ enabled: Bool = true, title: String? = nil) -> Self {
        background = enabled
        if enabled {
            backgroundTitle = title
            #if canImport(UserNotifications)
                UNUserNotificationCenter.current().requestAuthorization(options: [.alert, .sound, .badge]) { _, _ in }
            #endif
        }
        return self
    }

    /// Register a callback invoked when the connection opens (CONNACK success).
    @discardableResult
    public func onOpen(_ callback: @escaping () -> Void) -> Self {
        onOpenCb = callback
        return self
    }

    /// Register a callback invoked when the connection closes.
    @discardableResult
    public func onClose(_ callback: @escaping () -> Void) -> Self {
        onCloseCb = callback
        return self
    }

    /// Register a callback invoked on a connection error.
    @discardableResult
    public func onError(_ callback: @escaping (Swift.Error) -> Void) -> Self {
        onErrorCb = callback
        return self
    }

    // Reconnect and resubscribe active topics at the current QoS — used when the replay
    // mode changes while the connection is open (clean start is a CONNECT-level flag).
    private func reconnect() async throws {
        let filters = sync.sync {
            Array(Set(subscriptions.values.map(\.filter)))
        }
        close()
        let mqtt = try await connect()
        if !filters.isEmpty {
            _ = try await mqtt.v5.subscribe(
                to: filters.map { MQTTSubscribeInfoV5(topicFilter: $0, qos: defaultQos) }
            )
        }
    }

    /// Subscribe to a single topic. Returns an unsubscribe callable.
    @discardableResult
    public func subscribe(_ topic: String, callback: @escaping (PushMessage) -> Void) async throws -> () -> Void {
        try await subscribe([topic], callback: callback)
    }

    /// Subscribe to one or more topics. Returns an unsubscribe callable.
    ///
    /// Suspends until the broker has acknowledged the SUBSCRIBE (SUBACK): the broker
    /// only starts routing a topic once its subscription is registered, so publishing
    /// before the ack races the message ahead of the subscription and it is dropped
    /// (no retained replay on MQTT).
    @discardableResult
    public func subscribe(_ topics: [String], callback: @escaping (PushMessage) -> Void) async throws -> () -> Void {
        let mqtt = try await connect()

        var ids: [String] = []
        for topic in topics {
            let id = UUID().uuidString
            ids.append(id)
            sync.sync { subscriptions[id] = (topic, callback) }
        }

        do {
            _ = try await mqtt.v5.subscribe(
                to: topics.map { MQTTSubscribeInfoV5(topicFilter: $0, qos: defaultQos) }
            )
        } catch {
            // The SUBSCRIBE failed; roll this call's registrations back (and drop any broker
            // filter no other local subscriber owns) so a failed subscribe leaks no callback.
            let filters = sync.sync { () -> [String] in
                var removed: [String] = []
                for id in ids {
                    if let entry = subscriptions.removeValue(forKey: id) {
                        let stillUsed = subscriptions.values.contains { $0.filter == entry.filter }
                        if !stillUsed {
                            removed.append(entry.filter)
                        }
                    }
                }
                return removed
            }
            if !filters.isEmpty {
                try? await mqtt.v5.unsubscribe(from: filters)
            }
            throw error
        }

        return { [weak self] in
            guard let self else { return }
            let filters = self.sync.sync { () -> [String] in
                var removed: [String] = []
                for id in ids {
                    if let entry = self.subscriptions.removeValue(forKey: id) {
                        // Only unsubscribe the broker filter once its last local callback is gone.
                        let stillUsed = self.subscriptions.values.contains { $0.filter == entry.filter }
                        if !stillUsed {
                            removed.append(entry.filter)
                        }
                    }
                }
                return removed
            }
            let client: MQTTClient? = self.sync.sync { self.mqtt }
            if let client, !filters.isEmpty {
                Task { try? await client.v5.unsubscribe(from: filters) }
            }
            if self.sync.sync(execute: { self.subscriptions.isEmpty }) {
                self.close()
            }
        }
    }

    /// Tear down the connection and drop all active subscriptions.
    public func close() {
        let client = sync.sync { () -> MQTTClient? in
            let existing = mqtt
            mqtt = nil
            connecting?.cancel()
            connecting = nil
            return existing
        }
        guard let client else { return }
        _ = try? client.disconnect().wait()
        try? client.syncShutdownGracefully()
    }

    private func connect() async throws -> MQTTClient {
        if let existing = sync.sync(execute: { self.mqtt }) {
            return existing
        }
        // Single-flight: concurrent callers await one in-flight connection instead of
        // each opening its own (and never see a client before its CONNACK succeeds).
        let task: Task<MQTTClient, Swift.Error> = sync.sync {
            if let inflight = self.connecting {
                return inflight
            }
            let created = Task { () throws -> MQTTClient in
                do {
                    let client = try await self.open()
                    self.sync.sync {
                        self.mqtt = client
                        self.connecting = nil
                    }
                    return client
                } catch {
                    self.sync.sync { self.connecting = nil }
                    throw error
                }
            }
            self.connecting = created
            return created
        }
        return try await task.value
    }

    private func open() async throws -> MQTTClient {
        // Read the credential set on the client (via Client.setJWT / setSession).
        let authMethod: String
        let credential: String
        if let jwt = client.config["jwt"], !jwt.isEmpty {
            authMethod = "appwrite-jwt"
            credential = jwt
        } else if let session = client.config["session"], !session.isEmpty {
            authMethod = "appwrite-session"
            credential = session
        } else {
            throw {{ spec.info.title | caseUcfirst }}Error(message: "No credential set on the client; call Client.setJWT() or Client.setSession() first.")
        }

        let project = client.config["project"] ?? ""
        // A non-empty identifier is required for a persistent session (clean start off) — some
        // MQTT clients/brokers reject a zero-length id in that mode. The broker keys its
        // offline-replay cursor on this id, resolved once per instance (see resolvedClientId)
        // so a reconnect rebuild reuses it and resumes the same session.
        let id = resolvedClientId

        var tlsConfiguration: MQTTClient.TLSConfigurationType?
        if tls && tlsInsecure {
            #if canImport(Network)
                tlsConfiguration = .ts(TSTLSConfiguration(certificateVerification: .none))
            #endif
        }

        let configuration = MQTTClient.Configuration(
            version: .v5_0,
            keepAliveInterval: .seconds(Int64(Push.keepAliveSeconds)),
            useSSL: tls,
            tlsConfiguration: tlsConfiguration
        )

        let mqtt = MQTTClient(
            host: host,
            port: port,
            identifier: id,
            eventLoopGroupProvider: .createNew,
            configuration: configuration
        )

        // One listener fans every delivery out to the matching local callbacks.
        mqtt.addPublishListener(named: "{{ spec.info.title | caseLower }}-push") { [weak self] (result: Result<MQTTPublishInfo, Swift.Error>) in
            if case .success(let publish) = result {
                self?.dispatch(publish)
            }
        }

        // Surface the connection lifecycle to the caller's onClose/onError hooks.
        mqtt.addCloseListener(named: "{{ spec.info.title | caseLower }}-push") { [weak self] _ in
            self?.onCloseCb?()
        }

        // Enhanced auth carried in the CONNECT properties, plus the project id as a
        // user property — exactly like the Python and React Native clients.
        let properties = MQTTProperties([
            .authenticationMethod(authMethod),
            .authenticationData(ByteBuffer(bytes: Array(credential.utf8))),
            .userProperty("projectId", project),
        ])

        do {
            // Clean start off in replay mode so the broker keeps this client's replay
            // cursor and redelivers what it missed; on when replay is off so it is purged.
            let ack = try await mqtt.v5.connect(cleanStart: !replay, properties: properties)
            if ack.reason != .success {
                try? mqtt.syncShutdownGracefully()
                throw {{ spec.info.title | caseUcfirst }}Error(message: "MQTT authentication failed (CONNACK reason \(ack.reason))")
            }
        } catch let error as {{ spec.info.title | caseUcfirst }}Error {
            onErrorCb?(error)
            throw error
        } catch {
            try? mqtt.syncShutdownGracefully()
            onErrorCb?(error)
            throw {{ spec.info.title | caseUcfirst }}Error(message: error.localizedDescription)
        }

        onOpenCb?()
        return mqtt
    }

    private func dispatch(_ publish: MQTTPublishInfo) {
        let pushMessage = PushMessage(
            topic: publish.topicName,
            payload: [UInt8](publish.payload.readableBytesView),
            qos: Int(publish.qos.rawValue)
        )
        let callbacks = sync.sync {
            subscriptions.values.filter { matches(filter: $0.filter, topic: publish.topicName) }.map(\.callback)
        }
        for callback in callbacks {
            callback(pushMessage)
        }
        notify(pushMessage)
    }

    private func notify(_ message: PushMessage) {
        guard background else { return }
        #if canImport(UserNotifications)
            let content = UNMutableNotificationContent()
            content.title = backgroundTitle ?? message.topic
            content.body = message.string
            content.sound = .default
            let request = UNNotificationRequest(identifier: UUID().uuidString, content: content, trigger: nil)
            UNUserNotificationCenter.current().add(request)
        #endif
    }

}

/// MQTT topic-filter match with `+` (single level) and `#` (multi level).
private func matches(filter: String, topic: String) -> Bool {
    let filterParts = filter.split(separator: "/", omittingEmptySubsequences: false)
    let topicParts = topic.split(separator: "/", omittingEmptySubsequences: false)
    for (index, part) in filterParts.enumerated() {
        if part == "#" {
            return true
        }
        if index >= topicParts.count {
            return false
        }
        if part != "+" && part != topicParts[index] {
            return false
        }
    }
    return filterParts.count == topicParts.count
}
