func TestEqual(t *testing.T) {
	q := Equal("attr", "val")
	var data map[string]interface{}
	if err := json.Unmarshal([]byte(q), &data); err != nil {
		t.Fatal(err)
	}

	if data["method"] != "equal" {
		t.Errorf("Expected equal, got %v", data["method"])
	}
	if data["attribute"] != "attr" {
		t.Errorf("Expected attr, got %v", data["attribute"])
	}
	values := data["values"].([]interface{})
	if values[0] != "val" {
		t.Errorf("Expected val, got %v", values[0])
	}
}

