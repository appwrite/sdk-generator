    public function testResolveSendsRequestToPinnedAddress(): void
    {
        $first = $this->listen('127.0.0.1', 0);
        $port = $this->port($first);
        $second = $this->listen('127.0.0.2', $port);

        $client = new Client()
            ->setEndpoint("http://pinned.invalid:{$port}")
            ->setTimeout(1)
            ->setResolve(["pinned.invalid:{$port}:127.0.0.1"]);

        $this->send($client);
        $this->assertStringContainsString("Host: pinned.invalid:{$port}\r\n", $this->receive($first));

        $client->setResolve(["pinned.invalid:{$port}:127.0.0.2"]);

        $this->send($client);
        $this->assertStringContainsString("Host: pinned.invalid:{$port}\r\n", $this->receive($second));
        $this->assertFalse(@stream_socket_accept($first, 0.2), 'The re-pinned request reached the previous address.');
    }

    /**
     * @return resource
     */
    private function listen(string $address, int $port)
    {
        $listener = @stream_socket_server("tcp://{$address}:{$port}");

        if ($listener === false) {
            $this->markTestSkipped("Cannot listen on {$address}:{$port}.");
        }

        return $listener;
    }

    /**
     * @param resource $listener
     */
    private function port($listener): int
    {
        $name = (string) stream_socket_get_name($listener, false);

        return (int) substr($name, strrpos($name, ':') + 1);
    }

    private function send(Client $client): void
    {
        try {
            $client->call(Client::METHOD_GET, '/pinned');
        } catch ({{ namespace | split('\\') | last | caseUcfirst }}Exception) {
            // The listener never answers.
        }
    }

    /**
     * @param resource $listener
     */
    private function receive($listener): string
    {
        $connection = stream_socket_accept($listener, 1);
        $this->assertNotFalse($connection, 'No request reached the pinned address.');
        stream_set_timeout($connection, 1);

        return (string) fread($connection, 8192);
    }

    private function httpClient(Client $client, bool $followRedirects): ClientInterface
    {
        $method = new ReflectionMethod(Client::class, 'getHttpClient');

        return $method->invoke($client, $followRedirects);
    }
