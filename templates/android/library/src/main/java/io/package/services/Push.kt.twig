/**
 * A message delivered on a subscribed topic — the MQTT push analog of a realtime event.
 */
data class PushMessage(
    val topic: String,
    val payload: ByteArray,
    val qos: Int,
) {
    /** The payload decoded as a UTF-8 string. */
    val string: String
        get() = String(payload, Charsets.UTF_8)
}

/**
 * {{ spec.info.title | caseUcfirst }} native push service — the realtime analog delivered over an MQTT broker,
 * without FCM or APNS.
 *
 * By default this is foreground delivery: while the app process is alive the connection
 * stays open and each message is handed to your callback. Call [setForeground] to also
 * run inside an Android foreground service, so delivery continues while the app is
 * backgrounded or closed and every message is posted as a local notification.
 *
 * The credential is read off the client — set a JWT or session on it
 * (`Client.setJWT` / `Client.setSession`), the same way every other service reads auth.
 *
 * [reliableDelivery] (default `true`) picks the delivery guarantee once, for the whole
 * connection: `true` subscribes and publishes at QoS 1 with clean start off and a stable
 * client id, so the broker keeps this client's replay cursor and redelivers messages missed
 * during a brief disconnect on reconnect; `false` uses QoS 0 and a clean, ephemeral session
 * (at-most-once, may be lost, no replay). The broker owns the replay window server-side (no
 * MQTT session-expiry is set); pass a stable [clientId] to resume replay across restarts.
 *
 * ```kotlin
 * val client = Client().setEndpoint("...").setProject("...").setJWT(jwt)
 * val push = Push(client)
 * val unsubscribe = push.subscribe("user/123/#") { message ->
 *     println("${'$'}{message.topic}: ${'$'}{message.string}")
 * }
 * // ...later
 * unsubscribe()
 * ```
 */
class Push @JvmOverloads constructor(
    client: Client,
    host: String? = null,
    port: Int? = null,
    tls: Boolean? = null,
    private val tlsInsecure: Boolean = false,
    private val clientId: String? = null,
    private val keepAlive: Int = 60,
    private val reliableDelivery: Boolean = true,
) : Service(client) {

    // The broker location is taken from Client.setPushEndpoint() when set (e.g.
    // "mqtts://host:8883"), otherwise from the regular endpoint.
    private val pushEndpoint: String = client.endpointPush ?: client.endpoint

    private val host: String = host
        ?: runCatching { URI(pushEndpoint).host }.getOrNull()
        ?: "localhost"

    // Secure by default: TLS on when the endpoint scheme is secure (https/wss/mqtts/ssl) or
    // the port is 8883, so the credential in the CONNECT packet is not sent in the clear.
    private val tls: Boolean = tls
        ?: (port == 8883 || runCatching { URI(pushEndpoint).scheme }.getOrNull() in listOf("https", "wss", "mqtts", "ssl"))

    // Take the port from the push endpoint only (a regular http/https endpoint's port is the
    // API port, not the broker's); otherwise fall back to the MQTT default for the TLS mode.
    private val port: Int = port
        ?: client.endpointPush?.let { runCatching { URI(it).port.takeIf { p -> p != -1 } }.getOrNull() }
        ?: (if (this.tls) 8883 else 1883)

    // Resolve the fallback client id once per instance: a reconnect rebuilds the MQTT client,
    // and if each rebuild drew a new random id the broker would treat it as a new session and
    // drop this client's replay cursor. Reusing one id keeps the persistent session stable.
    private val resolvedClientId: String = clientId
        ?: "appwrite-${client.config["project"] ?: ""}-${UUID.randomUUID().toString().substring(0, 8)}"

    private var mqtt: Mqtt5AsyncClient? = null

    // Local id -> topic filter. HiveMQ fans matching publishes out to each
    // subscription's own callback; this map only tracks filters for unsubscribe.
    private val subscriptions = ConcurrentHashMap<String, String>()

    private var foreground = false
    private var appContext: Context? = null

    /**
     * Run delivery inside an Android foreground service so messages keep arriving while
     * the app is backgrounded or closed, each posted as a local notification.
     *
     * Requires the `POST_NOTIFICATIONS` runtime permission on Android 13+ — request it
     * from an Activity with [requestNotificationPermission] before subscribing.
     *
     * @param context      any Context (its application context is retained).
     * @param channelName  user-visible name of the notification channel.
     */
    @JvmOverloads
    fun setForeground(
        context: Context,
        channelName: String = "Notifications",
        ongoingTitle: String = "{{ spec.info.title | caseUcfirst }}",
    ): Push {
        foreground = true
        appContext = context.applicationContext
        PushForeground.channelName = channelName
        PushForeground.ongoingTitle = ongoingTitle
        createNotificationChannel(context.applicationContext, channelName)
        return this
    }

    /** Subscribe to a single topic. Returns an unsubscribe callable. */
    fun subscribe(topic: String, callback: (PushMessage) -> Unit): () -> Unit =
        subscribe(listOf(topic), callback)

    /**
     * Subscribe to one or more topics. Returns an unsubscribe callable.
     *
     * Blocks until the broker has acknowledged every SUBSCRIBE (SUBACK): the broker
     * only starts routing a topic once its subscription is registered, so publishing
     * before the ack races the message ahead of the subscription and it is dropped
     * (no retained replay on MQTT).
     */
    fun subscribe(topics: List<String>, callback: (PushMessage) -> Unit): () -> Unit {
        if (foreground) {
            return subscribeForeground(topics, callback)
        }

        val client = connect()

        val ids = mutableListOf<String>()
        val unsubscribe: () -> Unit = {
            for (id in ids) {
                val topic = subscriptions.remove(id)
                // Only unsubscribe the broker filter once its last local callback is gone.
                if (topic != null && !subscriptions.containsValue(topic)) {
                    mqtt?.unsubscribeWith()?.topicFilter(topic)?.send()
                }
            }
            if (subscriptions.isEmpty()) {
                close()
            }
        }

        // If any SUBSCRIBE fails, roll this call's registrations back (and drop any
        // now-unused broker filter) so a failed subscribe leaks no callback, then rethrow.
        try {
            for (topic in topics) {
                val id = UUID.randomUUID().toString()
                ids.add(id)
                subscriptions[id] = topic
                client.subscribeWith()
                    .topicFilter(topic)
                    .qos(defaultQos)
                    .callback { publish -> callback(publish.toPushMessage()) }
                    .send()
                    .get()
            }
        } catch (e: Exception) {
            unsubscribe()
            throw e
        }

        return unsubscribe
    }

    private fun subscribeForeground(topics: List<String>, callback: (PushMessage) -> Unit): () -> Unit {
        val context = appContext
            ?: throw {{ spec.info.title | caseUcfirst }}Exception("setForeground() must be called before subscribing in foreground mode.")

        PushForeground.config = buildConfig()
        // Register the listener with its own topics (so deliveries are filtered per
        // subscription) and add any new topics to the running service. register() is
        // atomic with the service's attach(), so a topic is never lost to a race.
        val listener = PushForeground.register(topics, callback)
        PushForeground.start(context)

        return {
            PushForeground.unregister(listener)
            if (PushForeground.listeners.isEmpty()) {
                PushForeground.stop(context)
            }
        }
    }

    // QoS for subscribe, chosen once by [reliableDelivery]: at-least-once (1) when
    // reliable, at-most-once (0) when not.
    private val defaultQos: MqttQos
        get() = if (reliableDelivery) MqttQos.AT_LEAST_ONCE else MqttQos.AT_MOST_ONCE

    /** Tear down the connection and drop all active subscriptions. */
    fun close() {
        mqtt?.disconnect()
        mqtt = null
    }

    private fun connect(): Mqtt5AsyncClient {
        mqtt?.let { existing ->
            if (existing.state.isConnected) {
                return existing
            }
        }

        val config = buildConfig()
        val client = buildPushClient(config)
        mqtt = client

        try {
            client.pushConnect(config)
        } catch (e: Exception) {
            close()
            throw {{ spec.info.title | caseUcfirst }}Exception(e.message ?: "MQTT connection failed")
        }

        return client
    }

    private fun buildConfig(): PushConfig {
        val (authMethod, credential) = resolvePushAuth(client)
        return PushConfig(
            host = host,
            port = port,
            tls = tls,
            tlsInsecure = tlsInsecure,
            clientId = resolvedClientId,
            keepAlive = keepAlive,
            authMethod = authMethod,
            credential = credential,
            project = client.config["project"] ?: "",
            reliableDelivery = reliableDelivery,
        )
    }

    private fun createNotificationChannel(context: Context, channelName: String) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                PushForeground.CHANNEL_ID,
                channelName,
                NotificationManager.IMPORTANCE_HIGH,
            )
            context.getSystemService(NotificationManager::class.java)?.createNotificationChannel(channel)
        }
    }

    companion object {
        /**
         * Request the `POST_NOTIFICATIONS` runtime permission (Android 13+). Call from an
         * Activity before [setForeground]/[subscribe]; on older versions it is a no-op.
         */
        @JvmStatic
        @JvmOverloads
        fun requestNotificationPermission(activity: Activity, requestCode: Int = 9412) {
            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
                return
            }
            if (ContextCompat.checkSelfPermission(activity, Manifest.permission.POST_NOTIFICATIONS)
                != PackageManager.PERMISSION_GRANTED
            ) {
                ActivityCompat.requestPermissions(
                    activity,
                    arrayOf(Manifest.permission.POST_NOTIFICATIONS),
                    requestCode,
                )
            }
        }
    }
}

/** Connection parameters shared between the in-process client and the foreground service. */
internal data class PushConfig(
    val host: String,
    val port: Int,
    val tls: Boolean,
    val tlsInsecure: Boolean,
    val clientId: String,
    val keepAlive: Int,
    val authMethod: String,
    val credential: String,
    val project: String,
    val reliableDelivery: Boolean,
)

/** Read the credential set on the client (via Client.setJWT / setSession). */
internal fun resolvePushAuth(client: Client): Pair<String, String> {
    val jwt = client.config["jwt"] ?: client.config["jWT"]
    val session = client.config["session"]
    return when {
        !jwt.isNullOrEmpty() -> "appwrite-jwt" to jwt
        !session.isNullOrEmpty() -> "appwrite-session" to session
        else -> throw {{ spec.info.title | caseUcfirst }}Exception(
            "No credential set on the client; call Client.setJWT() or Client.setSession() first.",
        )
    }
}

/** Build (but do not connect) an MQTT 5 client from [config]. */
internal fun buildPushClient(config: PushConfig): Mqtt5AsyncClient {
    // A non-empty identifier is required for a persistent session (clean start off): HiveMQ
    // sends an empty id expecting the broker to assign one, which it does not. The broker keys
    // its offline-replay cursor on this id; it is resolved once per Push instance (see
    // resolvedClientId) so a reconnect rebuild reuses it and resumes the same session.
    var builder = MqttClient.builder()
        .useMqttVersion5()
        .identifier(config.clientId)
        .serverHost(config.host)
        .serverPort(config.port)

    if (config.tls) {
        builder = if (config.tlsInsecure) {
            builder.sslConfig()
                .trustManagerFactory(PushInsecureTrustManagerFactory)
                .hostnameVerifier { _, _ -> true }
                .applySslConfig()
        } else {
            builder.sslWithDefaultConfig()
        }
    }

    return builder.buildAsync()
}

/** Connect with {{ spec.info.title | caseUcfirst }} enhanced auth; blocks until CONNACK (throws on failure). */
internal fun Mqtt5AsyncClient.pushConnect(config: PushConfig) {
    connectWith()
        .enhancedAuth(PushAuthMechanism(config.authMethod, config.credential))
        // Clean start off in reliable mode so the broker keeps this client's replay
        // cursor and redelivers what it missed; on in non-reliable mode so it is purged.
        .cleanStart(!config.reliableDelivery)
        .keepAlive(config.keepAlive)
        .userProperties()
        .add("projectId", config.project)
        .applyUserProperties()
        .send()
        .get()
}

internal fun Mqtt5Publish.toPushMessage(): PushMessage =
    PushMessage(
        topic = topic.toString(),
        payload = payloadAsBytes,
        qos = qos.code,
    )

/**
 * Single-step MQTT 5 enhanced auth: the method and credential are placed in the CONNECT
 * packet and the broker accepts them in the CONNACK, with no AUTH round-trip.
 */
internal class PushAuthMechanism(
    private val method: String,
    private val credential: String,
) : Mqtt5EnhancedAuthMechanism {

    override fun getMethod(): MqttUtf8String = MqttUtf8String.of(method)

    override fun getTimeout(): Int = 30

    override fun onAuth(
        clientConfig: Mqtt5ClientConfig,
        connect: Mqtt5Connect,
        authBuilder: Mqtt5EnhancedAuthBuilder,
    ): CompletableFuture<Void> {
        authBuilder.data(credential.toByteArray(Charsets.UTF_8))
        return CompletableFuture.completedFuture(null)
    }

    override fun onReAuth(
        clientConfig: Mqtt5ClientConfig,
        authBuilder: Mqtt5AuthBuilder,
    ): CompletableFuture<Void> {
        authBuilder.data(credential.toByteArray(Charsets.UTF_8))
        return CompletableFuture.completedFuture(null)
    }

    override fun onContinue(
        clientConfig: Mqtt5ClientConfig,
        auth: Mqtt5Auth,
        authBuilder: Mqtt5AuthBuilder,
    ): CompletableFuture<Boolean> = CompletableFuture.completedFuture(true)

    override fun onAuthSuccess(
        clientConfig: Mqtt5ClientConfig,
        connAck: Mqtt5ConnAck,
    ): CompletableFuture<Boolean> = CompletableFuture.completedFuture(true)

    override fun onReAuthSuccess(
        clientConfig: Mqtt5ClientConfig,
        auth: Mqtt5Auth,
    ): CompletableFuture<Boolean> = CompletableFuture.completedFuture(true)

    override fun onAuthRejected(clientConfig: Mqtt5ClientConfig, connAck: Mqtt5ConnAck) = Unit

    override fun onReAuthRejected(clientConfig: Mqtt5ClientConfig, disconnect: Mqtt5Disconnect) = Unit

    override fun onAuthError(clientConfig: Mqtt5ClientConfig, cause: Throwable) = Unit

    override fun onReAuthError(clientConfig: Mqtt5ClientConfig, cause: Throwable) = Unit
}

/**
 * A [TrustManagerFactory] that accepts any certificate — used when `tlsInsecure` is set
 * (for a broker whose certificate does not chain to a public root).
 */
internal object PushInsecureTrustManagerFactory : TrustManagerFactory(
    object : TrustManagerFactorySpi() {
        override fun engineInit(keyStore: KeyStore?) = Unit

        override fun engineInit(parameters: ManagerFactoryParameters?) = Unit

        override fun engineGetTrustManagers(): Array<TrustManager> = arrayOf(
            object : X509TrustManager {
                override fun checkClientTrusted(chain: Array<out X509Certificate>?, authType: String?) = Unit

                override fun checkServerTrusted(chain: Array<out X509Certificate>?, authType: String?) = Unit

                override fun getAcceptedIssuers(): Array<X509Certificate> = emptyArray()
            },
        )
    },
    @Suppress("DEPRECATION") object : Provider("{{ spec.info.title | caseUcfirst }}Insecure", 1.0, "insecure trust-all") {},
    "{{ spec.info.title | caseUcfirst }}Insecure",
)

/** A foreground subscription: the topics it wants and the callback to invoke for them. */
internal class PushListener(
    val topics: Set<String>,
    val callback: (PushMessage) -> Unit,
)

/**
 * Shared state for the foreground service: the connection config, the union of topics to
 * watch, the in-process listeners (each with its own topics, invoked while the app is
 * alive), and the notification setup.
 */
internal object PushForeground {
    const val CHANNEL_ID = "{{ spec.info.title | caseLower }}-push"
    const val NOTIFICATION_ID = 1911

    @Volatile
    var config: PushConfig? = null

    @Volatile
    var channelName: String = "Notifications"

    @Volatile
    var ongoingTitle: String = "{{ spec.info.title | caseUcfirst }}"

    // Guards the topic union and the live subscribe/unsubscribe hooks so add+subscribe,
    // remove+unsubscribe and attach+snapshot are atomic — no topic is lost to, or left
    // active by, their interleaving.
    private val lock = Any()
    private val topicSet = linkedSetOf<String>()
    private var subscriber: ((List<String>) -> Unit)? = null
    private var unsubscriber: ((List<String>) -> Unit)? = null

    val listeners = CopyOnWriteArrayList<PushListener>()

    /** Register a foreground subscription; subscribes any new topics on the live service. */
    fun register(topics: List<String>, callback: (PushMessage) -> Unit): PushListener {
        val listener = PushListener(topics.toSet(), callback)
        listeners.add(listener)
        synchronized(lock) {
            val added = topics.filter { topicSet.add(it) }
            if (added.isNotEmpty()) {
                subscriber?.invoke(added)
            }
        }
        return listener
    }

    /**
     * Drop a foreground subscription and unsubscribe from the broker any topic that no
     * remaining listener still wants, so removed topics stop delivering (and stop
     * producing notifications). Removing the listener first means the topic union is
     * recomputed from only the survivors.
     */
    fun unregister(listener: PushListener) {
        listeners.remove(listener)
        synchronized(lock) {
            val stillWanted = listeners.flatMapTo(mutableSetOf()) { it.topics }
            val removed = topicSet.filter { it !in stillWanted }
            if (removed.isNotEmpty()) {
                topicSet.removeAll(removed.toSet())
                unsubscriber?.invoke(removed)
            }
        }
    }

    /**
     * Called by the service once connected: installs the live subscribe/unsubscribe hooks
     * and returns the current topic union to subscribe. Atomic with [register] /
     * [unregister].
     */
    fun attach(
        subscribe: (List<String>) -> Unit,
        unsubscribe: (List<String>) -> Unit,
    ): List<String> = synchronized(lock) {
        this.subscriber = subscribe
        this.unsubscriber = unsubscribe
        topicSet.toList()
    }

    fun detach() {
        synchronized(lock) {
            subscriber = null
            unsubscriber = null
        }
    }

    /**
     * Fan a message out to every listener whose topics match. Returns true if at least
     * one listener matched, so the caller only notifies for messages someone still wants
     * (an in-flight message for a just-removed topic matches nothing and is dropped).
     */
    fun dispatch(message: PushMessage): Boolean {
        var matched = false
        for (listener in listeners) {
            if (listener.topics.any { matchesTopic(it, message.topic) }) {
                matched = true
                listener.callback(message)
            }
        }
        return matched
    }

    fun start(context: Context) {
        val intent = android.content.Intent(context, PushService::class.java)
        ContextCompat.startForegroundService(context, intent)
    }

    fun stop(context: Context) {
        context.stopService(android.content.Intent(context, PushService::class.java))
    }
}

/** MQTT topic-filter match with '+' (single level) and '#' (multi level). */
internal fun matchesTopic(filter: String, topic: String): Boolean {
    val filterParts = filter.split('/')
    val topicParts = topic.split('/')
    for (i in filterParts.indices) {
        if (filterParts[i] == "#") {
            return true
        }
        if (i >= topicParts.size) {
            return false
        }
        if (filterParts[i] != "+" && filterParts[i] != topicParts[i]) {
            return false
        }
    }
    return filterParts.size == topicParts.size
}
