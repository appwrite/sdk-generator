{% macro sub_schema(definitions, property) %}{% if (property | schemaModel) %}{% if (property | schemaType) == 'array' %}List<{{(property | schemaModel) | caseUcfirst | overrideIdentifier}}>{% else %}{{(property | schemaModel) | caseUcfirst | overrideIdentifier }}(
  {% if definitions[(property | schemaModel)] %}{% for property in definitions[(property | schemaModel)].properties | filter(p => p.required) %}
