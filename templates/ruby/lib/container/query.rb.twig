            end

            def not_spatial_equals(attribute, values)
                return Query.new("notSpatialEquals", attribute, [values]).to_s
            end

            def page(page, per_page = 25)
                if page < 1
                    raise ArgumentError, "Page must be >= 1, got #{page}"
                end
                if per_page < 1
                    raise ArgumentError, "Per page must be >= 1, got #{per_page}"
                end

                return [
                    limit(per_page),
                    offset((page - 1) * per_page),
                ]
            end

            def builder
                return Builder.new
            end

            def _flatten(value)
                return value.build if value.is_a?(Builder)
                return value.to_s if value.is_a?(Query)
                return value unless value.is_a?(Array)

                out = []
                changed = false
                value.each do |item|
                    flat = _flatten(item)
                    if item.is_a?(Builder) || item.is_a?(Query)
                        if flat.is_a?(Array)
                            out.concat(flat)
                        else
                            out << flat
                        end
                        changed = true
                        next
                    end
                    if item.is_a?(Array) && flat.is_a?(Array) && flat.all? { |entry| entry.is_a?(String) }
                        out.concat(flat)
                        changed = true
                        next
                    end
                    changed = true if flat != item
                    out << flat
                end

                changed ? out : value
            end

            def _normalize(queries)
                flat = _flatten(queries)
                return flat.map(&:to_s) if flat.is_a?(Array)
                return [flat] if flat.is_a?(String)

                []
            end

            private

            def create_join(method, table, left, right, operator, alias_name)
                return nested_join(method, table, '', left) if left.is_a?(Array)
                return nested_join(method, table, left, right) if right.is_a?(Array)

                return join_query(method, table, left, right, operator, alias_name)
            end

            def nested_join(method, table, alias_name, on)
                values = []
                values << alias_name if alias_name != ''
                on.each { |query| values << JSON.parse(query) }

                return Query.new(method, table, values).to_s
            end

            def join_query(method, table, left, right, operator, alias_name)
                values = [left, operator, right]
                values << alias_name if alias_name != ''

                return Query.new(method, table, values).to_s
            end
        end
