package main

import (
	"os"

	"github.com/{{ sdk.gitUserName }}/{{ sdk.gitRepoName | caseDash }}/internal/cmd"
)

func main() {
	root := cmd.NewRootCommand()
	// pflag drops the value in `--enabled false`; join it on first. See
	// RewriteBooleanValues.
	root.SetArgs(cmd.RewriteBooleanValues(root, os.Args[1:]))

	// cmd.Execute returns the command that ran for cancellation notices.
	executed, err := cmd.Execute(root)
	if err == nil {
		return
	}

	os.Exit(cmd.Report(os.Stderr, executed, err))
}
