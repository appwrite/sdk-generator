{
    "name": "utopia/mock-server-mqtt",
    "description": "Dependencies for app/mqtt.php (the mock MQTT broker), installed to ./vendor-mqtt and locked independently of the HTTP mock.",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/utopia-php/mqtt"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "utopia-php/mqtt": "0.0.2"
    },
    "config": {
        "vendor-dir": "vendor-mqtt",
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
