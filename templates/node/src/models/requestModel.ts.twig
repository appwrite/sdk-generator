{%~ set importedEnums = [] %}
{%~ set importedSchemas = [] %}
{%~ for property in requestModel.properties %}
{%~ if (property | enumValues) is not empty and (property | enumName) not in importedEnums %}
import { {{ (property | enumName) | caseUcfirst }} } from '../enums/{{ (property | enumName) | caseKebab }}';
{%~ set importedEnums = importedEnums | merge([(property | enumName)]) %}
{%~ endif %}
{%~ if (property | schemaModel) and (property | schemaModel) not in importedSchemas %}
import { {{ (property | schemaModel) | caseUcfirst }}, {{ (property | schemaModel) | caseCamel }}ToMap } from './{{ (property | schemaModel) | caseKebab }}';
{%~ set importedSchemas = importedSchemas | merge([(property | schemaModel)]) %}
{%~ endif %}
{%~ endfor %}

/**
 * {{ requestModel.description }}
 */
export interface {{ requestModelName | caseUcfirst }} {
    {%~ for property in requestModel.properties %}
    /**
     * {{ property.description }}
     */
    {{ (property | schemaName) | escapeKeyword }}{% if not (property | schemaRequired) %}?{% endif %}: {{ property | getPropertyType(spec) }};
    {%~ endfor %}
}

/**
 * Helper function to convert {{ requestModelName | caseUcfirst }} to a plain object
 */
export function {{ requestModelName | caseCamel }}ToMap(model: {{ requestModelName | caseUcfirst }}): Record<string, unknown> {
    return {
        {%~ for property in requestModel.properties %}
        '{{ (property | schemaName) }}': {% if (property | schemaModel) %}{% if (property | schemaType) == 'array' %}model.{{ (property | schemaName) | escapeKeyword }}{% if not (property | schemaRequired) %}?{% endif %}.map(item => {{ (property | schemaModel) | caseCamel }}ToMap(item)){% else %}model.{{ (property | schemaName) | escapeKeyword }} ? {{ (property | schemaModel) | caseCamel }}ToMap(model.{{ (property | schemaName) | escapeKeyword }}) : undefined{% endif %}{% elseif (property | enumValues) is not empty %}model.{{ (property | schemaName) | escapeKeyword }}{% else %}model.{{ (property | schemaName) | escapeKeyword }}{% endif %},
        {%~ endfor %}
    };
}
