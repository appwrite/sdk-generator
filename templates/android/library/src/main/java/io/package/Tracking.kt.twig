package {{ sdk.namespace | caseDot }}

import android.app.Activity
import android.app.ActivityManager
import android.app.Application
import android.content.Context
import android.os.Bundle
import android.os.SystemClock
import androidx.annotation.MainThread
import {{ sdk.namespace | caseDot }}.services.Analytics
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.launch
import org.json.JSONObject
import java.net.URI
import java.util.concurrent.atomic.AtomicBoolean

/**
 * Auto-tracking helpers for the generated [Analytics] service: install, update and app-lifecycle
 * events, push helpers, and manual [screenView] / [event] calls, all sent through
 * `Analytics.createEvent`.
 *
 * Auto-emitted event names follow `snake_case` + lowercase (`screen_view`, `app_backgrounded`,
 * `app_foregrounded`, etc.). Prop keys use camelCase to match the endpoint's parameter naming.
 *
 * Engagement time is reported as a **delta** attached to each `app_backgrounded` event, covering
 * only the foreground time accrued since the app last came to the foreground, the same way the
 * Web and Flutter helpers report it.
 *
 * Call [start] from `Application.onCreate` or before the first activity starts, so the lifecycle
 * callbacks see every activity:
 *
 * ```kotlin
 * val tracking = Tracking(Analytics(client), "<PROPERTY_ID>")
 * tracking.start()
 * ```
 *
 * @param url Base URL events are reported under; screen names resolve against it. The endpoint
 * only accepts absolute URLs.
 */
class Tracking @JvmOverloads constructor(
    private val analytics: Analytics,
    /** Analytics property every event is recorded against. */
    val propertyId: String,
    val url: String = "app://android",
) {
    private val context: Context = analytics.client.appContext
    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)

    private var lifecycleAttached = false
    private var startedActivities = 0
    private var foregroundSince: Long? = null

    // Sub-second engagement left over from the previous flush, so many short foreground
    // stretches do not each lose a fraction of a second to truncation.
    private var engagementCarry = 0L

    private val lifecycle = object : Application.ActivityLifecycleCallbacks {
        override fun onActivityStarted(activity: Activity) {
            startedActivities++
            // Another activity starting while the app is on screen keeps the interval open.
            if (foregroundSince != null) {
                return
            }
            foregroundSince = SystemClock.elapsedRealtime()
            event("app_foregrounded", interactive = false)
        }

        override fun onActivityStopped(activity: Activity) {
            startedActivities = (startedActivities - 1).coerceAtLeast(0)
            // A rotation stops and restarts the activity without the app leaving the screen.
            if (startedActivities > 0 || activity.isChangingConfigurations) {
                return
            }
            val since = foregroundSince ?: return
            foregroundSince = null
            val elapsed = engagementCarry + SystemClock.elapsedRealtime() - since
            val seconds = elapsed / 1000
            engagementCarry = elapsed % 1000
            event("app_backgrounded", engagementTime = seconds.takeIf { it > 0 }, interactive = false)
        }

        override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) = Unit

        override fun onActivityResumed(activity: Activity) = Unit

        override fun onActivityPaused(activity: Activity) = Unit

        override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) = Unit

        override fun onActivityDestroyed(activity: Activity) = Unit
    }

    /**
     * Start the default auto-tracking set: app-lifecycle events, as [enableAutoLifecycleEvents],
     * plus `first_open` and `app_updated`.
     *
     * `first_open` is sent once per install, `app_updated` (with `previousVersion` and `version`)
     * on the first start after the app's version name changes. Both rely on a marker in the SDK's
     * shared preferences, so a reinstall or "clear data" counts as a new install. An existing
     * install upgrading to this SDK is not counted when the client has saved cookies; without them
     * its first start after the upgrade counts once.
     *
     * The check runs once per process. An event whose request fails is kept and sent again on the
     * next start; a crash after it was sent but before it was cleared sends it once more.
     */
    @MainThread
    fun start() {
        enableAutoLifecycleEvents()
        if (!installChecked.compareAndSet(false, true)) {
            return
        }
        scope.launch {
            try {
                val prefs = context.getSharedPreferences(Client.GLOBAL_PREFS, Context.MODE_PRIVATE)
                var pending = prefs.getString(INSTALL_PENDING, null)
                // Before anything else: the app's first request can save cookies meanwhile.
                val ranBefore = pending == null && context.getSharedPreferences(Client.COOKIE_PREFS, Context.MODE_PRIVATE).all.isNotEmpty()
                val saved = prefs.getString(INSTALL_MARKER, null)
                val version = context.packageManager.getPackageInfo(context.packageName, 0).versionName.orEmpty()
                if (pending == null) {
                    if (saved == version) {
                        return@launch
                    }
                    pending = when {
                        saved != null -> JSONObject()
                            .put("name", "app_updated")
                            .put("props", JSONObject().put("previousVersion", saved).put("version", version))
                        !ranBefore -> JSONObject().put("name", "first_open")
                        else -> null
                    }?.toString()
                }
                // Pending event and marker in one atomic write, before sending, so no start sends it
                // twice and a retried event does not leave the marker on an older version.
                if (saved != version) {
                    prefs.edit().putString(INSTALL_PENDING, pending).putString(INSTALL_MARKER, version).commit()
                }
                val event = JSONObject(pending ?: return@launch)
                val props = event.optJSONObject("props")?.let { json -> json.keys().asSequence().associateWith { json.getString(it) } }
                if (send(event.getString("name"), props = props, interactive = false)) {
                    prefs.edit().remove(INSTALL_PENDING).commit()
                }
            } catch (e: Exception) {
                // Analytics never surface errors to the host app.
            }
        }
    }

    /**
     * Start emitting `app_backgrounded` and `app_foregrounded` events when the app leaves or
     * returns to the screen. Idempotent: repeat calls no-op.
     */
    @MainThread
    fun enableAutoLifecycleEvents() {
        val app = context as? Application ?: return
        if (lifecycleAttached) {
            return
        }
        lifecycleAttached = true
        // A process started in the background (e.g. by push delivery) is not on screen yet, so
        // its first activity sends app_foregrounded.
        val onScreen = ActivityManager.RunningAppProcessInfo()
            .also { ActivityManager.getMyMemoryState(it) }
            .importance == ActivityManager.RunningAppProcessInfo.IMPORTANCE_FOREGROUND
        foregroundSince = if (onScreen) SystemClock.elapsedRealtime() else null
        engagementCarry = 0
        app.registerActivityLifecycleCallbacks(lifecycle)
    }

    /** Stop emitting lifecycle events. Safe to call when auto-lifecycle was never enabled. */
    @MainThread
    fun disableAutoLifecycleEvents() {
        if (!lifecycleAttached) {
            return
        }
        lifecycleAttached = false
        startedActivities = 0
        foregroundSince = null
        engagementCarry = 0
        (context as Application).unregisterActivityLifecycleCallbacks(lifecycle)
    }

    /**
     * Emit an ad-hoc analytics event. [url] may be absolute or a path resolved against
     * [Tracking.url]. Request failures are swallowed so analytics never surface errors to the
     * host app.
     */
    @JvmOverloads
    fun event(
        name: String,
        url: String? = null,
        props: Map<String, Any?>? = null,
        engagementTime: Long? = null,
        interactive: Boolean? = null,
    ) {
        scope.launch { send(name, url, props, engagementTime, interactive) }
    }

    // Whether the endpoint accepted the event; failures, including a malformed [url], are swallowed.
    private suspend fun send(
        name: String,
        url: String? = null,
        props: Map<String, Any?>? = null,
        engagementTime: Long? = null,
        interactive: Boolean? = null,
    ): Boolean = try {
        val base = URI(this.url)
        // java.net.URI drops the "/" RFC 3986 puts between a path-less base and a relative path.
        val target = url?.let { (if (base.rawPath.isNullOrEmpty()) base.resolve("/") else base).resolve(URI(null, null, it, null)).toString() }
        analytics.createEvent(
            propertyId = propertyId,
            name = name,
            url = target ?: this.url,
            // The endpoint buckets this as viewport width in dp, like the Web helper's `innerWidth`.
            screenWidth = context.resources.configuration.screenWidthDp.takeIf { it > 0 }?.toLong(),
            engagementTime = engagementTime,
            // The endpoint takes props as a flat alternating key/value list.
            props = props?.filterValues { it != null }?.flatMap { listOf(it.key, "${it.value}") },
            interactive = interactive,
        )
        true
    } catch (e: Exception) {
        false
    }

    /**
     * Mobile-idiomatic screen-view shortcut. Renders as a `screen_view` analytics event with
     * `screen`, optional `screenClass` and any caller-supplied properties. [name] is also the
     * event URL's path.
     */
    @JvmOverloads
    fun screenView(
        name: String,
        className: String? = null,
        props: Map<String, Any?>? = null,
    ) {
        val merged = mutableMapOf<String, Any?>("screen" to name)
        if (className != null) {
            merged["screenClass"] = className
        }
        if (props != null) {
            merged.putAll(props)
        }
        event("screen_view", url = name, props = merged)
    }

    /**
     * Send `push_received` for a push notification the device got. Call it from your push
     * handler; best effort, since while the app is killed its code often does not run when a
     * notification arrives. [messageId] is the {{ spec.info.title | caseUcfirst }} Messaging message id.
     */
    @JvmOverloads
    fun pushReceived(messageId: String? = null, campaign: String? = null) {
        event("push_received", props = pushProps(messageId, campaign), interactive = false)
    }

    /**
     * Send `push_opened` when the user taps a push notification. [messageId] is the
     * {{ spec.info.title | caseUcfirst }} Messaging message id.
     */
    @JvmOverloads
    fun pushOpened(messageId: String? = null, campaign: String? = null) {
        event("push_opened", props = pushProps(messageId, campaign), interactive = true)
    }

    private fun pushProps(messageId: String?, campaign: String?): Map<String, Any?> = buildMap {
        messageId?.let { put("messageId", it) }
        campaign?.let { put("campaign", it) }
    }

    internal companion object {
        private const val INSTALL_MARKER = "trackingInstallVersion"
        private const val INSTALL_PENDING = "trackingInstallPending"

        // Shared by every instance, so concurrent or repeated start() calls never race on the marker.
        internal val installChecked = AtomicBoolean(false)
    }
}
