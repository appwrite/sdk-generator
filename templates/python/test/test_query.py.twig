    def test_having(self):
        query = json.loads(Query.having([Query.greater_than('total', 1)]))
        self.assertEqual(query['method'], 'having')
        self.assertEqual(query['values'][0]['method'], 'greaterThan')

    def test_join(self):
        self.assertEqual(Query.join('orders', '$id', 'customerId'), '{"method":"join","attribute":"orders","values":["$id","=","customerId"]}')

    def test_on(self):
        self.assertEqual(Query.on('$id', 'customerId'), '{"method":"on","values":["$id","=","customerId"]}')

    def test_nested_left_join(self):
        query = json.loads(Query.left_join('orders', 'ord', [
            Query.on('$id', 'customerId'),
            Query.equal('ord.status', 'paid'),
        ]))
        self.assertEqual(query['method'], 'leftJoin')
        self.assertEqual(query['attribute'], 'orders')
        self.assertEqual(query['values'][0], 'ord')
        self.assertEqual(query['values'][1]['method'], 'on')
        self.assertEqual(query['values'][2]['method'], 'equal')

