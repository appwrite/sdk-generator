import { Buffer } from 'buffer';
import mqtt, {
    type IClientOptions,
    type IConnackPacket,
    type IPublishPacket,
    type MqttClient,
} from 'mqtt';

import { Client } from '../client';
import { Service } from '../service';

/** A message delivered on a subscribed topic (the MQTT analog of a Realtime event). */
export interface PushMessage {
    topic: string;
    payload: Uint8Array;
    qos: number;
}

export type MessageCallback = (message: PushMessage) => void | Promise<void>;
export type Unsubscribe = () => void;

type AuthMethod = 'appwrite-jwt' | 'appwrite-session' | '';

// Fixed connection tuning — not exposed as options.
const KEEP_ALIVE_SECONDS = 60;
const RECONNECT_PERIOD_MS = 2000;

/**
 * {{spec.info.title | caseUcfirst}} native push service — the Realtime analog over an MQTT broker, without
 * FCM or APNS. In the browser the transport is MQTT 5 over WebSocket. Foreground
 * delivery only: while the page is open the connection stays up and each message is
 * handed to your callback.
 *
 * Mirrors the Realtime service: `new Push(client).subscribe(topics, callback)` opens
 * the connection lazily and returns an `unsubscribe` callable. The credential is read
 * off the client — set a JWT or session on it (`Client.setJWT` / `Client.setSession`),
 * the same way every other service reads auth.
 *
 *     const client = new Client().setEndpoint(...).setProject(...).setJWT(jwt);
 *     const push = new Push(client);
 *     const unsubscribe = await push.subscribe('user/123/#', (m) =>
 *       console.log(m.topic, new TextDecoder().decode(m.payload)),
 *     );
 */
export class Push extends Service {
    // Replay (reliable delivery): QoS 1 + clean start off so the broker keeps this
    // client's replay cursor. Default on; toggle with setReplayMessages().
    private replay = true;

    private mqtt: MqttClient | null = null;
    private connecting: Promise<void> | null = null;
    /** Set once the first CONNACK lands, so 'connect' events after are reconnects. */
    private everConnected = false;

    private background = false;
    private backgroundTitle?: string;

    private onOpenCb?: () => void;
    private onCloseCb?: () => void;
    private onErrorCb?: (error: Error) => void;

    // Local id -> { topic, callback }. The id is never sent to the broker; it only
    // lets the same topic carry more than one callback.
    private readonly subscriptions = new Map<
        string,
        { topic: string; callback: MessageCallback }
    >();

    constructor(client: Client) {
        super(client);
    }

    // QoS for subscribe, chosen by replay mode: at-least-once (1) when replaying missed
    // messages, at-most-once (0) when not.
    private get defaultQos(): 0 | 1 {
        return this.replay ? 1 : 0;
    }

    /**
     * Toggle replay of messages missed while disconnected. `true` (the default)
     * subscribes at QoS 1 with clean start off, so the broker keeps this client's replay
     * cursor and redelivers missed messages on reconnect; `false` uses QoS 0 and a clean
     * session (at-most-once, no replay). Can be called at any time: if the connection is
     * already open in the other mode it reconnects and resubscribes at the new QoS.
     */
    setReplayMessages(enabled: boolean = true): this {
        if (enabled === this.replay) {
            return this;
        }
        this.replay = enabled;
        if (this.mqtt) {
            void this.reconnect();
        }
        return this;
    }

    /**
     * Enable (or disable) surfacing every delivered message as a browser notification
     * while the tab is open. Requests the `Notification` permission on the spot. In the
     * browser there is no true background/closed-tab delivery (that needs a service worker
     * + push subscription); this covers open-tab presentation. `setBackground(false)`
     * turns it off.
     *
     * @param enabled Whether to show notifications. Defaults to true.
     * @param options.title Fixed notification title. Defaults to the message topic.
     */
    setBackground(
        enabled: boolean = true,
        options: { title?: string } = {},
    ): this {
        this.background = enabled;
        if (enabled) {
            this.backgroundTitle = options.title;
            if (
                typeof Notification !== 'undefined' &&
                Notification.permission === 'default'
            ) {
                void Notification.requestPermission();
            }
        }
        return this;
    }

    /** Register a callback invoked when the connection opens (CONNACK success). */
    onOpen(callback: () => void): this {
        this.onOpenCb = callback;
        return this;
    }

    /** Register a callback invoked when the connection closes. */
    onClose(callback: () => void): this {
        this.onCloseCb = callback;
        return this;
    }

    /** Register a callback invoked on a connection error. */
    onError(callback: (error: Error) => void): this {
        this.onErrorCb = callback;
        return this;
    }

    // --- realtime-like API ---

    /**
     * Subscribe to one or more topics. Resolves to an unsubscribe callable.
     *
     * Awaiting resolves only once the broker has acked every SUBSCRIBE (SUBACK):
     * the broker only starts routing a topic once its subscription is registered,
     * so publishing before the ack races the message ahead of the subscription and
     * it is dropped (no retained replay on MQTT). Awaiting here makes
     * subscribe-then-publish reliable.
     */
    async subscribe(
        topics: string | string[],
        callback: MessageCallback,
    ): Promise<Unsubscribe> {
        const topicList = typeof topics === 'string' ? [topics] : topics;

        const client = await this.connect();

        const ids: string[] = [];
        const acks: Promise<void>[] = [];
        for (const topic of topicList) {
            const id = randomId();
            ids.push(id);
            this.subscriptions.set(id, { topic, callback });
            acks.push(
                new Promise<void>((resolve, reject) => {
                    client.subscribe(topic, { qos: this.defaultQos }, (err) =>
                        err ? reject(err) : resolve(),
                    );
                }),
            );
        }

        const unsubscribe = () => {
            for (const id of ids) {
                const entry = this.subscriptions.get(id);
                this.subscriptions.delete(id);
                // Only unsubscribe the broker filter once its last local callback is gone.
                const stillUsed = [...this.subscriptions.values()].some(
                    (s) => s.topic === entry?.topic,
                );
                if (entry && this.mqtt && !stillUsed) {
                    this.mqtt.unsubscribe(entry.topic);
                }
            }
            if (this.subscriptions.size === 0) {
                this.close();
            }
        };

        // If any topic's subscribe fails, roll this call's registrations back (and drop
        // any now-unused broker filter) so a failed subscribe leaks no callback, then rethrow.
        try {
            await Promise.all(acks);
        } catch (err) {
            unsubscribe();
            throw err;
        }

        return unsubscribe;
    }

    /** Tear down the connection. */
    close(): void {
        if (this.mqtt) {
            this.mqtt.end(true);
            this.mqtt = null;
        }
        this.connecting = null;
        this.everConnected = false;
    }

    /**
     * Re-register every active subscription. Called on each reconnect so a client that
     * reconnects with a fresh (or cleared) session does not silently stop receiving;
     * re-subscribing an existing filter is idempotent.
     */
    private resubscribeAll(): void {
        const client = this.mqtt;
        if (!client) {
            return;
        }
        for (const { topic } of this.subscriptions.values()) {
            client.subscribe(topic, { qos: this.defaultQos }, () => {});
        }
    }

    // Reconnect and resubscribe active topics at the current QoS — used when the replay
    // mode changes while the connection is open (clean start is a CONNECT-level flag).
    private async reconnect(): Promise<void> {
        this.close();
        await this.connect();
        this.resubscribeAll();
    }

    // --- internals ---

    private connect(): Promise<MqttClient> {
        if (this.mqtt) {
            return Promise.resolve(this.mqtt);
        }
        if (!this.connecting) {
            this.connecting = this.open();
            // A failed open must not poison future attempts — clear the cached
            // in-flight promise so a later subscribe/publish can retry.
            this.connecting.catch(() => {
                this.connecting = null;
            });
        }
        return this.connecting.then(() => this.mqtt!);
    }

    private endpointUrl(): string {
        // The push endpoint set on the client (Client.setPushEndpoint) wins, else the
        // regular endpoint with its scheme switched to ws/wss.
        if (this.client.config.endpointPush !== '') {
            return this.client.config.endpointPush;
        }
        const endpoint =
            this.client.config.endpointRealtime !== ''
                ? this.client.config.endpointRealtime
                : this.client.config.endpoint;
        return endpoint
            .replace('https://', 'wss://')
            .replace('http://', 'ws://');
    }

    private async open(): Promise<void> {
        // Read the credential set on the client (via Client.setJWT / setSession).
        let authMethod: AuthMethod;
        let credential: string;
        if (this.client.config.jwt) {
            authMethod = 'appwrite-jwt';
            credential = this.client.config.jwt;
        } else if (this.client.config.session) {
            authMethod = 'appwrite-session';
            credential = this.client.config.session;
        } else {
            throw new Error(
                'No credential set on the client; call Client.setJWT() or Client.setSession() first.',
            );
        }

        const project = this.client.config.project ?? '';
        // A stable client id (Client.setPushClientId) lets the broker resume this client's
        // replay cursor across reloads; otherwise a per-connection id is generated.
        const clientId =
            this.client.config.pushClientId ||
            `appwrite-${project}-${randomId().slice(0, 8)}`;

        const options: IClientOptions = {
            clientId,
            protocolVersion: 5,
            clean: !this.replay, // clean start off = keep the replay cursor
            keepalive: KEEP_ALIVE_SECONDS,
            reconnectPeriod: RECONNECT_PERIOD_MS,
            manualConnect: true,
            // Enhanced auth carried in CONNECT properties.
            properties: {
                authenticationMethod: authMethod,
                authenticationData: Buffer.from(credential),
                userProperties: { projectId: project },
            },
        };

        const client = mqtt.connect(this.endpointUrl(), options);
        this.mqtt = client;

        client.on('message', (_topic, _payload, packet) => {
            void this.dispatch(packet);
        });

        // Persistent lifecycle listeners. Re-register every subscription on reconnect
        // (harmless if the broker resumed our session), and surface the lifecycle to the
        // caller's onOpen/onClose/onError hooks.
        client.on('connect', () => {
            if (this.everConnected) {
                this.resubscribeAll();
            }
            this.everConnected = true;
            this.onOpenCb?.();
        });
        client.on('close', () => this.onCloseCb?.());
        client.on('error', (err) =>
            this.onErrorCb?.(
                err instanceof Error ? err : new Error(String(err)),
            ),
        );

        await new Promise<void>((resolve, reject) => {
            const onConnect = (packet: IConnackPacket) => {
                cleanup();
                const rc = packet.reasonCode ?? packet.returnCode ?? 0;
                if (rc !== 0) {
                    this.close();
                    reject(
                        new Error(
                            `MQTT authentication failed (CONNACK reason ${rc})`,
                        ),
                    );
                } else {
                    resolve();
                }
            };
            const onError = (err: Error) => {
                cleanup();
                this.close();
                reject(err);
            };
            const cleanup = () => {
                client.removeListener('connect', onConnect);
                client.removeListener('error', onError);
            };
            client.on('connect', onConnect);
            client.on('error', onError);
            client.connect();
        });
    }

    /** Fan a delivered packet out to every subscription whose filter matches. */
    private async dispatch(packet: IPublishPacket): Promise<void> {
        const message: PushMessage = {
            topic: packet.topic.toString(),
            payload: Buffer.isBuffer(packet.payload)
                ? packet.payload
                : Buffer.from(packet.payload),
            qos: packet.qos,
        };
        for (const { topic: filter, callback } of this.subscriptions.values()) {
            if (matches(filter, message.topic)) {
                await callback(message);
            }
        }
        this.notify(message);
    }

    /** Post a browser notification for a message when background mode is on. */
    private notify(message: PushMessage): void {
        if (
            !this.background ||
            typeof Notification === 'undefined' ||
            Notification.permission !== 'granted'
        ) {
            return;
        }
        try {
            new Notification(this.backgroundTitle ?? message.topic, {
                body: new TextDecoder().decode(message.payload),
            });
        } catch {
            // Some browsers only allow notifications from a service worker; ignore.
        }
    }
}

/** A hex id, uuid4-like enough for a client-generated client id suffix. */
function randomId(): string {
    let out = '';
    for (let i = 0; i < 32; i++) {
        out += Math.floor(Math.random() * 16).toString(16);
    }
    return out;
}

/** MQTT topic-filter match with '+' (single level) and '#' (multi level). */
export function matches(filter: string, topic: string): boolean {
    const filterParts = filter.split('/');
    const topicParts = topic.split('/');
    for (let i = 0; i < filterParts.length; i++) {
        const part = filterParts[i];
        if (part === '#') {
            return true;
        }
        if (i >= topicParts.length) {
            return false;
        }
        if (part !== '+' && part !== topicParts[i]) {
            return false;
        }
    }
    return filterParts.length === topicParts.length;
}
