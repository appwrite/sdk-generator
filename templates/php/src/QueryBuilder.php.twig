     */
    public function join(string $table, string|array $leftOrAliasOrOn, string|array $rightOrOn = '', string $operator = '=', string $alias = ''): self
    {
        return $this->push(Query::join($table, $leftOrAliasOrOn, $rightOrOn, $operator, $alias));
    }

    /**
     * @param string|array<string> $leftOrAliasOrOn
     * @param string|array<string> $rightOrOn
     */
    public function leftJoin(string $table, string|array $leftOrAliasOrOn, string|array $rightOrOn = '', string $operator = '=', string $alias = ''): self
    {
        return $this->push(Query::leftJoin($table, $leftOrAliasOrOn, $rightOrOn, $operator, $alias));
    }

