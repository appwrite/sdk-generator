{% for property in requiredProperties %}{% set propertyName = property | schemaName %}{% set stringExample = '' %}{% if (property | schemaType) == 'string' %}{% set stringExample = (property | schemaExample) | dartString %}{% endif %}        '{{ propertyName | escapeDollarSign }}':{% if (property | schemaType) == 'string' and propertyName|length + stringExample|length > 67 %}{% else %} {% endif %}{% if (property | schemaType) == 'object' %}{% if (property | schemaModel) and ((property | schemaModel) != 'prefs' and (property | schemaModel) != 'preferences') %}{{ _self.sub_schema(definitions, property) }}{% else %}<String, dynamic>{}{% endif %}{% elseif (property | schemaType) == 'array' %}[]{% elseif (property | schemaType) == 'string' %}{% if propertyName|length + stringExample|length > 67 %}{{ "\n" }}            {{ stringExample | raw }}{% else %}{{ stringExample | raw }}{% endif %}{% elseif (property | schemaType) == 'boolean' %}true{% else %}{{ (property | schemaExample) }}{% endif %},
{% endfor %}{% for field, value in discriminatorConditions %}{% if value is iterable %}{% set discriminatorValue = value | json_encode %}{% else %}{% set discriminatorValue = value | dartString %}{% endif %}        '{{ field | escapeDollarSign }}':{% if field|length + discriminatorValue|length > 67 %}{{ "\n" }}{% else %} {% endif %}{% if field|length + discriminatorValue|length > 67 %}            {{ discriminatorValue | raw }}{% else %}{{ discriminatorValue | raw }}{% endif %},
{% endfor %}      };
{% endif %}
{% else %}
