    def test_page(self):
        queries = Query.page(2, 10)
        self.assertEqual(queries, [
            '{"method":"limit","values":[10]}',
            '{"method":"offset","values":[10]}',
        ])

    def test_builder_build(self):
        expected = [
            Query.equal('status', 'published'),
            Query.left_join('orders', '$id', 'customerId', '=', 'ord'),
            Query.count('*', 'total'),
            Query.group_by(['status']),
            Query.limit(25),
        ]
        built = Query.builder().equal('status', 'published').left_join('orders', '$id', 'customerId', '=', 'ord').count('*', 'total').group_by(['status']).limit(25).build()
        self.assertEqual(expected, built)

    def test_normalize_builder(self):
        builder = Query.builder().equal('status', 'active').limit(10)
        self.assertEqual(builder.build(), Query._normalize(builder))
        self.assertEqual(builder.build(), Query._normalize([builder]))
        self.assertEqual(builder.build(), Query._normalize([builder.build()]))
