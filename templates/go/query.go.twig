func Page(page, perPage int) []string {
	if page < 1 {
		panic(fmt.Sprintf("Page must be >= 1, got %d", page))
	}
	if perPage < 1 {
		panic(fmt.Sprintf("Per page must be >= 1, got %d", perPage))
	}
	return []string{Limit(perPage), Offset((page - 1) * perPage)}
}

func normalize(queries interface{}) []string {
	if queries == nil {
		return []string{}
	}

	switch v := queries.(type) {
	case *Builder:
		if v == nil {
			return []string{}
		}
		return v.Build()
	case Builder:
		return v.Build()
	case string:
		return []string{v}
	}

	value := reflect.ValueOf(queries)
	switch value.Kind() {
	case reflect.Slice, reflect.Array:
		out := make([]string, 0, value.Len())
		for i := 0; i < value.Len(); i++ {
			out = append(out, normalize(value.Index(i).Interface())...)
		}
		return out
	default:
		return []string{}
	}
}
