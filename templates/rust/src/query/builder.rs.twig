use serde::Serialize;
use serde_json::Value;

use super::Query;

#[derive(Debug, Clone, Default)]
pub struct Builder {
    queries: Vec<Query>,
}

impl Builder {
    pub fn new() -> Self {
        Self { queries: Vec::new() }
    }

    pub fn build(&self) -> Vec<String> {
        self.queries.iter().map(|query| query.to_string()).collect()
    }

    pub fn equal<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::equal(attribute, value));
        self
    }

    pub fn not_equal<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::not_equal(attribute, value));
        self
    }

    pub fn less_than<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::less_than(attribute, value));
        self
    }

    pub fn less_than_equal<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::less_than_equal(attribute, value));
        self
    }

    pub fn greater_than<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::greater_than(attribute, value));
        self
    }

    pub fn greater_than_equal<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::greater_than_equal(attribute, value));
        self
    }

    pub fn is_null<S: Into<String>>(mut self, attribute: S) -> Self {
        self.queries.push(Query::is_null(attribute));
        self
    }

    pub fn is_not_null<S: Into<String>>(mut self, attribute: S) -> Self {
        self.queries.push(Query::is_not_null(attribute));
        self
    }

    pub fn between<S: Into<String>, V: Into<Value>>(mut self, attribute: S, start: V, end: V) -> Self {
        self.queries.push(Query::between(attribute, start, end));
        self
    }

    pub fn starts_with<S: Into<String>, V: Into<Value>>(mut self, attribute: S, value: V) -> Self {
        self.queries.push(Query::starts_with(attribute, value));
        self
