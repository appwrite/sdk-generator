func TestBuilderBuild(t *testing.T) {
	expected := []string{
		Equal("status", "published"),
		LeftJoin("orders", "$id", "customerId", "=", "ord"),
		Count("*", "total"),
		GroupBy([]interface{}{"status"}),
		Limit(25),
	}

	built := Builder().
		Equal("status", "published").
		LeftJoin("orders", "$id", "customerId", "=", "ord").
		Count("*", "total").
		GroupBy([]interface{}{"status"}).
		Limit(25).
		Build()

	if len(built) != len(expected) {
		t.Fatalf("Expected %d queries, got %d", len(expected), len(built))
	}
	for i := range expected {
		if built[i] != expected[i] {
			t.Errorf("index %d: expected %s, got %s", i, expected[i], built[i])
		}
	}
}

func assertQueriesEqual(t *testing.T, got, expected []string) {
	t.Helper()
	if len(got) != len(expected) {
		t.Fatalf("expected %d queries, got %d: %v", len(expected), len(got), got)
	}
	for i := range expected {
		if got[i] != expected[i] {
			t.Errorf("index %d: expected %s, got %s", i, expected[i], got[i])
		}
	}
}

func TestNormalizeBuilderDirect(t *testing.T) {
	builder := Builder().Equal("status", "active").Limit(10)
	assertQueriesEqual(t, Normalize(builder), builder.Build())
}

func TestNormalizeBuilderWrappedInArray(t *testing.T) {
	builder := Builder().Equal("status", "active").Limit(10)
	assertQueriesEqual(t, Normalize([]interface{}{builder}), builder.Build())
}

func TestNormalizeBuildResultWrappedInArray(t *testing.T) {
	built := Builder().Equal("status", "active").Limit(10).Build()
	assertQueriesEqual(t, Normalize([]interface{}{built}), built)
}

func TestNormalizeMixedAndPage(t *testing.T) {
	normalized := Normalize([]interface{}{
		Equal("status", "active"),
		Page(2, 10),
	})
	assertQueriesEqual(t, normalized, []string{
		Equal("status", "active"),
		Limit(10),
		Offset(10),
	})
}
