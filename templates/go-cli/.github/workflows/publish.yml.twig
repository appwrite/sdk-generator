name: Publish

# Builds the six release binaries, signs them, and publishes to GitHub
# Releases, npm and the Homebrew tap.
#
# CREDENTIALS THIS NEEDS. None are wired up yet; each is named where it is
# used and the release fails loudly rather than silently skipping a step.
#
#   vars.APPWRITE_BOT_APP_ID             GitHub App that writes to the tap
#   secrets.APPWRITE_BOT_PRIVATE_KEY     its private key
#
# Windows signing is OPTIONAL. Set secrets.WINDOWS_SIGNING_API_TOKEN and
# vars.WINDOWS_SIGNING_ORGANIZATION_ID to enable it; leave them unset and the
# .exe assets ship unsigned with a warning in the run summary. The three slug
# variables below only matter once signing is on, and each falls back to a
# convention, so a SignPath project following it needs none of them set.
#
# Asset upload uses the job's own GITHUB_TOKEN, covered by `contents: write`.
#
# npm needs no token: publishing uses npm trusted publishing, which is what
# `id-token: write` and `--provenance` below are for. The npm project has to
# be configured to trust this workflow before the first run -- and because
# trust is configured per package that already exists, the six platform
# packages need one manual token-based publish before this ever runs. Skipping
# that does not degrade gracefully: it fails the release after the GitHub assets
# have already been uploaded.
#
# A prerelease publishes to npm's `next` tag and skips the Homebrew tap
# entirely; only a full release moves `latest` and the formula.
#
# There is deliberately NO Apple credential here. install.sh requires an
# embedded signature, not a trusted one, and .goreleaser.yaml ad-hoc signs the
# darwin builds -- which is also all the TypeScript CLI has ever shipped.

on:
  release:
    types: [published]

permissions:
  contents: write
  id-token: write

# Two releases published close together would otherwise race on `gh release
# upload` and on the tap push. Never cancel a run in flight: a half-published
# release is worse than a queued one.
concurrency:
  group: publish
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    env:
      HOMEBREW_TAP_REPO: {{ language.params.homebrewTapOwner }}/homebrew-{{ language.params.homebrewTapName }}
      WINDOWS_SIGNING_PROJECT_SLUG: {{ '${{ vars.WINDOWS_SIGNING_PROJECT_SLUG || \'' }}{{ sdk.gitRepoName | caseDash }}{{ '\' }}' }}
      WINDOWS_SIGNING_POLICY_SLUG: {{ '${{ vars.WINDOWS_SIGNING_POLICY_SLUG || \'release-signing\' }}' }}
      WINDOWS_SIGNING_ARTIFACT_CONFIGURATION_SLUG: {{ '${{ vars.WINDOWS_SIGNING_ARTIFACT_CONFIGURATION_SLUG || \'initial\' }}' }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          # This job runs goreleaser, `go mod tidy` and node scripts, all of
          # which execute third-party code. Leaving the token in .git/config
          # would put it within reach of any of them. The tap checkout below
          # keeps its credentials -- it has to push.
          persist-credentials: false

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod

      # Before the staging step, not just before publishing: the release
      # scripts are node, and picking up whatever node the runner image happens
      # to ship means a runner update can change what built the release.
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: '24.14.1'
          registry-url: 'https://registry.npmjs.org'

      # npm's OIDC trusted publishing needs npm >= 11.5.1, and no node release
      # bundles one yet. Without this every `npm publish` below fails with
      # ENEEDAUTH, because this workflow deliberately carries no npm token.
      - name: Pin npm for trusted publishing
        run: npm install -g npm@11.10.0

      # goreleaser ad-hoc signs the darwin builds. Linux runners have no
      # codesign, so scripts/adhoc-sign.sh falls back to ldid -- without this
      # the build fails rather than producing an unsigned macOS binary that
      # install.sh would later refuse.
      - name: Install ldid
        run: |
          set -euo pipefail
          sudo apt-get update
          sudo apt-get install -y ldid

      # --skip=publish because the Windows binaries have to be signed before
      # anything is uploaded. The upload happens further down, once they are.
      - name: Build
        uses: goreleaser/goreleaser-action@e435ccd777264be153ace6237001ef4d979d3a7a # v6.4.0
        with:
          version: '~> v2'
          args: release --clean --skip=publish
        env:
          # .goreleaser.yaml builds its changelog from the GitHub API, which
          # needs a token even though publishing is skipped.
          GITHUB_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}

      - name: Stage release assets
        run: node scripts/stage-assets.mjs dist staging

      # Signing is optional so a release is not blocked on an external service
      # being configured. Keyed off the token rather than a flag, so wiring the
      # secret up is all it takes to start signing -- there is no second switch
      # to remember.
      - name: Detect Windows code signing
        id: signing
        env:
          SIGNING_TOKEN: {{ '${{ secrets.WINDOWS_SIGNING_API_TOKEN }}' }}
        run: |
          set -euo pipefail

          if [ -n "${SIGNING_TOKEN}" ]; then
            echo "enabled=true" >> "$GITHUB_OUTPUT"
          else
            echo "enabled=false" >> "$GITHUB_OUTPUT"
            echo "::warning title=Windows binaries are unsigned::\
          WINDOWS_SIGNING_API_TOKEN is not set, so the .exe assets ship unsigned \
          and Windows SmartScreen will warn on first run. Set the secret to sign them."
          fi

      - name: Upload unsigned Windows binaries
        id: upload-windows-unsigned
        if: {{ '${{ steps.signing.outputs.enabled == \'true\' }}' }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: windows-unsigned
          path: |
            staging/{{ language.params.npmPackage }}-win-x64.exe
            staging/{{ language.params.npmPackage }}-win-arm64.exe

      - name: Submit Windows binaries for signing
        if: {{ '${{ steps.signing.outputs.enabled == \'true\' }}' }}
        uses: signpath/github-action-submit-signing-request@b9d91eadd323de506c0c81cf0c7fe7438f3360fd # v2.2
        with:
          api-token: {{ '${{ secrets.WINDOWS_SIGNING_API_TOKEN }}' }}
          organization-id: {{ '${{ vars.WINDOWS_SIGNING_ORGANIZATION_ID }}' }}
          project-slug: {{ '${{ env.WINDOWS_SIGNING_PROJECT_SLUG }}' }}
          signing-policy-slug: {{ '${{ env.WINDOWS_SIGNING_POLICY_SLUG }}' }}
          artifact-configuration-slug: {{ '${{ env.WINDOWS_SIGNING_ARTIFACT_CONFIGURATION_SLUG }}' }}
          github-artifact-id: {{ '${{ steps.upload-windows-unsigned.outputs.artifact-id }}' }}
          wait-for-completion: true
          output-artifact-directory: signed
          parameters: |
            version: "{{ '${{ github.event.release.tag_name }}' }}"

      - name: Replace unsigned Windows binaries
        if: {{ '${{ steps.signing.outputs.enabled == \'true\' }}' }}
        run: |
          set -euo pipefail

          for arch in x64 arm64; do
            asset="{{ language.params.npmPackage }}-win-${arch}.exe"
            signed="$(find signed -type f -name "$asset" -print -quit)"

            if [ -z "$signed" ]; then
              echo "signed $asset not found"
              find signed -type f -print
              exit 1
            fi

            cp "$signed" "staging/$asset"
          done

      # Recomputed unconditionally. goreleaser checksummed the unsigned Windows
      # builds, and signing changes the bytes -- shipping the pre-signing
      # checksums would make every Windows verification fail. When signing is
      # skipped this recomputes the same values, which costs nothing and keeps
      # one code path.
      - name: Recompute checksums
        working-directory: staging
        run: sha256sum {{ language.params.npmPackage }}-* > checksums.txt

      # The job's own `contents: write` covers this, so no PAT is needed; the
      # tag goes through env rather than straight into the script, like every
      # other step that reads it.
      - name: Upload release assets
        env:
          GH_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}
          RELEASE_TAG: {{ '${{ github.event.release.tag_name }}' }}
        run: |
          set -euo pipefail
          gh release upload "$RELEASE_TAG" staging/* --clobber

      # Keyed off the release's own prerelease flag rather than a tag glob: a
      # `-beta` or `-preview` tag is just as much a prerelease as `-rc`, and a
      # glob that only knows about `-rc` would publish those as `latest`.
      - name: Determine npm tag
        id: npm_tag
        env:
          PRERELEASE: {{ '${{ github.event.release.prerelease }}' }}
        run: |
          set -euo pipefail
          if [ "$PRERELEASE" = "true" ]; then
            echo "tag=next" >> "$GITHUB_OUTPUT"
          else
            echo "tag=latest" >> "$GITHUB_OUTPUT"
          fi

      - name: Build npm packages
        env:
          RELEASE_TAG: {{ '${{ github.event.release.tag_name }}' }}
        run: |
          set -euo pipefail
          version="${RELEASE_TAG#v}"
          node scripts/build-npm-packages.mjs staging npm-packages "$version"
          # The parent's version and its optionalDependencies are generated at
          # SDK-generation time from a placeholder, so pin them to the tag here.
          node -e '
            const fs = require("node:fs");
            const version = process.argv[1];
            const manifest = JSON.parse(fs.readFileSync("npm/package.json", "utf8"));
            manifest.version = version;
            for (const name of Object.keys(manifest.optionalDependencies)) {
              manifest.optionalDependencies[name] = version;
            }
            fs.writeFileSync("npm/package.json", JSON.stringify(manifest, null, 2) + "\n");
          ' "$version"

      # Platform packages FIRST. The parent lists them as optionalDependencies
      # at an exact version, so publishing it first leaves a window where an
      # install resolves packages that do not exist yet.
      - name: Publish platform packages
        run: |
          set -euo pipefail
          for directory in npm-packages/*/; do
            npm publish "$directory" --provenance --access public --tag {{ '${{ steps.npm_tag.outputs.tag }}' }}
          done

      - name: Publish {{ language.params.npmPackage }}
        run: npm publish ./npm --provenance --access public --tag {{ '${{ steps.npm_tag.outputs.tag }}' }}

      - name: Generate token for the Homebrew tap
        if: {{ '${{ !github.event.release.prerelease }}' }}
        id: bot-token
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          app-id: {{ '${{ vars.APPWRITE_BOT_APP_ID }}' }}
          private-key: {{ '${{ secrets.APPWRITE_BOT_PRIVATE_KEY }}' }}
          owner: {{ language.params.homebrewTapOwner }}
          repositories: homebrew-{{ language.params.homebrewTapName }}

      - name: Check out the Homebrew tap
        if: {{ '${{ !github.event.release.prerelease }}' }}
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: {{ '${{ env.HOMEBREW_TAP_REPO }}' }}
          token: {{ '${{ steps.bot-token.outputs.token }}' }}
          path: homebrew-tap
          ref: {{ language.params.homebrewTapBranch }}

      # The formula already exists in the tap and is hand-maintained; this only
      # rewrites its version and the four checksums, the same way the
      # TypeScript CLI's release does. Deliberately not generated from a
      # template here -- the tap is the source of truth for its own formula.
      - name: Update the Homebrew formula
        if: {{ '${{ !github.event.release.prerelease }}' }}
        id: tap
        working-directory: homebrew-tap
        env:
          RELEASE_TAG: {{ '${{ github.event.release.tag_name }}' }}
        run: |
          set -euo pipefail

          FORMULA_PATH="$(find Formula -maxdepth 1 -name '*.rb' | head -n 1)"
          if [ -z "$FORMULA_PATH" ]; then
            echo "no formula found in the tap"
            exit 1
          fi

          export FORMULA_PATH
          export ASSET_PREFIX="{{ language.params.npmPackage }}"
          for target in darwin-arm64 darwin-x64 linux-arm64 linux-x64; do
            checksum="$(sha256sum "../staging/${ASSET_PREFIX}-${target}" | awk '{print $1}')"
            export "SHA256_${target//-/_}=$checksum"
          done

          ruby <<'RUBY'
          formula_path = ENV.fetch("FORMULA_PATH")
          prefix = ENV.fetch("ASSET_PREFIX")
          release_tag = ENV.fetch("RELEASE_TAG")
          checksums = {
            "#{prefix}-darwin-arm64" => ENV.fetch("SHA256_darwin_arm64"),
            "#{prefix}-darwin-x64" => ENV.fetch("SHA256_darwin_x64"),
            "#{prefix}-linux-arm64" => ENV.fetch("SHA256_linux_arm64"),
            "#{prefix}-linux-x64" => ENV.fetch("SHA256_linux_x64"),
          }

          text = File.read(formula_path)

          unless text.sub!(/^(\s*version ")([^"]+)(")$/) { "#{$1}#{release_tag}#{$3}" }
            abort("failed to update the formula version")
          end

          checksums.each do |artifact, checksum|
            pattern = /(#{Regexp.escape(artifact)}"\n\s+sha256 ")([0-9a-f]{64})(")/
            unless text.sub!(pattern) { "#{$1}#{checksum}#{$3}" }
              abort("failed to update the checksum for #{artifact}")
            end
          end

          File.write(formula_path, text)
          RUBY

          ruby -c "$FORMULA_PATH"
          echo "formula_path=${FORMULA_PATH}" >> "$GITHUB_OUTPUT"

      - name: Commit the Homebrew formula
        if: {{ '${{ !github.event.release.prerelease }}' }}
        working-directory: homebrew-tap
        env:
          RELEASE_TAG: {{ '${{ github.event.release.tag_name }}' }}
          FORMULA_PATH: {{ '${{ steps.tap.outputs.formula_path }}' }}
        run: |
          set -euo pipefail

          if git diff --quiet -- "$FORMULA_PATH"; then
            echo "formula already up to date for ${RELEASE_TAG}"
            exit 0
          fi

          git config user.name "appwrite-bot[bot]"
          git config user.email "217594562+appwrite-bot[bot]@users.noreply.github.com"
          git add "$FORMULA_PATH"
          git commit -m "{{ language.params.executableName }} ${RELEASE_TAG}"
          git pull --rebase origin "{{ language.params.homebrewTapBranch }}"
          git push origin "HEAD:{{ language.params.homebrewTapBranch }}"
