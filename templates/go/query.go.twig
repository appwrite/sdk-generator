func normalize(queries interface{}) []string {
	if queries == nil {
		return []string{}
	}

	switch v := queries.(type) {
	case *QueryBuilder:
		if v == nil {
			return []string{}
		}
		return v.Build()
	case QueryBuilder:
		return v.Build()
	case string:
		return []string{v}
	}

	value := reflect.ValueOf(queries)
	switch value.Kind() {
	case reflect.Slice, reflect.Array:
		out := make([]string, 0, value.Len())
		for i := 0; i < value.Len(); i++ {
			out = append(out, normalize(value.Index(i).Interface())...)
		}
		return out
	default:
		return []string{}
	}
}
