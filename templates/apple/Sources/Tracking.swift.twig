import Foundation

#if os(iOS) || os(tvOS) || os(visionOS)
    import UIKit
#elseif os(macOS)
    import AppKit
#endif

/// Auto-tracking helpers for the generated `Analytics` service: install, update and app-lifecycle
/// events, push events, and manual `screenView` / `event` calls, all sent through
/// `Analytics.createEvent`.
///
/// Auto-emitted event names are `snake_case` (`screen_view`, `app_backgrounded`,
/// `app_foregrounded`, `first_open`, `app_updated`, `push_received`, `push_opened`). Prop keys use
/// camelCase to match the endpoint's parameter naming.
///
/// Engagement time is reported as a **delta** attached to each `app_backgrounded` event, covering
/// only the foreground time accrued since the last foregrounding, the same way the Web and Flutter
/// helpers report it.
///
/// `first_open` is sent once per install and `app_updated` on the first start after the app's
/// version changes. The marker lives in `UserDefaults`, so deleting the app counts as a new
/// install. Call `start()` at launch, before signing in: an install that already holds a session
/// cookie is taken to be one that ran an older SDK, and sends no `first_open`. A send that fails is
/// kept and retried on the next start; a crash between a successful send and clearing it sends it
/// once more.
///
///     let tracking = Tracking(Analytics(client), propertyId: "<PROPERTY_ID>")
///     tracking.start()
///     tracking.screenView("Home")
open class Tracking: @unchecked Sendable {
    static let versionKey = "{{ spec.info.title | caseLower }}.tracking.version"
    static let pendingKey = "{{ spec.info.title | caseLower }}.tracking.pending"

    // The install check runs once per process, however many trackers start.
    private static let installLock = NSLock()
    nonisolated(unsafe) static var install: Task<Void, Never>?

    private let analytics: Analytics

    /// Analytics property every event is recorded against.
    public let propertyId: String

    /// Base URL events are reported under; screen names resolve against it. Defaults to
    /// `app://<platform>`, since the endpoint only accepts absolute URLs.
    public let url: String

    private let lock = NSLock()
    private var observers: [NSObjectProtocol] = []
    // `systemUptime`, which a wall-clock change does not move.
    private var foregroundSince: TimeInterval?

    // Sub-second engagement left over from the previous flush, so many short foreground stretches
    // do not each lose a fraction of a second to truncation.
    private var engagementCarry: TimeInterval = 0

    public init(_ analytics: Analytics, propertyId: String, url: String? = nil) {
        self.analytics = analytics
        self.propertyId = propertyId
        #if os(iOS)
            self.url = url ?? "app://ios"
        #elseif os(macOS)
            self.url = url ?? "app://macos"
        #elseif os(tvOS)
            self.url = url ?? "app://tvos"
        #elseif os(watchOS)
            self.url = url ?? "app://watchos"
        #elseif os(visionOS)
            self.url = url ?? "app://visionos"
        #else
            self.url = url ?? "app://linux"
        #endif
    }

    deinit {
        observers.forEach(NotificationCenter.default.removeObserver)
    }

    /// Start the default auto-tracking set: `first_open` / `app_updated`, then app-lifecycle
    /// events, as `enableAutoLifecycleEvents()`.
    public func start() {
        Self.installLock.lock()
        if Self.install == nil {
            // Before anything else: the app's first request can save cookies meanwhile.
            let ranBefore = hasSessionCookies()
            Self.install = Task { await trackInstall(ranBefore: ranBefore) }
        }
        Self.installLock.unlock()
        enableAutoLifecycleEvents()
    }

    func trackInstall(ranBefore: Bool) async {
        let defaults = UserDefaults.standard
        let version = OSPackageInfo.get().version
        if let pending = defaults.data(forKey: Self.pendingKey) {
            // A crash between the two writes leaves the marker stale; this start decides nothing more.
            defaults.set(version, forKey: Self.versionKey)
            await sendPending(pending)
            return
        }
        let previous = defaults.string(forKey: Self.versionKey)
        guard previous != version else {
            return
        }
        var pending: [String: Any]?
        if let previous {
            pending = ["name": "app_updated", "props": ["previousVersion": previous, "version": version]]
        } else if !ranBefore {
            pending = ["name": "first_open"]
        }
        // Pending first, then the marker, both before sending: a failed send stays pending, and a crash
        // between the writes leaves the event pending rather than lost.
        if let pending, let data = try? JSONSerialization.data(withJSONObject: pending) {
            defaults.set(data, forKey: Self.pendingKey)
            defaults.set(version, forKey: Self.versionKey)
            await sendPending(data)
        } else {
            defaults.set(version, forKey: Self.versionKey)
        }
    }

    private func sendPending(_ data: Data) async {
        let pending = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any]
        guard let name = pending?["name"] as? String else {
            UserDefaults.standard.removeObject(forKey: Self.pendingKey)
            return
        }
        if await send(name, props: pending?["props"] as? [String: Any], interactive: false) {
            UserDefaults.standard.removeObject(forKey: Self.pendingKey)
        }
    }

    /// Start emitting `app_backgrounded` and `app_foregrounded` events when the app changes
    /// lifecycle state. Idempotent. Lifecycle events are sent on iOS, tvOS, visionOS and macOS.
    public func enableAutoLifecycleEvents() {
        #if os(iOS) || os(tvOS) || os(visionOS) || os(macOS)
            lock.lock()
            defer { lock.unlock() }
            guard observers.isEmpty else {
                return
            }
            engagementCarry = 0
            let center = NotificationCenter.default
            #if os(macOS)
                foregroundSince = ProcessInfo.processInfo.systemUptime
                observers = [
                    center.addObserver(forName: NSApplication.didChangeOcclusionStateNotification, object: nil, queue: .main) { [weak self] _ in
                        let visible = MainActor.assumeIsolated { NSApplication.shared.occlusionState.contains(.visible) }
                        if visible {
                            self?.foregrounded()
                        } else {
                            self?.backgrounded()
                        }
                    }
                ]
            #else
                observers = [
                    center.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: .main) { [weak self] _ in self?.backgrounded() },
                    center.addObserver(forName: UIApplication.willEnterForegroundNotification, object: nil, queue: .main) { [weak self] _ in self?.foregrounded() },
                ]
                // A process launched in the background (a push, a fetch) accrues no engagement; its
                // first real foreground sends `app_foregrounded`.
                Task { @MainActor [weak self] in
                    guard let self, UIApplication.shared.applicationState != .background else {
                        return
                    }
                    self.lock.lock()
                    if !self.observers.isEmpty && self.foregroundSince == nil {
                        self.foregroundSince = ProcessInfo.processInfo.systemUptime
                    }
                    self.lock.unlock()
                }
            #endif
        #endif
    }

    /// Stop emitting lifecycle events. Safe to call when auto-lifecycle was never enabled.
    public func disableAutoLifecycleEvents() {
        lock.lock()
        let removed = observers
        observers = []
        foregroundSince = nil
        engagementCarry = 0
        lock.unlock()
        removed.forEach(NotificationCenter.default.removeObserver)
    }

    /// Emit an ad-hoc analytics event. `url` may be absolute or a path resolved against
    /// `Tracking.url`. Request failures are swallowed so analytics never surface errors to the app.
    open func event(_ name: String, url: String? = nil, props: [String: Any]? = nil, engagementTime: Int? = nil, interactive: Bool? = nil) {
        Task {
            await send(name, url: url, props: props, engagementTime: engagementTime, interactive: interactive)
        }
    }

    /// Send an event and report whether the endpoint accepted it.
    @discardableResult
    func send(_ name: String, url: String? = nil, props: [String: Any]? = nil, engagementTime: Int? = nil, interactive: Bool? = nil) async -> Bool {
        guard let resolved = url.map({ URL(string: $0, relativeTo: URL(string: self.url))?.absoluteString }) ?? self.url else {
            return false
        }
        do {
            _ = try await analytics.createEvent(
                propertyId: propertyId,
                name: name,
                url: resolved,
                screenWidth: await Self.viewportWidth(),
                engagementTime: engagementTime,
                props: props.map(Self.flatten),
                interactive: interactive
            )
            return true
        } catch {
            return false
        }
    }

    // The endpoint takes props as a flat alternating key/value list. An Optional held in `Any` is
    // unwrapped, and a nil one dropped, so no "nil" or "Optional(...)" is sent.
    static func flatten(_ props: [String: Any]) -> [String] {
        props.flatMap { key, value -> [String] in
            let mirror = Mirror(reflecting: value)
            guard mirror.displayStyle == .optional else {
                return [key, "\(value)"]
            }
            return mirror.children.first.map { [key, "\($0.value)"] } ?? []
        }
    }

    /// Mobile-idiomatic screen-view shortcut. Renders as a `screen_view` analytics event with
    /// `screen`, optional `screenClass` and any caller-supplied properties. `name` is also the
    /// event URL's path.
    public func screenView(_ name: String, className: String? = nil, props: [String: Any]? = nil) {
        var merged: [String: Any] = ["screen": name]
        if let className {
            merged["screenClass"] = className
        }
        merged.merge(props ?? [:]) { $1 }
        // A name with spaces or other characters a URL cannot hold would not resolve.
        event("screen_view", url: name.addingPercentEncoding(withAllowedCharacters: .urlPathAllowed) ?? name, props: merged)
    }

    /// Report that a push notification arrived. Best effort: the app's code often does not run
    /// when one arrives. `Push` sends this itself for the notifications it handles.
    public func pushReceived(messageId: String? = nil, campaign: String? = nil) {
        event("push_received", props: pushProps(messageId: messageId, campaign: campaign), interactive: false)
    }

    /// Report that the user opened a push notification. `Push` sends this itself for the
    /// notifications it handles.
    public func pushOpened(messageId: String? = nil, campaign: String? = nil) {
        event("push_opened", props: pushProps(messageId: messageId, campaign: campaign), interactive: true)
    }

    private func pushProps(messageId: String?, campaign: String?) -> [String: Any]? {
        var props: [String: Any] = [:]
        props["messageId"] = messageId?.isEmpty == false ? messageId : nil
        props["campaign"] = campaign
        return props.isEmpty ? nil : props
    }

    // The SDK keeps the session cookies it was given under the endpoint's host.
    private func hasSessionCookies() -> Bool {
        guard let host = URL(string: analytics.client.endPoint)?.host else {
            return false
        }
        return UserDefaults.standard.stringArray(forKey: host)?.isEmpty == false
    }

    private func backgrounded() {
        lock.lock()
        guard let since = foregroundSince else {
            lock.unlock()
            return
        }
        foregroundSince = nil
        let elapsed = engagementCarry + ProcessInfo.processInfo.systemUptime - since
        let seconds = Int(elapsed)
        engagementCarry = elapsed - TimeInterval(seconds)
        lock.unlock()
        event("app_backgrounded", engagementTime: seconds > 0 ? seconds : nil, interactive: false)
    }

    private func foregrounded() {
        lock.lock()
        guard foregroundSince == nil else {
            lock.unlock()
            return
        }
        foregroundSince = ProcessInfo.processInfo.systemUptime
        lock.unlock()
        event("app_foregrounded", interactive: false)
    }

    // Kept for events sent once the key window is gone, such as `app_backgrounded`.
    @MainActor private static var lastWidth: Int?

    // Viewport width in points, matching the Web helper's `innerWidth`.
    @MainActor
    private static func viewportWidth() -> Int? {
        #if os(iOS) || os(tvOS) || os(visionOS)
            let width = UIApplication.shared.connectedScenes.compactMap { ($0 as? UIWindowScene)?.keyWindow }.first?.bounds.width
        #elseif os(macOS)
            let width = NSApplication.shared.keyWindow?.frame.width
        #else
            let width: Double? = nil
        #endif
        if let width, width > 0 {
            lastWidth = Int(width.rounded())
        }
        return lastWidth
    }
}
