#frozen_string_literal: true

module {{spec.info.title | caseUcfirst}}
    class {{ service.name | caseUcfirst }} < Service

        def initialize(client)
            @client = client
        end

{% for method in (service | operations) %}
{% set methodNameSnake = (method | methodName) | caseSnake %}
{# Check if this method should be skipped (is deprecated and has a non-deprecated duplicate) #}
{% set shouldSkip = false %}
{% if method.deprecated %}
{% for otherMethod in (service | operations) %}
{% if not otherMethod.deprecated and ((otherMethod | methodName) | caseSnake) == methodNameSnake %}
{% set shouldSkip = true %}
{% endif %}
{% endfor %}
{% endif %}
{% if not shouldSkip %}
{% if method.deprecated %}
        #
{%~ if (method | appwrite('deprecated', {})['since'] ?? '') and (method | appwrite('deprecated', {})['replaceWith'] ?? '') %}
        # @deprecated This API has been deprecated since {{ (method | appwrite('deprecated', {})['since'] ?? '') }}. Please use `{{ (method | appwrite('deprecated', {})['replaceWith'] ?? '') | capitalizeFirst }}` instead.
{%~ else %}
        # @deprecated This API has been deprecated.
{%~ endif %}
        #
{% endif %}
{{ method.description | wrap(75, '        # ') }}
        #
{% for parameter in (method | parameters('all')) %}
        # @param [{{ parameter | typeName }}] {{ parameter.name | caseSnake | escapeKeyword }} {{ parameter.description | raw }}
{% endfor %}
        #
        # @return [{% set responseModels = method | getValidResponseModels %}{% if responseModels|length > 0 %}{% for responseModel in responseModels %}{{ responseModel | caseUcfirst }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}]
        def {{ (method | methodName) | caseSnake }}({% for parameter in (method | parameters('all')) %}{{ parameter.name | caseSnake | escapeKeyword }}:{% if not parameter.required %} nil{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{% if 'multipart/form-data' in (method | consumes) %}, on_progress: nil{% endif %})
{{ include('ruby/base/params.twig')}}
{% if 'multipart/form-data' in (method | consumes) %}
{{ include('ruby/base/requests/file.twig')}}
{% else %}
{{ include('ruby/base/requests/api.twig')}}
{% endif %}
        end

{% endif %}
{% endfor %}
    end 
end
